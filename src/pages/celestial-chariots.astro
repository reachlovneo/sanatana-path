el{position:sticky;top:6rem;display:grid;gap:.85rem;align-self:start;border-color:light-dark(rgb(118 93 55 / 0.16), rgb(255 191 115/.16));padding:.85rem;background:linear-gradient(145deg,light-dark(rgb(247 240 226 / 0.78), rgb(3 13 20/.78)),light-dark(rgb(247 240 226 / 0.38), rgb(3 13 20/.38)))}.insight-card,.source-drawer,.next-card{border:1px solid light-dark(rgb(118 93 55 / 0.16), rgb(255 191 115/.16));border-radius:.9rem;background:rgb(255 191 115/.04)}.insight-card{padding:1rem}.insight-card p:last-child{margin:.7rem 0 0}.source-drawer{overflow:hidden}.source-drawer summary{display:flex;align-items:center;justify-content:space-between;gap:.75rem;padding:.82rem .95rem;color:light-dark(rgb(110 89 62 / 1), #ffcf91);cursor:pointer;list-style:none}.source-drawer summary::-webkit-details-marker{display:none}.source-drawer summary span{font-size:.72rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.source-drawer summary strong{display:grid;min-width:2rem;height:2rem;place-items:center;border-radius:999px;background:rgb(255 191 115/.12);font-size:.78rem}.source-drawer ul{padding:0 .8rem .8rem}.source-drawer li{font-size:.9rem;line-height:1.45}.next-card{display:grid!important;gap:.25rem;margin-top:0!important;padding:1rem!important;color:light-dark(rgb(43 33 24 / 1), #fff4df)!important;text-decoration:none!important}.next-card span{color:light-dark(rgb(110 82 49 / 1), #ffbf73);font-size:.68rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.next-card strong{font-family:var(--serif);font-size:1.55rem;line-height:1}.next-card small{color:light-dark(rgb(110 89 62 / 1), #ffcf91);font-size:.72rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}@media(max-width:920px){.hero-card{width:auto;margin-top:clamp(10rem,28svh,15rem)}.topic-layout{grid-template-columns:1fr}.reading-panel{columns:1}.side-panel{position:static;grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:760px){.side-panel{grid-template-columns:1fr}}@media(max-width:640px){.topic-hero,.topic-layout{width:min(100% - 1rem,1460px)}.hero-card{margin:clamp(8rem,24svh,12rem) .75rem .75rem}}
</style>
  :global(body:has(.devotee-draft)) {
    background: light-dark(rgb(247 240 226 / 1), #050907);
    color: light-dark(rgb(91 76 57 / 1), #f3e4c9);
  }

  :global(body:has(.devotee-draft)::before) {
    display: none;
  }

  .devotee-draft {
    min-height: 100svh;
    padding: clamp(1rem, 3vw, 2rem) 0 5rem;
    background:
      linear-gradient(rgb(224 177 92 / .035) 1px, transparent 1px) 0 0 / 58px 58px,
      linear-gradient(90deg, rgb(88 197 168 / .025) 1px, transparent 1px) 0 0 / 58px 58px,
      radial-gradient(circle at 18% 0%, rgb(224 177 92 / .1), transparent 34rem),
      light-dark(rgb(247 240 226 / 1), #050907);
  }

  .draft-article {
    width: min(820px, calc(100% - 2rem));
    margin-inline: auto;
  }

  .back-link {
    display: inline-flex;
    min-height: 2.35rem;
    align-items: center;
    border: 1px solid light-dark(rgb(118 93 55 / 0.32), rgb(224 177 92 / .32));
    border-radius: .35rem;
    padding: .55rem .82rem;
    color: light-dark(rgb(110 99 73 / 1), #ffe7aa);
    background: light-dark(rgb(247 240 226 / 0.54), rgb(3 8 7 / .54));
    font-size: .68rem;
    font-weight: 850;
    letter-spacing: .08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .eyebrow {
    margin: 2rem 0 .55rem;
    color: light-dark(rgb(96 76 40 / 1), #e0b15c);
    font-size: .72rem;
    font-weight: 950;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    color: light-dark(rgb(43 33 24 / 1), #fff1d4);
    font-family: var(--serif);
    font-weight: 500;
    letter-spacing: 0;
  }

  h1 {
    max-width: 11ch;
    font-size: clamp(3.2rem, 9vw, 6.8rem);
    line-height: .92;
  }

  h2 {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    font-size: clamp(2rem, 5vw, 3.45rem);
    line-height: 1.02;
  }

  p {
    margin: 1.1rem 0 0;
    color: light-dark(rgb(91 76 57 / 1), #d9cbb5);
    font-size: clamp(1.06rem, 1.6vw, 1.22rem);
    line-height: 1.88;
  }

  .lead {
    margin-top: 1.3rem;
    color: light-dark(rgb(110 99 73 / 1), #ffe7aa);
    font-family: var(--serif);
    font-size: clamp(1.35rem, 2.6vw, 2rem);
    line-height: 1.42;
  }


---
import AtlasExplorer from "../../components/atlas/AtlasExplorer.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Cosmic Atlas | Sanatana Path" description="Explore cosmic time as a living, connected atlas from Kalpa to Kali Yuga." image="/images/atlas/cosmic-architecture.jpg">
  <AtlasExplorer />
</BaseLayout>
<style is:global>
  @media (min-width: 801px) {
    body:has(.atlas-explorer) { background: #020a10; }
    body:has(.atlas-explorer)::before { display: none; }
    body:has(.atlas-explorer) footer { display: none; }
  }
</style>

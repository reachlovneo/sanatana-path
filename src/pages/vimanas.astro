---
import BaseLayout from "../layouts/BaseLayout.astro";

const activeTopics = [
  {
    eyebrow: "Topic 1",
    title: "Pushpaka Vimana",
    episode: "Episode 2 - The Aircraft That Chose Its Master",
    text: "The golden aerial palace connected with Kubera, Ravana, and Rama in the Ramayana. A vehicle of divine craftsmanship, kingship, and dharma.",
    href: "/pushpaka-vimana",
    image: "/images/home/home-vimana.webp",
  },
  {
    eyebrow: "Topic 2",
    title: "Tripura - The Three Flying Cities",
    episode: "Episode 3 - The Cities That Could Never Be Destroyed",
    text: "Three aerial fortresses built of gold, silver, and iron, destroyed only when Shiva released a single arrow at the moment of perfect alignment.",
    href: "/flying-cities-of-tripura",
    image: "/images/home/home-tripura.webp",
  },
  {
    eyebrow: "Topic 3",
    title: "Saubha - The Invisible Flying Fortress",
    episode: "Episode 4 - The City That Disappeared Into the Sky",
    text: "King Shalva's aerial fortress appeared, vanished, and confused warriors until Krishna destroyed it with the Sudarshana Chakra.",
    href: "/saubha",
    image: "/images/home/home-vimana.webp",
  },
  {
    eyebrow: "Topic 4",
    title: "Celestial Chariots",
    episode: "Episode 5 - The Vehicles of the Gods",
    text: "Indra, Surya, Arjuna, and Shiva reveal how divine chariots carry authority, dharma, and cosmic symbolism.",
    href: "/celestial-chariots",
    image: "/images/home/home-hero.webp",
  },
  {
    eyebrow: "Topic 5",
    title: "Divine Transportation",
    episode: "Episode 6 - The Paths Between Worlds",
    text: "Narada, Garuda, yogic travel, and celestial movement point toward the deepest journey: the rise of consciousness.",
    href: "/divine-transportation",
    image: "/images/home/home-lokas.webp",
  },
];
---
<BaseLayout title="Vimanas & Flying Cities | Sanatana Path" description="A source-aware gateway to Vimanas, Pushpaka Vimana, Tripura, Saubha, celestial chariots, and flying cities in the Itihasas and Puranas." image="/images/home/home-vimana.webp" type="article">
  <div data-reading-body class="vimana-page">
    <section class="vimana-hero">
      <img src="/images/home/home-vimana.webp" alt="Golden flying palace in a night sky" loading="eager" decoding="async" />
      <div class="hero-glass">
        <a class="back-link" href="/library">Library</a>
        <p class="eyebrow">Vimanas & Flying Cities</p>
        <h1>When the Sky Was Not Empty</h1>
        <p class="quote">"Before humans dreamed of flying... the skies of the Itihasas and Puranas were already alive."</p>
      </div>
    </section>

    <section class="intro-grid" aria-labelledby="intro-title">
      <div class="intro-copy">
        <p class="eyebrow">Episode 1</p>
        <h2 id="intro-title">The heavens were never imagined as empty.</h2>
        <div class="reading-body">
          <p>The night sky has always inspired one question.</p>
          <p>What if the heavens were never empty?</p>
          <p>Today, we imagine aircraft, satellites, and space stations. But thousands of years ago, the Sanskrit epics described something astonishing.</p>
          <p>Cities floating above the clouds. Flying palaces carrying kings across continents. Celestial chariots that moved by thought. Entire kingdoms suspended in the sky.</p>
          <p>These were called Vimanas.</p>
          <p>But not every flying object in Hindu scriptures is a Vimana. Some are divine vehicles. Some are aerial cities. Some belong to gods. Others belong to asuras. Some are gifts. Some are weapons.</p>
          <p>Each has its own story, and every one appears in a different scripture.</p>
        </div>
      </div>
      <aside class="clarity-card">
        <p class="eyebrow">How this series reads</p>
        <h2>No speculation. No mixed myths.</h2>
        <p>Each chapter follows the traditional stories as they appear in the Itihasas, Puranas, commentaries, and authentic translations.</p>
        <ul>
          <li>The legendary Pushpaka Vimana</li>
          <li>The Flying Cities of Tripura</li>
          <li>The aerial kingdom of Saubha</li>
          <li>Divine chariots of the Devas</li>
          <li>Celestial transportation in Sanatana Dharma</li>
        </ul>
      </aside>
    </section>

    <section class="topic-section" aria-labelledby="topic-title">
      <div class="section-heading">
        <p class="eyebrow">Ready to read</p>
        <h2 id="topic-title">Read the complete opened series.</h2>
      </div>
      <div class="topic-grid">
        {activeTopics.map((topic) => (
          <a class="topic-card" href={topic.href}>
            <img src={topic.image} alt="" loading="lazy" decoding="async" />
            <div>
              <p>{topic.eyebrow}</p>
              <h3>{topic.title}</h3>
              <strong>{topic.episode}</strong>
              <small>{topic.text}</small>
              <b>Read chapter <span aria-hidden="true">-&gt;</span></b>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="upcoming-panel" aria-labelledby="upcoming-title">
      <div>
        <p class="eyebrow">Series finale</p>
        <h2 id="upcoming-title">From the sky, the journey descends below.</h2>
        <p>The next expedition moves from celestial vehicles to the hidden realms beneath the earth: Patala Loka and the seven underworlds.</p>
      </div>
      <div class="upcoming-list">
        <span><b>Next</b>Patala Loka</span>
        <span><b>Seven</b>Underworlds</span>
        <span><b>Coming</b>Nagas and hidden realms</span>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  :global(body:has(.vimana-page)) { background: light-dark(rgb(247 240 226 / 1), #020b10); color: light-dark(rgb(43 33 24 / 1), #fff4df); }
  :global(body:has(.vimana-page)::before) { display: none; }
  .vimana-page { min-height: 100svh; padding-bottom: 4rem; background: radial-gradient(circle at 78% 0%, rgb(255 191 115 / .13), transparent 30rem), linear-gradient(180deg, light-dark(rgb(247 240 226 / 1), #020b10), light-dark(rgb(247 240 226 / 1), #031517) 54%, light-dark(rgb(247 240 226 / 1), #020b10)); }
  .vimana-hero { position: relative; width: min(1460px, calc(100% - 2rem)); min-height: clamp(30rem, 58svh, 41rem); margin: 1.25rem auto 0; overflow: hidden; border: 1px solid light-dark(rgb(118 93 55 / 0.28), rgb(255 191 115 / .28)); border-radius: 1.1rem; background: light-dark(rgb(247 240 226 / 1), #061117); box-shadow: inset 0 1px rgb(255 255 255 / .035), 0 28px 90px light-dark(rgb(91 69 38 / 0.112), rgb(0 0 0 / .32)); }
  .vimana-hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: saturate(1.08) contrast(1.06) brightness(.72); }
  .vimana-hero::after { position: absolute; inset: 0; background: linear-gradient(90deg, light-dark(rgb(247 240 226 / 0.96), rgb(2 11 16 / .96)), light-dark(rgb(247 240 226 / 0.58), rgb(2 11 16 / .58)) 46%, light-dark(rgb(247 240 226 / 0.12), rgb(2 11 16 / .12))), linear-gradient(180deg, transparent 58%, light-dark(rgb(247 240 226 / 0.62), rgb(2 11 16 / .62))); content: ""; }
  .hero-glass { position: relative; z-index: 1; width: min(47rem, 52%); margin: clamp(1.25rem, 3vw, 2.5rem); border: 1px solid light-dark(rgb(118 93 55 / 0.34), rgb(255 191 115 / .34)); border-radius: 1rem; padding: clamp(1.2rem, 2.6vw, 2rem); background: linear-gradient(145deg, light-dark(rgb(247 240 226 / 0.66), rgb(3 13 20 / .66)), light-dark(rgb(247 240 226 / 0.28), rgb(3 13 20 / .28))); box-shadow: inset 0 1px rgb(255 255 255 / .08), 0 24px 70px light-dark(rgb(91 69 38 / 0.077), rgb(0 0 0 / .22)); backdrop-filter: blur(20px) saturate(126%); }
  .back-link { display: inline-flex; width: fit-content; margin-bottom: clamp(1rem, 2vw, 1.4rem); border: 1px solid light-dark(rgb(118 93 55 / 0.34), rgb(255 191 115 / .34)); border-radius: 999px; padding: .5rem .72rem; background: light-dark(rgb(247 240 226 / 0.38), rgb(3 13 20 / .38)); color: light-dark(rgb(110 89 62 / 1), #ffcf91); font-size: .72rem; font-weight: 850; text-decoration: none; }
  .eyebrow { margin: 0; color: light-dark(rgb(110 82 49 / 1), #ffbf73); font-size: .68rem; font-weight: 900; letter-spacing: .16em; text-transform: uppercase; }
  h1, h2, h3 { margin: 0; color: light-dark(rgb(43 33 24 / 1), #fff4df); font-family: var(--serif); font-weight: 500; letter-spacing: 0; line-height: .98; }
  .hero-glass h1 { margin-top: .6rem; font-size: clamp(3.2rem, 5.6vw, 6.4rem); }
  .quote { max-width: 40rem; margin: 1rem 0 0; color: light-dark(rgb(110 96 77 / 1), #ffe0b4); font-size: clamp(1.05rem, 1.5vw, 1.32rem); line-height: 1.65; }
  .intro-grid, .topic-section, .upcoming-panel { width: min(1460px, calc(100% - 2rem)); margin: clamp(1rem, 2.4vw, 1.7rem) auto 0; }
  .intro-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(20rem, 28rem); gap: 1rem; align-items: stretch; }
  .intro-copy, .clarity-card, .upcoming-panel { border: 1px solid light-dark(rgb(118 93 55 / 0.2), rgb(255 191 115 / .2)); border-radius: 1rem; background: linear-gradient(145deg, light-dark(rgb(247 240 226 / 0.82), rgb(3 13 20 / .82)), light-dark(rgb(247 240 226 / 0.58), rgb(3 13 20 / .58))); box-shadow: inset 0 1px rgb(255 255 255 / .045), 0 20px 60px light-dark(rgb(91 69 38 / 0.063), rgb(0 0 0 / .18)); }
  .intro-copy, .clarity-card { padding: clamp(1.1rem, 2.5vw, 1.75rem); }
  .intro-copy h2, .clarity-card h2, .section-heading h2, .upcoming-panel h2 { margin-top: .55rem; font-size: clamp(2rem, 3.6vw, 4rem); }
  .reading-body { margin-top: 1rem; columns: 2 22rem; column-gap: clamp(1.4rem, 3vw, 2.6rem); }
  .reading-body p, .clarity-card p, .upcoming-panel p { margin: 0 0 .8rem; color: light-dark(rgb(91 76 57 / 1), #dfd1ba); font-size: clamp(1rem, 1.18vw, 1.08rem); line-height: 1.72; }
  .clarity-card ul { display: grid; gap: .55rem; margin: 1rem 0 0; padding: 0; list-style: none; }
  .clarity-card li { border: 1px solid light-dark(rgb(118 93 55 / 0.16), rgb(255 191 115 / .16)); border-radius: .75rem; padding: .65rem .75rem; color: light-dark(rgb(91 76 57 / 1), #f2dfc2); background: rgb(255 191 115 / .045); }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: .9rem; }
  .topic-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .75rem; }
  .topic-card { position: relative; display: grid; min-height: 18rem; overflow: hidden; align-content: end; border: 1px solid light-dark(rgb(118 93 55 / 0.2), rgb(255 191 115 / .2)); border-radius: .92rem; background: light-dark(rgb(247 240 226 / 1), #061117); color: inherit; text-decoration: none; box-shadow: 0 16px 42px light-dark(rgb(91 69 38 / 0.063), rgb(0 0 0 / .18)), inset 0 1px rgb(255 255 255 / .035); transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease; }
  .topic-card img { position: absolute; inset: 0; width: 100%; height: 48%; object-fit: cover; filter: saturate(1.06) contrast(1.05) brightness(.74); transition: transform 520ms ease, filter 180ms ease; }
  .topic-card::after { position: absolute; inset: 0; background: linear-gradient(180deg, light-dark(rgb(247 240 226 / 0.06), rgb(2 11 16 / .06)) 0 26%, light-dark(rgb(247 240 226 / 0.68), rgb(2 11 16 / .68)) 49%, light-dark(rgb(247 240 226 / 0.96), rgb(2 11 16 / .96)) 100%); content: ""; }
  .topic-card:hover { transform: translateY(-4px); border-color: light-dark(rgb(118 93 55 / 0.42), rgb(255 191 115 / .42)); box-shadow: 0 22px 60px light-dark(rgb(91 69 38 / 0.098), rgb(0 0 0 / .28)), 0 0 34px rgb(255 191 115 / .08); }
  .topic-card:hover img { transform: scale(1.06); filter: saturate(1.12) contrast(1.08) brightness(.84); }
  .topic-card > div { position: relative; z-index: 1; display: grid; min-height: 10.6rem; align-content: start; margin: 6.5rem .62rem .62rem; border: 1px solid light-dark(rgb(118 93 55 / 0.17), rgb(255 191 115 / .17)); border-radius: .78rem; padding: .78rem; background: linear-gradient(145deg, light-dark(rgb(247 240 226 / 0.86), rgb(3 13 20 / .86)), light-dark(rgb(247 240 226 / 0.62), rgb(3 13 20 / .62))); box-shadow: inset 0 1px rgb(255 255 255 / .045); backdrop-filter: blur(14px); }
  .topic-card p { margin: 0 0 .42rem; color: light-dark(rgb(110 82 49 / 1), #ffbf73); font-size: .56rem; font-weight: 900; letter-spacing: .13em; text-transform: uppercase; }
  .topic-card h3 { font-size: clamp(1.26rem, 1.55vw, 1.72rem); line-height: 1.02; }
  .topic-card strong { display: block; margin-top: .46rem; color: light-dark(rgb(110 90 67 / 1), #ffd19b); font-size: .68rem; line-height: 1.35; }
  .topic-card small { display: block; margin-top: .48rem; color: light-dark(rgb(91 76 57 / 1), #cfc2ae); font-size: .72rem; line-height: 1.45; }
  .topic-card b { display: inline-flex; width: fit-content; margin-top: .65rem; border: 1px solid light-dark(rgb(118 93 55 / 0.22), rgb(255 191 115 / .22)); border-radius: 999px; padding: .34rem .5rem; color: light-dark(rgb(110 89 62 / 1), #ffcf91); font-size: .58rem; letter-spacing: .08em; text-transform: uppercase; }
  .upcoming-panel { display: grid; grid-template-columns: minmax(0, .8fr) minmax(18rem, 1fr); gap: 1rem; align-items: center; padding: clamp(1.1rem, 2.5vw, 1.6rem); }
  .upcoming-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .6rem; }
  .upcoming-list span { display: grid; min-height: 7rem; align-content: end; border: 1px dashed light-dark(rgb(118 93 55 / 0.22), rgb(255 191 115 / .22)); border-radius: .85rem; padding: .8rem; color: light-dark(rgb(91 76 57 / 1), #dfd1ba); background: rgb(255 191 115 / .04); }
  .upcoming-list b { margin-bottom: .5rem; color: light-dark(rgb(110 82 49 / 1), #ffbf73); font-size: .62rem; letter-spacing: .12em; }
  @media (max-width: 1180px) { .topic-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 920px) { .hero-glass { width: auto; margin-top: clamp(11rem, 28svh, 16rem); } .intro-grid, .upcoming-panel { grid-template-columns: 1fr; } .topic-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .reading-body { columns: 1; } .upcoming-list { grid-template-columns: 1fr; } }
  @media (max-width: 640px) { .vimana-hero, .intro-grid, .topic-section, .upcoming-panel { width: min(100% - 1rem, 1460px); } .hero-glass { margin: clamp(9rem, 24svh, 13rem) .75rem .75rem; } .topic-grid { grid-template-columns: 1fr; } .topic-card { min-height: 16.5rem; } .topic-card > div { min-height: auto; } }
</style>
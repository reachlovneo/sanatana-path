---
import BaseLayout from "../layouts/BaseLayout.astro";

const featuredTopics = [
  {
    eyebrow: "Cosmic map",
    title: "Cosmic Time",
    text: "Kalpa, Manvantara, Maha Yuga, Four Yugas, and Kali Yuga placed as one clear hierarchy.",
    href: "/atlas/cosmic-time",
    tone: "gold",
    image: "/images/home/home-hero.webp",
  },
  {
    eyebrow: "Realms",
    title: "14 Lokas",
    text: "The layered worlds of Hindu cosmology, from earthly experience to subtle celestial realms.",
    href: "/14-lokas",
    tone: "teal",
    image: "/images/home/home-lokas.webp",
  },
  {
    eyebrow: "Ramayana wonder",
    title: "Pushpaka Vimana",
    text: "The famous aerial vehicle of the Ramayana, explored as story, symbol, and ancient imagination.",
    href: "/pushpaka-vimana",
    tone: "amber",
    image: "/images/home/home-vimana.webp",
  },
  {
    eyebrow: "Puranic mystery",
    title: "Flying Cities of Tripura",
    text: "The three moving cities destroyed by Shiva, one of the most cinematic stories in the Puranas.",
    href: "/flying-cities-of-tripura",
    tone: "violet",
    image: "/images/home/home-tripura.webp",
  },
  {
    eyebrow: "Astra knowledge",
    title: "Weapons That Responded to Thought",
    text: "Astras activated by mantra, attention, discipline, and inner qualification in the epics.",
    href: "/astras",
    tone: "fire",
    image: "/images/home/home-astras.webp",
  },
  {
    eyebrow: "Story library",
    title: "Ramayana, Mahabharata, Puranas",
    text: "A guided library of characters, hidden episodes, symbols, books, and timeless knowledge.",
    href: "/atlas/treta-yuga",
    tone: "blue",
    image: "/images/home/home-library.webp",
  },
  {
    eyebrow: "Purana knowledge",
    title: "Garuda Purana",
    text: "A sacred Purana exploring dharma, karma, afterlife journeys, rituals, and deeper meaning.",
    href: "/atlas/garuda-purana",
    tone: "shadow",
    image: "/images/home/home-garuda-purana.png",
  },
];

const curiosityPrompts = [
  {
    label: "Cosmic scale",
    title: "How large is time?",
    text: "Walk from a human lifetime into Yugas, Manvantaras, Kalpas, and Brahma's day.",
    href: "/atlas/cosmic-time",
  },
  {
    label: "Hidden worlds",
    title: "What are the 14 Lokas?",
    text: "Explore layered realms, subtle worlds, and where earthly life fits in the larger map.",
    href: "/14-lokas",
  },
  {
    label: "Epic wonder",
    title: "Did Vimanas fly?",
    text: "Enter Pushpaka Vimana through story, symbol, imagination, and source-aware context.",
    href: "/pushpaka-vimana",
  },
  {
    label: "Power and mantra",
    title: "What made Astras different?",
    text: "See why epic weapons were tied to attention, discipline, mantra, and inner qualification.",
    href: "/astras",
  },
  {
    label: "Afterlife and dharma",
    title: "What does Garuda Purana teach?",
    text: "Follow karma, ritual, afterlife journeys, and moral imagination with a calm guide.",
    href: "/atlas/garuda-purana",
  },
];

const startPaths = [
  { label: "I am new", title: "Start simple", text: "A gentle first route through cosmic time and the big map.", href: "/atlas/cosmic-time" },
  { label: "I like stories", title: "Enter the epics", text: "Begin with characters, choices, dharma, and consequence.", href: "/atlas/treta-yuga" },
  { label: "I want wonder", title: "Explore mysteries", text: "Vimanas, Astras, Lokas, and Puranic imagination in one path.", href: "/pushpaka-vimana" },
  { label: "I want sources", title: "Read with context", text: "Move through source-aware notes, meanings, and connected topics.", href: "/sources" },
];
const heroNodes = [
  { label: "Cosmic Time", href: "/atlas/cosmic-time", tone: "gold", className: "node-1" },
  { label: "Garuda Purana", href: "/atlas/garuda-purana", tone: "shadow", className: "node-7" },
  { label: "14 Lokas", href: "/14-lokas", tone: "teal", className: "node-2" },
  { label: "Vimanas", href: "/pushpaka-vimana", tone: "amber", className: "node-3" },
  { label: "Tripura", href: "/flying-cities-of-tripura", tone: "violet", className: "node-4" },
  { label: "Astras", href: "/astras", tone: "fire", className: "node-5" },
  { label: "Epics", href: "/atlas/treta-yuga", tone: "blue", className: "node-6" },
];
---
<BaseLayout title="Sanatana Path | Explore Hindu Cosmology, Epics, and Sacred Knowledge" description="A visual atlas for Hindu cosmology, Ramayana, Mahabharata, Puranas, Lokas, Vimanas, Astras, and timeless knowledge traditions.">
  <div class="home-experience">
    <div class="home-main">
      <section class="home-hero">
        <div class="hero-panel">
          <p class="eyebrow">A living knowledge atlas</p>
          <h1>Ancient wisdom, explored in a modern way.</h1>
          <p class="hero-lead">A calm visual guide to cosmic time, Lokas, Vimanas, Astras, the epics, and the Puranas. Start anywhere, then follow how each idea connects to story, source, and meaning.</p>
          <div class="hero-actions">
            <a class="primary-action" href="/atlas"><i aria-hidden="true">SP</i><span>Enter the Atlas</span><b aria-hidden="true">-&gt;</b></a>
            <a class="play-action" href="#featured-topics"><i>VIEW</i><span>Preview the topic universe</span></a>
          </div>
          <div class="mini-topics" aria-label="Featured landing topics">
            <span>Cosmic Time</span><span>14 Lokas</span><span>Vimanas</span><span>Astras</span><span>Epics</span>
          </div>
          <div class="hero-signals" aria-label="Atlas qualities">
            <span><b>01</b>Visual journeys</span>
            <span><b>02</b>Beginner clear</span>
            <span><b>03</b>Sources included</span>
          </div>
        </div>

        <aside class="atlas-orbital" aria-label="Sanatana Path topic constellation">
          <img class="hero-art" src="/images/home/home-hero.webp" alt="Cosmic sacred-geometry atlas visualization" loading="eager" decoding="async" />
          <div class="orbital-field" aria-hidden="true">
            <span class="orbit orbit-a"></span>
            <span class="orbit orbit-b"></span>
            <span class="orbit orbit-c"></span>
            <span class="orbit orbit-d"></span>
            {heroNodes.map((node) => <a class={`topic-node ${node.className} ${node.tone}`} href={node.href}><span>{node.label}</span></a>)}
          </div>
          <div class="orbital-caption">
            <p class="eyebrow">Follow the connections</p>
            <strong>Start with any topic, then see its place in time, story, source, and meaning.</strong>
          </div>
        </aside>
      </section>
      <section class="start-section" aria-labelledby="start-title">
        <div class="start-heading">
          <p class="eyebrow">Choose your path</p>
          <h2 id="start-title">Start with what interests you.</h2>
        </div>
        <div class="start-grid">
          {startPaths.map((path) => (
            <a class="start-card" href={path.href}>
              <small>{path.label}</small>
              <strong>{path.title}</strong>
              <span>{path.text}</span>
            </a>
          ))}
        </div>
      </section>
      <section id="featured-topics" class="topic-section">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Open the doors</p>
            <h2>Topics built for curiosity</h2>
          </div>
          <p>Begin with a featured journey, then follow related ideas across time, story, source, symbol, and meaning.</p>
        </div>
        <div class="topic-grid">
          {featuredTopics.map((topic) => (
            <a class={`topic-card ${topic.tone}`} href={topic.href}>
              <img src={topic.image} alt="" loading="lazy" decoding="async" />
              <div class="topic-copy">
                <p>{topic.eyebrow}</p>
                <h3>{topic.title}</h3>
                <small>{topic.text}</small>
              </div>
              <b>Explore <span aria-hidden="true">-&gt;</span></b>
            </a>
          ))}
        </div>
      </section>

      <section class="curiosity-section" aria-labelledby="curiosity-title">
        <div class="curiosity-copy">
          <p class="eyebrow">Curiosity map</p>
          <h2 id="curiosity-title">Choose the question that pulls you in.</h2>
          <p>Sanatana Path works best when a topic feels alive. Start with wonder, then move into story, source, meaning, and the larger map.</p>
          <a href="/atlas">View full atlas <span aria-hidden="true">-&gt;</span></a>
        </div>
        <div class="curiosity-rail" aria-label="Curiosity entry points">
          {curiosityPrompts.map((prompt) => (
            <a class="curiosity-card" href={prompt.href}>
              <small>{prompt.label}</small>
              <strong>{prompt.title}</strong>
              <span>{prompt.text}</span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
<style is:global>
  body:has(.home-experience) {
    background: #020a10;
    color: #f7ebd3;
  }

  body:has(.home-experience)::before {
    display: none;
  }


  .home-experience {
    min-height: 100svh;
    overflow: hidden;
    background:
      radial-gradient(circle at 70% 10%, rgb(214 172 91 / .17), transparent 28rem),
      radial-gradient(circle at 18% 40%, rgb(101 215 220 / .08), transparent 28rem),
      linear-gradient(180deg, #020a10, #031116 55%, #020a10);
  }

  .home-experience::before {
    position: fixed;
    inset: 0;
    z-index: 0;
    background-image: radial-gradient(circle, rgb(214 172 91 / .18) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: linear-gradient(to bottom, black, transparent 74%);
    pointer-events: none;
    content: "";
  }


  .home-main {
    position: relative;
    z-index: 1;
    width: min(1800px, calc(100% - 2rem));
    margin-inline: auto;
  }

  .home-hero {
    display: grid;
    min-height: calc(100svh - 6rem);
    grid-template-columns: minmax(24rem, .62fr) minmax(36rem, 1fr);
    gap: clamp(1.25rem, 4vw, 4rem);
    align-items: center;
    padding: clamp(1.2rem, 2.7vw, 2.5rem) 0 2rem;
  }

  .hero-panel {
    position: relative;
    max-width: 42rem;
    padding: 1rem 1.2rem;
  }

  .hero-panel::before {
    position: absolute;
    inset: -2rem -4rem -2rem -2rem;
    z-index: -1;
    background: linear-gradient(90deg, rgb(2 10 16 / .82), transparent);
    content: "";
  }

  .eyebrow {
    margin: 0;
    color: #f0b45f;
    font-size: .67rem;
    font-weight: 900;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .hero-panel h1,
  .section-heading h2 {
    margin: .6rem 0 0;
    color: #f7ebd3;
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 450;
    letter-spacing: -.045em;
    line-height: .95;
  }

  .hero-panel h1 {
    max-width: 10.5ch;
    font-size: clamp(3.25rem, 5.35vw, 6.15rem);
  }

  .hero-lead {
    max-width: 40rem;
    margin: 1.15rem 0 0;
    color: #c9b99d;
    font-size: clamp(1rem, 1.18vw, 1.15rem);
    line-height: 1.68;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin-top: 1.55rem;
  }

  .primary-action,
  .play-action {
    display: inline-flex;
    align-items: center;
    gap: .75rem;
    text-decoration: none;
  }

  .primary-action {
    position: relative;
    width: min(100%, 19rem);
    justify-content: space-between;
    overflow: hidden;
    border: 1px solid #e4b45e;
    border-radius: 1rem;
    padding: .78rem .9rem .78rem .82rem;
    background: linear-gradient(135deg, #f8d78b 0%, #c8913c 45%, #765020 100%);
    color: #061015;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.08rem;
    font-weight: 800;
    box-shadow: 0 22px 70px rgb(214 172 91 / .24), inset 0 1px rgb(255 255 255 / .38);
  }

  .primary-action::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 0 30%, rgb(255 255 255 / .28) 44%, transparent 58%);
    transform: translateX(-120%);
    animation: hero-sheen 5.5s ease-in-out infinite;
    content: "";
  }

  .primary-action i,
  .primary-action b {
    position: relative;
    z-index: 1;
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 50%;
    background: rgb(3 13 20 / .14);
    font-style: normal;
  }

  .primary-action span { position: relative; z-index: 1; }

  .play-action {
    width: min(100%, 19rem);
    border: 1px solid rgb(214 172 91 / .16);
    border-radius: 1rem;
    padding: .72rem .82rem;
    color: #c9b99d;
    background: linear-gradient(135deg, rgb(255 255 255 / .035), rgb(2 10 16 / .55));
    box-shadow: inset 0 1px rgb(255 255 255 / .025);
  }

  .play-action i {
    display: grid;
    width: 2.15rem;
    height: 2.15rem;
    place-items: center;
    border: 1px solid rgb(244 195 109 / .35);
    border-radius: 50%;
    color: #f4d19a;
    font-size: .62rem;
    font-style: normal;
    font-weight: 900;
  }

  .mini-topics {
    display: flex;
    flex-wrap: wrap;
    gap: .45rem .55rem;
    margin-top: 1.15rem;
  }

  .mini-topics span {
    border: 1px solid rgb(214 172 91 / .14);
    border-radius: 999px;
    padding: .34rem .55rem;
    color: #f0b45f;
    background: rgb(2 10 16 / .32);
    font-size: .62rem;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .hero-signals {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .55rem;
    margin-top: .85rem;
    max-width: 37rem;
  }

  .hero-signals span {
    border: 1px solid rgb(214 172 91 / .12);
    border-radius: .85rem;
    padding: .68rem .72rem;
    color: #d7c8ad;
    background: linear-gradient(145deg, rgb(255 255 255 / .035), rgb(2 10 16 / .18));
    font-size: .72rem;
    font-weight: 750;
  }

  .hero-signals b {
    display: block;
    margin-bottom: .22rem;
    color: #f0b45f;
    font-size: .58rem;
    letter-spacing: .12em;
  }

  .atlas-orbital {
    --caption-space: 5.75rem;
    position: relative;
    align-self: start;
    min-height: clamp(38rem, 70vh, 48rem);
    margin-top: -2.2rem;
    overflow: hidden;
    border: 1px solid rgb(214 172 91 / .2);
    border-radius: 1.55rem;
    background: radial-gradient(circle at 50% 42%, rgb(214 172 91 / .12), transparent 30%), rgb(3 13 20 / .22);
    box-shadow: inset 0 1px rgb(255 255 255 / .035), 0 34px 110px rgb(0 0 0 / .32);
  }

  .atlas-orbital::before {
    position: absolute;
    inset: 1rem 1rem calc(var(--caption-space) + .18rem) 1rem;
    z-index: 1;
    border: 1px solid rgb(244 195 109 / .16);
    border-radius: 1.1rem;
    pointer-events: none;
    content: "";
  }

  .hero-art {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    width: 100%;
    height: calc(100% - var(--caption-space));
    object-fit: cover;
    opacity: .82;
    filter: saturate(1.12) contrast(1.08) brightness(.88);
  }

  .atlas-orbital::after {
    position: absolute;
    inset: 0 0 var(--caption-space) 0;
    background:
      radial-gradient(circle at 50% 46%, transparent 0 18%, rgb(2 10 16 / .2) 58%, rgb(2 10 16 / .68) 100%),
      linear-gradient(180deg, rgb(2 10 16 / .2), transparent 38%, rgb(2 10 16 / .42));
    content: "";
  }

  .orbital-field {
    position: absolute;
    inset: 1.35rem 1.65rem calc(var(--caption-space) + .82rem) 1.65rem;
    z-index: 1;
    display: grid;
    place-items: center;
  }

  .orbit {
    position: absolute;
    border: 1px solid rgb(214 172 91 / .24);
    border-radius: 50%;
    transform: rotate(-10deg) scaleY(.54);
    animation: home-orbit 24s linear infinite;
  }

  .orbit-a { width: 82%; aspect-ratio: 1; }
  .orbit-b { width: 64%; aspect-ratio: 1; border-color: rgb(101 215 220 / .2); animation-duration: 32s; animation-direction: reverse; }
  .orbit-c { width: 100%; aspect-ratio: 1; border-style: dashed; opacity: .68; animation-duration: 42s; }
  .orbit-d { width: 44%; aspect-ratio: 1; border-color: rgb(255 122 79 / .2); animation-duration: 18s; }


  .topic-node {
    position: absolute;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: .42rem;
    min-width: 0;
    border: 1px solid color-mix(in srgb, var(--node-color, #f4d19a) 42%, transparent);
    border-radius: 999px;
    padding: .48rem .72rem;
    color: color-mix(in srgb, var(--node-color, #f4d19a) 82%, #fff2da);
    background: rgb(2 10 16 / .72);
    box-shadow: 0 0 35px var(--node-glow, rgb(214 172 91 / .14));
    backdrop-filter: blur(12px);
    text-align: center;
    text-transform: uppercase;
  }

  .topic-node::before {
    width: .42rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--node-color, #f4d19a);
    box-shadow: 0 0 16px var(--node-color, #f4d19a);
    content: "";
  }

  .topic-node span { font-size: .72rem; font-weight: 900; letter-spacing: .04em; }
  .topic-node.gold { --node-color: #f4d19a; --node-glow: rgb(244 195 109 / .22); }
  .topic-node.teal { --node-color: #65d7dc; --node-glow: rgb(101 215 220 / .22); }
  .topic-node.amber { --node-color: #ffbf73; --node-glow: rgb(255 175 78 / .22); }
  .topic-node.violet { --node-color: #c89bff; --node-glow: rgb(190 134 255 / .22); }
  .topic-node.fire { --node-color: #ff7a4f; --node-glow: rgb(255 122 79 / .22); }
  .topic-node.blue { --node-color: #85a8ff; --node-glow: rgb(133 168 255 / .22); }
  .topic-node.shadow { --node-color: #dcc49d; --node-glow: rgb(220 196 157 / .22); }

  .node-1 { top: 13%; left: 48%; }
  .node-7 { top: 18%; left: 49%; transform: translateY(2.1rem); }
  .node-2 { top: 35%; right: 13%; }
  .node-3 { bottom: 26%; right: 16%; }
  .node-4 { bottom: 25%; left: 47%; }
  .node-5 { bottom: 32%; left: 12%; }
  .node-6 { top: 31%; left: 13%; }

  .orbital-caption {
    position: absolute;
    right: 1.05rem;
    bottom: .62rem;
    left: 1.05rem;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    overflow: hidden;
    border: 1px solid rgb(214 172 91 / .2);
    border-radius: 1rem;
    padding: .65rem 1rem;
    background:
      linear-gradient(135deg, rgb(255 255 255 / .075), rgb(2 10 16 / .58)),
      radial-gradient(circle at 10% 0%, rgb(244 195 109 / .12), transparent 18rem);
    box-shadow: inset 0 1px rgb(255 255 255 / .08), 0 18px 48px rgb(0 0 0 / .28);
    backdrop-filter: blur(22px) saturate(1.2);
  }

  .orbital-caption::before {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, rgb(255 255 255 / .12), transparent 34%, rgb(101 215 220 / .06));
    opacity: .55;
    pointer-events: none;
    content: "";
  }

  .orbital-caption > * {
    position: relative;
    z-index: 1;
  }

  .orbital-caption strong {
    display: block;
    max-width: 40ch;
    color: #eee3cf;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.05rem;
    font-weight: 450;
    line-height: 1.25;
  }

  .topic-section {
    margin-top: 1.2rem;
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, .85fr) minmax(0, 1fr);
    gap: 1.2rem;
    align-items: end;
  }

  .section-heading {
    margin-bottom: 1rem;
  }

  .section-heading h2 {
    font-size: clamp(2.2rem, 4vw, 4.6rem);
  }

  .section-heading > p {
    color: #aaa49a;
    line-height: 1.7;
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .topic-card {
    position: relative;
    display: flex;
    min-height: clamp(25rem, 31vw, 34rem);
    overflow: hidden;
    align-items: flex-end;
    border: 1px solid rgb(214 172 91 / .18);
    border-radius: 1.25rem;
    padding: .9rem;
    background: rgb(3 13 20 / .35);
    box-shadow: inset 0 1px rgb(255 255 255 / .035), 0 18px 50px rgb(0 0 0 / .16);
    transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
  }

  .topic-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: .82;
    filter: saturate(1.16) contrast(1.1) brightness(.92);
    transform: scale(1.01);
    transition: transform 850ms ease, opacity 260ms ease, filter 260ms ease;
  }

  .topic-card::after {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 76% 18%, transparent 0 26%, rgb(2 10 16 / .06) 48%, rgb(2 10 16 / .28) 100%),
      linear-gradient(180deg, rgb(2 10 16 / .04) 0%, rgb(2 10 16 / .08) 44%, rgb(2 10 16 / .76) 100%);
    content: "";
  }

  .topic-card::before {
    position: absolute;
    inset: auto -12% -24% auto;
    z-index: 1;
    width: 18rem;
    height: 18rem;
    border-radius: 50%;
    background: var(--glow, rgb(214 172 91 / .18));
    filter: blur(42px);
    opacity: .9;
    transition: opacity 220ms ease, transform 700ms ease;
    content: "";
  }

  .topic-card:hover {
    transform: translateY(-6px);
    border-color: rgb(244 195 109 / .5);
    box-shadow: 0 26px 80px rgb(0 0 0 / .34), 0 0 55px var(--glow, rgb(214 172 91 / .16));
  }

  .topic-card:hover img {
    transform: scale(1.07);
    opacity: .95;
    filter: saturate(1.24) contrast(1.12) brightness(1.02);
  }

  .topic-card:hover::before {
    opacity: 1;
    transform: scale(1.08);
  }

  .topic-card.gold { --glow: rgb(244 195 109 / .22); }
  .topic-card.teal { --glow: rgb(101 215 220 / .2); }
  .topic-card.amber { --glow: rgb(255 175 78 / .22); }
  .topic-card.violet { --glow: rgb(190 134 255 / .2); }
  .topic-card.fire { --glow: rgb(255 122 79 / .22); }
  .topic-card.blue { --glow: rgb(133 168 255 / .2); }

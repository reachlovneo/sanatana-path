de-panel{position:sticky;top:6rem;align-self:start;padding:clamp(1.1rem,2.2vw,1.5rem)}.side-panel h2{margin:1.2rem 0 .8rem;font-size:clamp(1.6rem,2.4vw,2.4rem)}.side-panel a{display:inline-flex;margin-top:.6rem;border:1px solid light-dark(rgb(118 93 55 / 0.32), rgb(255 191 115/.32));border-radius:999px;padding:.55rem .78rem;color:light-dark(rgb(110 89 62 / 1), #ffcf91);background:rgb(255 191 115/.07);font-size:.68rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase;text-decoration:none}@media(max-width:920px){.hero-card{width:auto;margin-top:clamp(10rem,28svh,15rem)}.topic-layout{grid-template-columns:1fr}.reading-panel{columns:1}.side-panel{position:static}}@media(max-width:640px){.topic-hero,.topic-layout{width:min(100% - 1rem,1460px)}.hero-card{margin:clamp(8rem,24svh,12rem) .75rem .75rem}}
</style>
---
import BaseLayout from "../../layouts/BaseLayout.astro";

const weaponJourneyItems = [
  { title: "Part I - Astras", href: "/astras/part-1", eyebrow: "Mantra weapons", description: "Weapons invoked through mantra, concentration, discipline, and divine authority.", status: "available" },
  { title: "Part II - Ayudhas", href: "/astras/part-2", eyebrow: "Divine weapons", description: "The eternal weapons carried by the gods, inseparable from their divine identities.", status: "available" },
  { title: "Part III - Epic Weapons", href: "/astras/part-3", eyebrow: "Hero weapons", description: "The legendary weapons of epic heroes, including Gandiva, Kodanda, Vijaya, and Chandrahasa.", status: "available" },
];

const weaponGroups = [
  { number: "01", title: "Divine Discus - Chakras", note: "The Chakras are celestial spinning weapons symbolizing the preservation of cosmic order and the destruction of adharma.", columns: ["Ayudha", "Divine Bearer", "Symbolism"], rows: [["Sudarshana Chakra", "Vishnu", "Cosmic order, protection, and righteous destruction"]] },
  { number: "02", title: "Divine Swords", note: "These sacred swords symbolize knowledge, discernment, and the power to cut through ignorance and falsehood.", columns: ["Ayudha", "Divine Bearer", "Symbolism"], rows: [["Nandaka", "Vishnu", "Divine wisdom and knowledge"], ["Asi - Primordial Sword", "Brahma origin, later various deities and kings", "Justice and the protection of Dharma"]] },
  { number: "03", title: "Divine Bows", note: "These celestial bows are associated with legendary warriors and the defense of Dharma. Each possesses unique powers granted by the gods.", columns: ["Ayudha", "Divine Bearer", "Symbolism"], rows: [["Sharanga", "Vishnu", "Protection and preservation"], ["Pinaka", "Shiva", "Supreme power and destruction of evil"], ["Kodanda", "Rama", "Righteous warfare and Dharma"], ["Vijaya", "Karna", "Invincibility and martial excellence"], ["Gandiva", "Arjuna", "Divine duty and heroic valor"]] },
  { number: "04", title: "Divine Spears, Tridents and Lances", note: "These weapons represent immense spiritual power, divine authority, and the destruction of negativity.", columns: ["Ayudha", "Divine Bearer", "Symbolism"], rows: [["Trishula", "Shiva", "Creation, preservation, and dissolution"], ["Vel", "Kartikeya (Skanda)", "Divine knowledge and victory over evil"], ["Shakti - Divine Lance", "Indra and divine warriors", "Celestial power and decisive force"]] },
  { number: "05", title: "Divine Maces and Blunt Weapons", note: "Symbols of immense strength, stability, and righteous power.", columns: ["Ayudha", "Divine Bearer", "Symbolism"], rows: [["Kaumodaki Gada", "Vishnu", "Divine strength and sovereignty"], ["Gada of Hanuman", "Hanuman", "Devotion, courage, and unmatched strength"], ["Vajra", "Indra", "Thunder, indestructibility, and divine authority"]] },
  { number: "06", title: "Divine Axes and Cutting Weapons", note: "Weapons representing justice, discipline, and the removal of unrighteousness.", columns: ["Ayudha", "Divine Bearer", "Symbolism"], rows: [["Parashu", "Parashurama", "Justice and the destruction of tyranny"]] },
  { number: "07", title: "Divine Nooses and Binding Weapons", note: "Not every divine weapon destroys. Some restrain, capture, or uphold cosmic law.", columns: ["Ayudha", "Divine Bearer", "Symbolism"], rows: [["Pasha", "Yama", "Control over life and death"], ["Varuna Pasha", "Varuna", "Restraint, justice, and divine authority"]] },
  { number: "08", title: "Divine Staffs and Scepters", note: "These sacred staffs symbolize judgment, discipline, and the authority to uphold cosmic order.", columns: ["Ayudha", "Divine Bearer", "Symbolism"], rows: [["Yama Danda", "Yama", "Justice, karma, and righteous punishment"], ["Brahma Danda", "Brahma and great sages in tradition", "Supreme spiritual authority"]] },
];
---
<BaseLayout title="Part II - Ayudhas | Sanatana Path" description="A dedicated atlas page for Ayudhas, the divine weapons carried by the gods as symbols of cosmic power and sacred responsibility." image="/images/home/home-astras.webp" type="article">
  <article class="weapon-page">
    <section class="weapon-hero">
      <div class="hero-glass">
        <a class="back-link" href="/astras">Weapons overview</a>
        <p class="eyebrow">Atlas of Divine Weapons</p>
        <h1>Part II - Ayudhas</h1>
        <strong>The Divine Weapons of the Gods</strong>
        <p>While Astras are awakened through mantra and spiritual invocation, Ayudhas are the eternal weapons carried by the gods themselves. Each is more than an instrument of battle: it is a sacred symbol of the deity who wields it.</p>
      </div>
    </section>

    <nav class="weapon-progress" aria-label="Sacred weapons part navigation">
      <div class="progress-head"><span>Part path</span><strong>Sacred Weapons</strong></div>
      <div>{weaponJourneyItems.map((item, index) => <a href={item.href} class="progress-item" title={item.description}><span>{String(index + 1).padStart(2, "0")}</span><strong>{item.title}</strong><small>{item.eyebrow}</small></a>)}</div>
    </nav>

    <div class="weapon-layout">
      <main class="weapon-groups">
        <section class="intro-panel"><p>Many of these divine weapons appear throughout the Ramayana, Mahabharata, and numerous Puranas, becoming inseparable from the identities of the gods themselves.</p></section>
        {weaponGroups.map((group) => (
          <section class="weapon-group"><header><span>{group.number}</span><div><p class="eyebrow">Ayudha category</p><h2>{group.title}</h2><p>{group.note}</p></div></header><div class="weapon-table" role="table" aria-label={group.title}><div class="table-row table-head" role="row">{group.columns.map((column) => <span role="columnheader">{column}</span>)}</div>{group.rows.map((row) => <div class="table-row" role="row">{row.map((cell) => <span role="cell">{cell}</span>)}</div>)}</div></section>
        ))}
        <section class="intro-panel"><p>Unlike ordinary arms carried into battle, the Ayudhas of the gods are living symbols of divine purpose. Sudarshana Chakra represents cosmic order. Trishula embodies creation, preservation, and dissolution. Vajra symbolizes unbreakable resolve. Vel represents piercing wisdom.</p><p>Each Ayudha reflects the nature of its divine bearer, making these sacred weapons as much symbols of philosophy as instruments of power.</p></section>
      </main>
      <aside class="next-panel"><p class="eyebrow">Continue to the next page</p><h2>Part III - Epic Weapons</h2><p>Beyond Astras and divine Ayudhas, the epics preserve legendary weapons made famous by the heroes who carried them.</p><a href="/astras/part-3">Open Part III</a></aside>
    </div>
  </article>
</BaseLayout>

<style>
  :global(body:has(.weapon-page)){background:#020d13;color:#fff4df}:global(body:has(.weapon-page)::before){display:none}.weapon-page{min-height:100svh;padding-bottom:4rem;background:radial-gradient(circle at 78% 0%,rgb(255 122 79/.14),transparent 28rem),linear-gradient(180deg,#020d13,#031519 54%,#020d13)}.weapon-hero{position:relative;width:min(1460px,calc(100% - 2rem));min-height:clamp(27rem,54svh,36rem);margin:1.25rem auto 0;overflow:hidden;border:1px solid rgb(255 122 79/.32);border-radius:1.15rem;background-image:linear-gradient(90deg,rgb(2 13 19/.92),rgb(2 13 19/.44) 46%,rgb(2 13 19/.12)),url("/images/home/home-astras.webp");background-position:center,right center;background-size:auto,auto 100%;background-repeat:no-repeat;box-shadow:inset 0 0 0 1px rgb(255 255 255/.025),0 28px 90px rgb(0 0 0/.3)}.weapon-hero::after{position:absolute;inset:0;background:linear-gradient(180deg,rgb(2 13 19/.28),transparent 20%,transparent 74%,rgb(2 13 19/.32));content:"";pointer-events:none}.hero-glass{position:relative;z-index:1;width:min(43rem,45%);margin:clamp(1.4rem,3vw,2.7rem);border:1px solid rgb(255 122 79/.38);border-radius:1rem;padding:clamp(1.25rem,2.6vw,2rem);background:linear-gradient(145deg,rgb(3 13 20/.58),rgb(3 13 20/.26)),radial-gradient(circle at 16% 0%,rgb(255 122 79/.18),transparent 52%);box-shadow:inset 0 1px rgb(255 255 255/.08),0 24px 75px rgb(0 0 0/.22);backdrop-filter:blur(22px) saturate(126%)}.back-link{display:inline-flex;width:fit-content;margin-bottom:clamp(1rem,2vw,1.5rem);border:1px solid rgb(255 122 79/.34);border-radius:999px;padding:.5rem .72rem;background:rgb(3 13 20/.38);color:#ff9b7d;font-size:.72rem;font-weight:850;text-decoration:none;backdrop-filter:blur(14px)}.eyebrow{margin:0 0 .6rem;color:#ff9b7d;font-size:.7rem;font-weight:900;letter-spacing:.16em;text-transform:uppercase}h1,h2{margin:0;color:#fff4df;font-family:var(--serif);font-weight:500;letter-spacing:0;line-height:.98}.hero-glass h1{font-size:clamp(3rem,5vw,5.4rem)}.hero-glass strong{display:block;margin-top:.65rem;color:#ffd3bf;font-size:clamp(1.05rem,1.5vw,1.3rem)}.hero-glass p:not(.eyebrow){max-width:44rem;margin:1rem 0 0;color:#eee0ca;font-size:clamp(1rem,1.18vw,1.12rem);line-height:1.75}.weapon-progress{display:grid;grid-template-columns:auto minmax(0,1fr);gap:.75rem;align-items:center;width:min(1460px,calc(100% - 2rem));margin:clamp(1rem,2vw,1.35rem) auto 0;border:1px solid rgb(255 122 79/.28);border-radius:1rem;padding:.72rem;background:linear-gradient(135deg,rgb(255 122 79/.08),rgb(2 13 19/.48));box-shadow:inset 0 1px rgb(255 255 255/.045),0 16px 38px rgb(0 0 0/.18)}.progress-head{display:grid;min-width:9rem;border-right:1px solid rgb(255 122 79/.22);padding:.15rem .95rem .15rem .35rem}.progress-head span{color:#ff9b7d;font-size:.58rem;font-weight:900;letter-spacing:.13em;text-transform:uppercase}.progress-head strong{margin-top:.12rem;color:#fff4df;font-family:var(--serif);font-size:1.05rem;font-weight:500}.weapon-progress>div:last-child{display:flex;gap:.46rem;min-width:0;overflow-x:auto;scrollbar-width:none}.progress-item{display:grid;min-width:10.7rem;grid-template-columns:auto 1fr;align-items:center;gap:.12rem .48rem;border:1px solid rgb(255 122 79/.28);border-radius:999px;padding:.48rem .72rem .48rem .46rem;background:rgb(255 122 79/.07);color:#fff4df;text-decoration:none}.progress-item>span{display:grid;width:1.78rem;height:1.78rem;grid-row:1/3;place-items:center;border-radius:50%;background:rgb(255 122 79/.16);color:#ffb194;font-size:.58rem;font-weight:900}.progress-item strong,.progress-item small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.progress-item strong{font-size:.73rem;font-weight:850}.progress-item small{color:#cfa99b;font-size:.55rem;font-weight:850;text-transform:uppercase}.weapon-layout{display:grid;width:min(1460px,calc(100% - 2rem));grid-template-columns:minmax(0,1fr) minmax(18rem,23rem);gap:clamp(1.25rem,3vw,2.5rem);margin:clamp(1.25rem,3vw,2rem) auto 0}.weapon-groups{display:grid;gap:1rem}.weapon-group,.next-panel,.intro-panel{border:1px solid rgb(255 122 79/.25);border-radius:1rem;background:linear-gradient(145deg,rgb(3 13 20/.86),rgb(3 13 20/.62));box-shadow:inset 0 1px rgb(255 255 255/.045),0 20px 60px rgb(0 0 0/.18)}.intro-panel{padding:clamp(1rem,2vw,1.35rem);color:#e8decc;line-height:1.75}.weapon-group{overflow:hidden}.weapon-group header{display:grid;grid-template-columns:auto 1fr;gap:1rem;padding:clamp(1rem,2vw,1.35rem)}.weapon-group header>span{display:grid;width:2.7rem;height:2.7rem;place-items:center;border:1px solid rgb(255 122 79/.34);border-radius:50%;color:#ffb194;font-size:.72rem;font-weight:900}.weapon-group h2{font-size:clamp(1.6rem,2.4vw,2.35rem)}.weapon-group header p:not(.eyebrow){max-width:70ch;margin:.65rem 0 0;color:#e8decc;line-height:1.75}.weapon-table{display:grid;border-top:1px solid rgb(255 122 79/.18)}.table-row{display:grid;grid-template-columns:minmax(10rem,.9fr) minmax(10rem,.8fr) minmax(14rem,1.2fr)}.table-row span{min-width:0;border-right:1px solid rgb(255 122 79/.12);border-bottom:1px solid rgb(255 122 79/.12);padding:.82rem .9rem;color:#e8decc;line-height:1.45}.table-row span:last-child{border-right:0}.table-head span{color:#ffb194;background:rgb(255 122 79/.08);font-size:.64rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.next-panel{position:sticky;top:6rem;align-self:start;padding:clamp(1rem,2vw,1.35rem)}.next-panel h2{font-size:clamp(1.75rem,2.5vw,2.45rem)}.next-panel p{color:#e8decc;line-height:1.7}.next-panel a{display:inline-flex;margin-top:.5rem;border:1px solid rgb(255 122 79/.32);border-radius:999px;padding:.46rem .68rem;color:#ffb194;background:rgb(255 122 79/.08);font-size:.68rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase;text-decoration:none}@media(max-width:980px){.hero-glass{width:auto;margin-top:clamp(10rem,28svh,16rem)}.weapon-hero{background-size:auto,cover}.weapon-progress,.weapon-layout{grid-template-columns:1fr}.progress-head{border-right:0;border-bottom:1px solid rgb(255 122 79/.22);padding-bottom:.6rem}.next-panel{position:static}}@media(max-width:720px){.weapon-page{padding-bottom:6rem}.weapon-hero,.weapon-progress,.weapon-layout{width:min(100% - 1rem,1460px)}.hero-glass{margin:clamp(8rem,24svh,12rem) .75rem .75rem}.weapon-group header{grid-template-columns:1fr}.table-row{grid-template-columns:1fr}.table-head{display:none}.table-row span{display:grid;grid-template-columns:minmax(7rem,.42fr) 1fr;gap:.75rem;border-right:0}.table-row span::before{color:#ffb194;font-size:.62rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase;content:"Ayudha"}.table-row span:nth-child(2)::before{content:"Bearer"}.table-row span:nth-child(3)::before{content:"Symbolism"}}
</style>
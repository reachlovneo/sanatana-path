---
import BaseLayout from "../../layouts/BaseLayout.astro";

const heroImage = "/images/astras/part-2-ayudhas-hero.png";

const weaponJourneyItems = [
  { title: "Part I - Astras", href: "/astras/part-1", eyebrow: "Mantra weapons", description: "Weapons invoked through mantra, concentration, discipline, and divine authority.", status: "available" },
  { title: "Part II - Ayudhas", href: "/astras/part-2", eyebrow: "Divine weapons", description: "The eternal weapons carried by the gods, inseparable from their divine identities.", status: "available" },
  { title: "Part III - Epic Weapons", href: "/astras/part-3", eyebrow: "Hero weapons", description: "The legendary weapons of epic heroes, including Gandiva, Kodanda, Vijaya, and Chandrahasa.", status: "available" },
];

const weaponGroups = [
  { number: "01", title: "Divine Discus - Chakras", note: "The Chakras are celestial spinning weapons symbolizing the preservation of cosmic order and the destruction of adharma.", columns: ["Ayudha", "Divine Bearer", "Symbolism"], rows: [["Sudarshana Chakra", "Vishnu", "Cosmic order, protection, and righteous destruction"]] },
  { number: "02", title: "Divine Swords", note: "These sacred swords symbolize knowledge, discernment, and the power to cut through ignorance and falsehood.", columns: ["Ayudha", "Divine Bearer", "Symbolism"], rows: [["Nandaka", "Vishnu", "Divine wisdom and knowledge"], ["Asi - Primordial Sword", "Brahma origin, later various deities and kings", "Justice and the protection of Dharma"]] },
  { number: "03", title: "Divine Bows", note: "These celestial bows are associated with legendary warriors and the defense of Dharma. Each possesses unique powers granted by the gods.", columns: ["Ayudha", "Divine Bearer", "Symbolism"], rows: [["Sharanga", "Vishnu", "Protection and preservation"], ["Pinaka", "Shiva", "Supreme power and destruction of evil"], ["Kodanda", "Rama", "Righteous warfare and Dharma"], ["Vijaya", "Karna", "Invincibility and martial excellence"], ["Gandiva", "Arjuna", "Divine duty and heroic valor"]] },
  { number: "04", title: "Divine Spears, Tridents and Lances", note: "These weapons represent immense spiritual power, divine authority, and the destruction of negativity.", columns: ["Ayudha", "Divine Bearer", "Symbolism"], rows: [["Trishula", "Shiva", "Creation, preservation, and dissolution"], ["Vel", "Kartikeya (Skanda)", "Divine knowledge and victory over evil"], ["Shakti - Divine Lance", "Indra and divine warriors", "Celestial power and decisive force"]] },
  { number: "05", title: "Divine Maces and Blunt Weapons", note: "Symbols of immense strength, stability, and righteous power.", columns: ["Ayudha", "Divine Bearer", "Symbolism"], rows: [["Kaumodaki Gada", "Vishnu", "Divine strength and sovereignty"], ["Gada of Hanuman", "Hanuman", "Devotion, courage, and unmatched strength"], ["Vajra", "Indra", "Thunder, indestructibility, and divine authority"]] },
  { number: "06", title: "Divine Axes and Cutting Weapons", note: "Weapons representing justice, discipline, and the removal of unrighteousness.", columns: ["Ayudha", "Divine Bearer", "Symbolism"], rows: [["Parashu", "Parashurama", "Justice and the destruction of tyranny"]] },
  { number: "07", title: "Divine Nooses and Binding Weapons", note: "Not every divine weapon destroys. Some restrain, capture, or uphold cosmic law.", columns: ["Ayudha", "Divine Bearer", "Symbolism"], rows: [["Pasha", "Yama", "Control over life and death"], ["Varuna Pasha", "Varuna", "Restraint, justice, and divine authority"]] },
  { number: "08", title: "Divine Staffs and Scepters", note: "These sacred staffs symbolize judgment, discipline, and the authority to uphold cosmic order.", columns: ["Ayudha", "Divine Bearer", "Symbolism"], rows: [["Yama Danda", "Yama", "Justice, karma, and righteous punishment"], ["Brahma Danda", "Brahma and great sages in tradition", "Supreme spiritual authority"]] },
];
---
<BaseLayout title="Ayudhas | Sanatana Path" description="A dedicated atlas page for Ayudhas, the divine weapons carried by the gods as symbols of cosmic power and sacred responsibility." image={heroImage} type="article">
  <article class="weapon-page" style={`--accent:#f3c879; --warm:#ff9b58; --hero-image:url('/images/astras/part-2-ayudhas-hero.png')`}>
    <section class="weapon-hero">
      <div class="hero-glass">
        <a class="back-link" href="/astras">Weapons overview</a>
        <p class="eyebrow">Atlas of Divine Weapons</p>
        <h1>Ayudhas</h1>
        <strong>The Divine Weapons of the Gods</strong>
        <p>While Astras are awakened through mantra and spiritual invocation, Ayudhas are the eternal weapons carried by the gods themselves. Each is more than an instrument of battle: it is a sacred symbol of the deity who wields it.</p>
      </div>
    </section>

    <nav class="weapon-progress" aria-label="Sacred weapons part navigation">
      <div class="progress-head"><span>Part path</span><strong>Sacred Weapons</strong></div>
      <div>{weaponJourneyItems.map((item, index) => <a href={item.href} class:list={["progress-item", item.href === "/astras/part-2" && "active"]} title={item.description}><span>{String(index + 1).padStart(2, "0")}</span><strong>{item.title}</strong><small>{item.eyebrow}</small></a>)}</div>
    </nav>

    <div class="weapon-layout">
      <div data-reading-body class="weapon-groups">
        <section class="intro-panel"><p>Many of these divine weapons appear throughout the Ramayana, Mahabharata, and numerous Puranas, becoming inseparable from the identities of the gods themselves.</p></section>
        {weaponGroups.map((group) => (
          <section class="weapon-group"><header><span>{group.number}</span><div><p class="eyebrow">Ayudha category</p><h2>{group.title}</h2><p>{group.note}</p></div></header><div class="weapon-table" role="table" aria-label={group.title}><div class="table-row table-head" role="row">{group.columns.map((column) => <span role="columnheader">{column}</span>)}</div>{group.rows.map((row) => <div class="table-row" role="row">{row.map((cell) => <span role="cell">{cell}</span>)}</div>)}</div></section>
        ))}
        <section class="intro-panel"><p>Unlike ordinary arms carried into battle, the Ayudhas of the gods are living symbols of divine purpose. Sudarshana Chakra represents cosmic order. Trishula embodies creation, preservation, and dissolution. Vajra symbolizes unbreakable resolve. Vel represents piercing wisdom.</p><p>Each Ayudha reflects the nature of its divine bearer, making these sacred weapons as much symbols of philosophy as instruments of power.</p></section>
      </div>
      <aside class="next-panel"><p class="eyebrow">Continue to the next page</p><h2>Part III - Epic Weapons</h2><p>Beyond Astras and divine Ayudhas, the epics preserve legendary weapons made famous by the heroes who carried them.</p><a href="/astras/part-3">Open Part III</a></aside>
    </div>
  </article>
</BaseLayout>

<style>
  :global(body:has(.weapon-page)) {
    background: light-dark(rgb(247 240 226 / 1), #02070b);
    color: light-dark(rgb(43 33 24 / 1), #fff4df);
  }

  :global(body:has(.weapon-page)::before) {
    display: none;
  }

  .weapon-page {
    min-height: 100svh;
    padding: clamp(.75rem, 1.4vw, 1.15rem) 0 5rem;
    background:
      radial-gradient(circle at 76% 2%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 30rem),
      radial-gradient(circle at 12% 44%, color-mix(in srgb, var(--warm) 10%, transparent), transparent 24rem),
      linear-gradient(180deg, light-dark(rgb(247 240 226 / 1), #02070b), light-dark(rgb(247 240 226 / 1), #061014) 42%, light-dark(rgb(247 240 226 / 1), #02070b));
  }

  .weapon-hero,
  .weapon-progress,
  .weapon-layout {
    width: min(1500px, calc(100% - 2rem));
    margin-inline: auto;
  }

  .weapon-hero {
    position: relative;
    min-height: clamp(34rem, 68svh, 48rem);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--accent) 34%, transparent);
    border-radius: clamp(1.1rem, 2vw, 2rem);
    background: light-dark(rgb(247 240 226 / 1), #02070b);
    isolation: isolate;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / .03), 0 30px 90px light-dark(rgb(91 69 38 / 0.126), rgb(0 0 0 / .36));
  }

  .weapon-hero::before {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(90deg, light-dark(rgb(247 240 226 / 0.96), rgb(2 7 11 / .96)), light-dark(rgb(247 240 226 / 0.6), rgb(2 7 11 / .6)) 36%, light-dark(rgb(247 240 226 / 0.12), rgb(2 7 11 / .12)) 68%),
      linear-gradient(180deg, light-dark(rgb(247 240 226 / 0.2), rgb(2 7 11 / .2)), transparent 46%, light-dark(rgb(247 240 226 / 0.88), rgb(2 7 11 / .88))),
      var(--hero-image);
    background-position: center, center, center;
    background-size: cover, cover, cover;
    content: "";
    transform: scale(1.02);
  }

  .weapon-hero::after {
    position: absolute;
    inset: clamp(1rem, 2vw, 1.6rem);
    z-index: -1;
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    border-radius: clamp(.9rem, 1.6vw, 1.45rem);
    background:
      linear-gradient(90deg, light-dark(rgb(99 76 44 / 0.035), rgb(255 255 255 / .035)), transparent 34%, transparent 66%, light-dark(rgb(99 76 44 / 0.025), rgb(255 255 255 / .025))),
      repeating-linear-gradient(90deg, transparent 0 7.8rem, light-dark(rgb(99 76 44 / 0.025), rgb(255 255 255 / .025)) 7.8rem 7.86rem);
    content: "";
    pointer-events: none;
  }

  .hero-glass {
    display: grid;
    width: min(48rem, 52%);
    min-height: calc(100% - clamp(2rem, 4vw, 3.2rem));
    align-content: end;
    gap: .9rem;
    margin: clamp(1rem, 2vw, 1.6rem);
    padding: clamp(1.35rem, 3vw, 2.5rem);
    border-radius: clamp(.95rem, 1.6vw, 1.4rem);
    background:
      linear-gradient(145deg, light-dark(rgb(247 240 226 / 0.76), rgb(2 7 11 / .76)), light-dark(rgb(247 240 226 / 0.32), rgb(2 7 11 / .32))),
      radial-gradient(circle at 18% 12%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 48%);
    box-shadow: inset 0 1px rgb(255 255 255 / .08), 0 24px 80px light-dark(rgb(91 69 38 / 0.098), rgb(0 0 0 / .28));
    backdrop-filter: blur(22px) saturate(128%);
  }

  .back-link,
  .progress-item,
  .next-panel a {
    transition: transform .22s ease, border-color .22s ease, background .22s ease, color .22s ease;
  }

  .back-link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: .5rem;
    border: 1px solid color-mix(in srgb, var(--accent) 38%, transparent);
    border-radius: 999px;
    padding: .55rem .78rem;
    background: light-dark(rgb(247 240 226 / 0.42), rgb(2 7 11 / .42));
    color: color-mix(in srgb, var(--accent) 72%, light-dark(rgb(43 33 24 / 1), #fff4df));
    font-size: .72rem;
    font-weight: 900;
    letter-spacing: .08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .back-link:hover,
  .progress-item:hover,
  .next-panel a:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 64%, transparent);
  }

  .eyebrow {
    margin: 0;
    color: color-mix(in srgb, var(--accent) 72%, light-dark(rgb(43 33 24 / 1), #fff4df));
    font-size: .72rem;
    font-weight: 900;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    color: light-dark(rgb(43 33 24 / 1), #fff4df);
    font-family: var(--serif);
    font-weight: 500;
    letter-spacing: 0;
    line-height: .98;
  }

  .hero-glass h1 {
    max-width: 11ch;
    font-size: clamp(3.8rem, 6.3vw, 7rem);
    text-shadow: 0 14px 40px light-dark(rgb(91 69 38 / 0.193), rgb(0 0 0 / .55));
  }

  .hero-glass strong {
    color: color-mix(in srgb, var(--warm) 74%, light-dark(rgb(43 33 24 / 1), #fff4df));
    font-family: var(--serif);
    font-size: clamp(1.2rem, 1.7vw, 1.65rem);
    font-weight: 600;
  }

  .hero-glass p:not(.eyebrow) {
    max-width: 42rem;
    margin: 0;
    color: light-dark(rgb(91 76 57 / 1), #eee0ca);
    font-size: clamp(1rem, 1.15vw, 1.14rem);
    line-height: 1.72;
  }

  .weapon-progress {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: .85rem;
    align-items: center;
    margin-top: clamp(.9rem, 1.6vw, 1.25rem);
    border: 1px solid light-dark(rgb(118 93 55 / 0.09), rgb(255 255 255 / .09));
    border-radius: 1.15rem;
    padding: .75rem;
    background: linear-gradient(135deg, light-dark(rgb(99 76 44 / 0.06), rgb(255 255 255 / .06)), light-dark(rgb(99 76 44 / 0.025), rgb(255 255 255 / .025)));
    box-shadow: inset 0 1px rgb(255 255 255 / .05), 0 18px 46px light-dark(rgb(91 69 38 / 0.07), rgb(0 0 0 / .2));
  }

  .progress-head {
    display: grid;
    min-width: 9.5rem;
    border-right: 1px solid light-dark(rgb(118 93 55 / 0.1), rgb(255 255 255 / .1));
    padding: .15rem 1rem .15rem .35rem;
  }

  .progress-head span {
    color: color-mix(in srgb, var(--accent) 70%, light-dark(rgb(43 33 24 / 1), #fff4df));
    font-size: .58rem;
    font-weight: 900;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .progress-head strong {
    margin-top: .12rem;
    color: light-dark(rgb(43 33 24 / 1), #fff4df);
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 500;
  }

  .weapon-progress > div:last-child {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .55rem;
  }

  .progress-item {
    display: grid;
    min-width: 0;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: .12rem .55rem;
    border: 1px solid light-dark(rgb(118 93 55 / 0.09), rgb(255 255 255 / .09));
    border-radius: .95rem;
    padding: .62rem .72rem .62rem .55rem;
    background: light-dark(rgb(247 240 226 / 0.45), rgb(2 7 11 / .45));
    color: light-dark(rgb(43 33 24 / 1), #fff4df);
    text-decoration: none;
  }

  .progress-item.active {
    border-color: color-mix(in srgb, var(--accent) 54%, transparent);
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 18%, transparent), light-dark(rgb(99 76 44 / 0.035), rgb(255 255 255 / .035)));
  }

  .progress-item > span {
    display: grid;
    width: 2rem;
    height: 2rem;
    grid-row: 1 / 3;
    place-items: center;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 18%, light-dark(rgb(247 240 226 / 1), #0a0f10));
    color: light-dark(rgb(43 33 24 / 1), #fff4df);
    font-size: .62rem;
    font-weight: 950;
  }

  .progress-item strong,
  .progress-item small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .progress-item strong {
    font-size: .76rem;
    font-weight: 900;
  }

  .progress-item small {
    color: light-dark(rgb(91 76 57 / 1), #d9c7a8);
    font-size: .56rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .weapon-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem);
    gap: clamp(1rem, 2.4vw, 2rem);
    margin-top: clamp(1.15rem, 2vw, 1.7rem);
  }

  .weapon-groups {
    display: grid;
    gap: clamp(1rem, 1.8vw, 1.35rem);
  }

  .intro-panel,
  .weapon-group,
  .next-panel {
    border: 1px solid light-dark(rgb(118 93 55 / 0.08), rgb(255 255 255 / .08));
    border-radius: 1.35rem;
    background:
      linear-gradient(145deg, light-dark(rgb(99 76 44 / 0.055), rgb(255 255 255 / .055)), light-dark(rgb(99 76 44 / 0.018), rgb(255 255 255 / .018))),
      linear-gradient(180deg, light-dark(rgb(247 240 226 / 0.78), rgb(2 7 11 / .78)), light-dark(rgb(247 240 226 / 0.58), rgb(2 7 11 / .58)));
    box-shadow: inset 0 1px rgb(255 255 255 / .055), 0 22px 70px light-dark(rgb(91 69 38 / 0.063), rgb(0 0 0 / .18));
  }

  .intro-panel {
    padding: clamp(1.15rem, 2vw, 1.6rem);
    color: light-dark(rgb(91 76 57 / 1), #eadfcc);
    font-size: clamp(1rem, 1.08vw, 1.08rem);
    line-height: 1.75;
  }

  .intro-panel p {
    margin: 0;
  }

  .intro-panel p + p {
    margin-top: .85rem;
  }

  .weapon-group {
    position: relative;
    overflow: hidden;
  }

  .weapon-group::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: .22rem;
    background: linear-gradient(180deg, transparent, var(--accent), transparent);
    content: "";
    opacity: .7;
  }

  .weapon-group header {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    padding: clamp(1.1rem, 2vw, 1.55rem);
  }

  .weapon-group header > span {
    display: grid;
    width: 3.1rem;
    height: 3.1rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--accent) 38%, transparent);
    border-radius: 1rem;
    background:
      radial-gradient(circle at 32% 28%, color-mix(in srgb, var(--accent) 34%, transparent), transparent 56%),
      light-dark(rgb(99 76 44 / 0.04), rgb(255 255 255 / .04));
    color: light-dark(rgb(43 33 24 / 1), #fff4df);
    font-size: .72rem;
    font-weight: 950;
  }

  .weapon-group h2 {
    font-size: clamp(1.7rem, 2.35vw, 2.45rem);
  }

  .weapon-group header p:not(.eyebrow) {
    max-width: 74ch;
    margin: .72rem 0 0;
    color: light-dark(rgb(91 76 57 / 1), #e8decc);
    line-height: 1.7;
  }

  .weapon-table {
    display: grid;
    margin: 0 clamp(.7rem, 1.4vw, 1rem) clamp(.7rem, 1.4vw, 1rem);
    overflow: hidden;
    border: 1px solid light-dark(rgb(118 93 55 / 0.07), rgb(255 255 255 / .07));
    border-radius: 1rem;
    background: light-dark(rgb(247 240 226 / 0.45), rgb(1 6 9 / .45));
  }

  .table-row {
    display: grid;
    grid-template-columns: minmax(10rem, .9fr) minmax(10rem, .82fr) minmax(14rem, 1.2fr);
  }

  .table-row span {
    min-width: 0;
    border-right: 1px solid light-dark(rgb(118 93 55 / 0.07), rgb(255 255 255 / .07));
    border-bottom: 1px solid light-dark(rgb(118 93 55 / 0.07), rgb(255 255 255 / .07));
    padding: .9rem 1rem;
    color: light-dark(rgb(91 76 57 / 1), #e8decc);
    line-height: 1.45;
  }

  .table-row span:first-child {
    color: light-dark(rgb(43 33 24 / 1), #fff4df);
    font-weight: 850;
  }

  .table-row span:last-child {
    border-right: 0;
  }

  .table-row:last-child span {
    border-bottom: 0;
  }

  .table-head span {
    color: color-mix(in srgb, var(--accent) 72%, light-dark(rgb(43 33 24 / 1), #fff4df));
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    font-size: .64rem;
    font-weight: 950;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .next-panel {
    position: sticky;
    top: 6rem;
    align-self: start;
    overflow: hidden;
    padding: clamp(1.15rem, 2vw, 1.55rem);
  }

  .next-panel::before {
    display: block;
    height: 13rem;
    margin: calc(clamp(1.15rem, 2vw, 1.55rem) * -1) calc(clamp(1.15rem, 2vw, 1.55rem) * -1) 1.1rem;
    background:
      linear-gradient(180deg, transparent, light-dark(rgb(247 240 226 / 0.88), rgb(2 7 11 / .88))),
      var(--hero-image);
    background-position: center;
    background-size: cover;
    content: "";
  }

  .next-panel h2 {
    font-size: clamp(1.85rem, 2.5vw, 2.55rem);
  }

  .next-panel p {
    color: light-dark(rgb(91 76 57 / 1), #e8decc);
    line-height: 1.7;
  }

  .next-panel a {
    display: inline-flex;
    margin-top: .4rem;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: 999px;
    padding: .58rem .85rem;
    color: #05090a;
    background: linear-gradient(135deg, var(--accent), var(--warm));
    font-size: .7rem;
    font-weight: 950;
    letter-spacing: .1em;
    text-transform: uppercase;
    text-decoration: none;
  }

  @media (max-width: 1060px) {
    .hero-glass {
      width: auto;
      margin-top: clamp(11rem, 28svh, 18rem);
    }

    .weapon-progress,
    .weapon-layout {
      grid-template-columns: 1fr;
    }

    .progress-head {
      border-right: 0;
      border-bottom: 1px solid light-dark(rgb(118 93 55 / 0.1), rgb(255 255 255 / .1));
      padding-bottom: .65rem;
    }

    .next-panel {
      position: relative;
      top: auto;
    }
  }

  @media (max-width: 760px) {
    .weapon-page {
      padding-bottom: 6rem;
    }

    .weapon-hero,
    .weapon-progress,
    .weapon-layout {
      width: min(100% - 1rem, 1500px);
    }

    .weapon-hero {
      min-height: 40rem;
    }

    .hero-glass {
      margin: clamp(10rem, 28svh, 13rem) .7rem .7rem;
      padding: 1rem;
    }

    .hero-glass h1 {
      font-size: clamp(3rem, 15vw, 4.4rem);
    }

    .weapon-progress > div:last-child {
      display: flex;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .weapon-progress > div:last-child::-webkit-scrollbar {
      display: none;
    }

    .progress-item {
      min-width: 11rem;
    }

    .weapon-group header {
      grid-template-columns: 1fr;
    }

    .table-row {
      grid-template-columns: 1fr;
    }

    .table-head {
      display: none;
    }

    .table-row span {
      display: grid;
      grid-template-columns: minmax(7.2rem, .42fr) 1fr;
      gap: .75rem;
      border-right: 0;
    }

    .table-row span::before {
      color: color-mix(in srgb, var(--accent) 76%, light-dark(rgb(43 33 24 / 1), #fff4df));
      font-size: .62rem;
      font-weight: 950;
      letter-spacing: .1em;
      text-transform: uppercase;
      content: "Ayudha";
    }

    .table-row span:nth-child(2)::before {
      content: "Bearer";
    }

    .table-row span:nth-child(3)::before {
      content: "Symbolism";
    }
  }
</style>

---
import BaseLayout from "../../layouts/BaseLayout.astro";

const weaponJourneyItems = [
  {
    title: "Part I - Astras",
    href: "/astras/part-1",
    eyebrow: "Mantra weapons",
    description: "Weapons invoked through mantra, concentration, discipline, and divine authority.",
    status: "available",
  },
  {
    title: "Part II - Ayudhas",
    href: "/astras/part-2",
    eyebrow: "Divine weapons",
    description: "The eternal weapons carried by the gods, including the discus, trident, mace, bow, sword, and thunderbolt.",
    status: "available",
  },
  {
    title: "Part III - Epic Weapons",
    href: "/astras/part-3",
    eyebrow: "Hero weapons",
    description: "The legendary weapons of epic heroes, including Gandiva, Kodanda, Vijaya, and Chandrahasa.",
    status: "available",
  },
];

const weaponGroups = [
  {
    number: "01",
    title: "Supreme Cosmic Astras",
    note: "The highest class of Astras, associated with the supreme deities. These are capable of altering the course of great battles and are invoked only under exceptional circumstances.",
    columns: ["Astra", "Presiding Deity", "Famous Wielder(s)"],
    rows: [
      ["Brahmastra", "Brahma", "Rama, Arjuna, Karna, Ashwatthama"],
      ["Brahmashiras Astra", "Brahma", "Arjuna, Ashwatthama"],
      ["Pashupatastra", "Shiva", "Arjuna"],
      ["Narayanastra", "Vishnu (Narayana)", "Ashwatthama"],
      ["Vaishnavastra", "Vishnu", "Bhagadatta, Rama (traditions)"],
    ],
  },
  {
    number: "02",
    title: "Elemental Astras",
    note: "Astras that embody the fundamental forces of nature, allowing the wielder to invoke fire, water, wind, rain, earth, or celestial energies.",
    columns: ["Astra", "Element", "Famous Wielder(s)"],
    rows: [
      ["Agneyastra", "Fire", "Rama, Arjuna, Karna"],
      ["Varunastra", "Water", "Rama, Arjuna"],
      ["Vayavyastra", "Wind", "Arjuna"],
      ["Parjanyastra", "Rain", "Various sages and warriors"],
      ["Bhumiastra", "Earth", "Later traditions"],
      ["Saurastra", "Sun", "Various traditions"],
      ["Candrastra", "Moon", "Various traditions"],
    ],
  },
  {
    number: "03",
    title: "Serpent and Living Force Astras",
    note: "Weapons that invoke celestial serpents or other living divine forces. Some bind their targets, while others summon venomous or supernatural beings.",
    columns: ["Astra", "Primary Power", "Famous Wielder(s)"],
    rows: [
      ["Nagastra", "Serpent attack", "Karna, Indrajit"],
      ["Nagapasha", "Serpent binding", "Indrajit"],
      ["Garudastra", "Counters serpent weapons", "Rama, Arjuna"],
    ],
  },
  {
    number: "04",
    title: "Illusion and Mind Astras",
    note: "Rather than causing physical destruction, these Astras influence perception, awareness, memory, or consciousness.",
    columns: ["Astra", "Primary Effect", "Famous Wielder(s)"],
    rows: [
      ["Mohanastra", "Delusion", "Various warriors"],
      ["Sammohanastra", "Mass bewilderment", "Arjuna"],
      ["Pramohanastra", "Deep confusion", "Epic traditions"],
    ],
  },
  {
    number: "05",
    title: "Divine Warrior Astras",
    note: "These Astras are associated with specific deities, celestial beings, or legendary teachers. Each reflects the unique power or blessing of its divine source.",
    columns: ["Astra", "Associated With", "Famous Wielder(s)"],
    rows: [
      ["Aindrastra", "Indra", "Arjuna"],
      ["Indrastra", "Indra", "Rama, Arjuna"],
      ["Bhargavastra", "Parashurama", "Karna"],
      ["Tvastrastra", "Tvastr", "Epic traditions"],
      ["Shailastra", "Mountain Deities", "Various traditions"],
      ["Anjalikastra", "Divine blessing", "Arjuna"],
    ],
  },
  {
    number: "06",
    title: "Astras of Restraint and Binding",
    note: "Not all Astras were created to destroy. Some were intended to capture, restrain, immobilize, or subdue an opponent without causing immediate death.",
    columns: ["Astra", "Purpose", "Famous Wielder(s)"],
    rows: [
      ["Pashastra", "Binding", "Various traditions"],
      ["Nagapasha", "Serpent restraint", "Indrajit"],
      ["Dharmapasha", "Divine restraint", "Puranic traditions"],
    ],
  },
];
---
<BaseLayout title="Part I - Astras | Sanatana Path" description="A dedicated atlas page for Astras, the weapons of invocation awakened through mantra, concentration, and spiritual authority." image="/images/home/home-astras.webp" type="article">
  <article class="weapon-page">
    <section class="weapon-hero">
      <div class="hero-glass">
        <a class="back-link" href="/astras">Weapons overview</a>
        <p class="eyebrow">Atlas of Divine Weapons</p>
        <h1>Part I - Astras</h1>
        <strong>Weapons of Invocation</strong>
        <p>Astras are divine weapons invoked through mantra, concentration, and spiritual authority. Rather than being merely held in the hand, they are awakened through sacred knowledge and released by a qualified wielder.</p>
      </div>
    </section>

    <nav class="weapon-progress" aria-label="Sacred weapons part navigation">
      <div class="progress-head"><span>Part path</span><strong>Sacred Weapons</strong></div>
      <div>
        {weaponJourneyItems.map((item, index) => item.href ? (
          <a href={item.href} class:list={["progress-item", item.status === "planned" && "planned"]} title={item.description}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{item.title}</strong>
            <small>{item.status === "planned" ? "Planned" : item.eyebrow}</small>
          </a>
        ) : (
          <span class="progress-item planned" title={item.description}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{item.title}</strong>
            <small>Planned</small>
          </span>
        ))}
      </div>
    </nav>

    <div class="weapon-layout">
      <main class="weapon-groups">
        {weaponGroups.map((group) => (
          <section class="weapon-group">
            <header>
              <span>{group.number}</span>
              <div>
                <p class="eyebrow">Astra category</p>
                <h2>{group.title}</h2>
                <p>{group.note}</p>
              </div>
            </header>
            <div class="weapon-table" role="table" aria-label={group.title}>
              <div class="table-row table-head" role="row">
                {group.columns.map((column) => <span role="columnheader">{column}</span>)}
              </div>
              {group.rows.map((row) => (
                <div class="table-row" role="row">
                  {row.map((cell) => <span role="cell">{cell}</span>)}
                </div>
              ))}
            </div>
          </section>
        ))}
      </main>

      <aside class="next-panel">
        <p class="eyebrow">Continue to the next page</p>
        <h2>Part II - Ayudhas</h2>
        <p>While Astras were invoked through mantra and spiritual discipline, the gods themselves wielded another class of sacred weapons.</p>
        <p>These eternal weapons were known as Ayudhas.</p>
        <p>Unlike Astras, they were not summoned into action. They were the personal weapons of the deities, inseparable from their divine identities and symbolic of their cosmic roles.</p>
        <a href="/astras/part-2">Open Part II</a>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  :global(body:has(.weapon-page)) { background:#020d13; color:#fff4df; }
  :global(body:has(.weapon-page)::before) { display:none; }
  .weapon-page { min-height:100svh; padding-bottom:4rem; background:radial-gradient(circle at 78% 0%, rgb(255 122 79 / .14), transparent 28rem), linear-gradient(180deg,#020d13,#031519 54%,#020d13); }
  .weapon-hero { position:relative; width:min(1460px,calc(100% - 2rem)); min-height:clamp(27rem,54svh,36rem); margin:1.25rem auto 0; overflow:hidden; border:1px solid rgb(255 122 79 / .32); border-radius:1.15rem; background-image:linear-gradient(90deg,rgb(2 13 19 / .92),rgb(2 13 19 / .44) 46%,rgb(2 13 19 / .12)),url("/images/home/home-astras.webp"); background-position:center, right center; background-size:auto,auto 100%; background-repeat:no-repeat; box-shadow:inset 0 0 0 1px rgb(255 255 255 / .025),0 28px 90px rgb(0 0 0 / .3); }
  .weapon-hero::after { position:absolute; inset:0; background:linear-gradient(180deg,rgb(2 13 19 / .28),transparent 20%,transparent 74%,rgb(2 13 19 / .32)); content:""; pointer-events:none; }
  .hero-glass { position:relative; z-index:1; width:min(43rem,45%); margin:clamp(1.4rem,3vw,2.7rem); border:1px solid rgb(255 122 79 / .38); border-radius:1rem; padding:clamp(1.25rem,2.6vw,2rem); background:linear-gradient(145deg,rgb(3 13 20 / .58),rgb(3 13 20 / .26)),radial-gradient(circle at 16% 0%,rgb(255 122 79 / .18),transparent 52%); box-shadow:inset 0 1px rgb(255 255 255 / .08),0 24px 75px rgb(0 0 0 / .22); backdrop-filter:blur(22px) saturate(126%); }
  .back-link { display:inline-flex; width:fit-content; margin-bottom:clamp(1rem,2vw,1.5rem); border:1px solid rgb(255 122 79 / .34); border-radius:999px; padding:.5rem .72rem; background:rgb(3 13 20 / .38); color:#ff9b7d; font-size:.72rem; font-weight:850; text-decoration:none; backdrop-filter:blur(14px); }
  .eyebrow { margin:0 0 .6rem; color:#ff9b7d; font-size:.7rem; font-weight:900; letter-spacing:.16em; text-transform:uppercase; }
  h1,h2 { margin:0; color:#fff4df; font-family:var(--serif); font-weight:500; letter-spacing:0; line-height:.98; }
  .hero-glass h1 { max-width:9ch; font-size:clamp(3rem,5vw,5.4rem); }
  .hero-glass strong { display:block; margin-top:.65rem; color:#ffd3bf; font-size:clamp(1.05rem,1.5vw,1.3rem); }
  .hero-glass p:not(.eyebrow) { max-width:44rem; margin:1rem 0 0; color:#eee0ca; font-size:clamp(1rem,1.18vw,1.12rem); line-height:1.75; }
  .weapon-progress { display:grid; grid-template-columns:auto minmax(0,1fr); gap:.75rem; align-items:center; width:min(1460px,calc(100% - 2rem)); margin:clamp(1rem,2vw,1.35rem) auto 0; border:1px solid rgb(255 122 79 / .28); border-radius:1rem; padding:.72rem; background:linear-gradient(135deg,rgb(255 122 79 / .08),rgb(2 13 19 / .48)); box-shadow:inset 0 1px rgb(255 255 255 / .045),0 16px 38px rgb(0 0 0 / .18); }
  .progress-head { display:grid; min-width:9rem; border-right:1px solid rgb(255 122 79 / .22); padding:.15rem .95rem .15rem .35rem; }
  .progress-head span { color:#ff9b7d; font-size:.58rem; font-weight:900; letter-spacing:.13em; text-transform:uppercase; }
  .progress-head strong { margin-top:.12rem; color:#fff4df; font-family:var(--serif); font-size:1.05rem; font-weight:500; }
  .weapon-progress > div:last-child { display:flex; gap:.46rem; min-width:0; overflow-x:auto; scrollbar-width:none; }
  .weapon-progress > div:last-child::-webkit-scrollbar { display:none; }
  .progress-item { display:grid; min-width:10.7rem; grid-template-columns:auto 1fr; align-items:center; gap:.12rem .48rem; border:1px solid rgb(255 122 79 / .28); border-radius:999px; padding:.48rem .72rem .48rem .46rem; background:rgb(255 122 79 / .07); color:#fff4df; text-decoration:none; }
  .progress-item > span { display:grid; width:1.78rem; height:1.78rem; grid-row:1/3; place-items:center; border-radius:50%; background:rgb(255 122 79 / .16); color:#ffb194; font-size:.58rem; font-weight:900; }
  .progress-item strong,.progress-item small { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .progress-item strong { font-size:.73rem; font-weight:850; }
  .progress-item small { color:#cfa99b; font-size:.55rem; font-weight:850; text-transform:uppercase; }
  .progress-item.planned { opacity:.58; }
  .weapon-layout { display:grid; width:min(1460px,calc(100% - 2rem)); grid-template-columns:minmax(0,1fr) minmax(18rem,23rem); gap:clamp(1.25rem,3vw,2.5rem); margin:clamp(1.25rem,3vw,2rem) auto 0; }
  .weapon-groups { display:grid; gap:1rem; }
  .weapon-group,.next-panel { border:1px solid rgb(255 122 79 / .25); border-radius:1rem; background:linear-gradient(145deg,rgb(3 13 20 / .86),rgb(3 13 20 / .62)); box-shadow:inset 0 1px rgb(255 255 255 / .045),0 20px 60px rgb(0 0 0 / .18); }
  .weapon-group { overflow:hidden; }
  .weapon-group header { display:grid; grid-template-columns:auto 1fr; gap:1rem; padding:clamp(1rem,2vw,1.35rem); }
  .weapon-group header > span { display:grid; width:2.7rem; height:2.7rem; place-items:center; border:1px solid rgb(255 122 79 / .34); border-radius:50%; color:#ffb194; font-size:.72rem; font-weight:900; }
  .weapon-group h2 { font-size:clamp(1.6rem,2.4vw,2.35rem); }
  .weapon-group header p:not(.eyebrow) { max-width:70ch; margin:.65rem 0 0; color:#e8decc; line-height:1.75; }
  .weapon-table { display:grid; border-top:1px solid rgb(255 122 79 / .18); }
  .table-row { display:grid; grid-template-columns:minmax(10rem,.9fr) minmax(10rem,.8fr) minmax(14rem,1.2fr); }
  .table-row span { min-width:0; border-right:1px solid rgb(255 122 79 / .12); border-bottom:1px solid rgb(255 122 79 / .12); padding:.82rem .9rem; color:#e8decc; line-height:1.45; }
  .table-row span:last-child { border-right:0; }
  .table-head span { color:#ffb194; background:rgb(255 122 79 / .08); font-size:.64rem; font-weight:900; letter-spacing:.12em; text-transform:uppercase; }
  .next-panel { position:sticky; top:6rem; align-self:start; padding:clamp(1rem,2vw,1.35rem); background:linear-gradient(145deg,rgb(3 13 20 / .9),rgb(3 13 20 / .66)),radial-gradient(circle at 100% 0%,rgb(255 122 79 / .1),transparent 16rem); }
  .next-panel h2 { font-size:clamp(1.75rem,2.5vw,2.45rem); }
  .next-panel p { color:#e8decc; line-height:1.7; }
  .next-panel a { display:inline-flex; margin-top:.5rem; border:1px solid rgb(255 122 79 / .32); border-radius:999px; padding:.46rem .68rem; color:#ffb194; background:rgb(255 122 79 / .08); font-size:.68rem; font-weight:900; letter-spacing:.08em; text-transform:uppercase; text-decoration:none; }
  @media (max-width: 980px) { .hero-glass { width:auto; margin-top:clamp(10rem,28svh,16rem); } .weapon-hero { background-size:auto,cover; } .weapon-progress,.weapon-layout { grid-template-columns:1fr; } .progress-head { border-right:0; border-bottom:1px solid rgb(255 122 79 / .22); padding-bottom:.6rem; } .next-panel { position:static; } }
  @media (max-width: 720px) { .weapon-page { padding-bottom:6rem; } .weapon-hero,.weapon-progress,.weapon-layout { width:min(100% - 1rem,1460px); } .hero-glass { margin:clamp(8rem,24svh,12rem) .75rem .75rem; } .weapon-group header { grid-template-columns:1fr; } .table-row { grid-template-columns:1fr; } .table-head { display:none; } .table-row span { display:grid; grid-template-columns:minmax(7rem,.42fr) 1fr; gap:.75rem; border-right:0; } .table-row span::before { color:#ffb194; font-size:.62rem; font-weight:900; letter-spacing:.1em; text-transform:uppercase; content:"Astra"; } .table-row span:nth-child(2)::before { content:"Power"; } .table-row span:nth-child(3)::before { content:"Wielder(s)"; } }
</style>
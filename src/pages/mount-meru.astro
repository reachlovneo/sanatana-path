---
import BaseLayout from "../layouts/BaseLayout.astro";

const heroImage = "/images/home/mount-meru-hero.png";

const journeyItems = [
  { title: "The Fourteen Lokas", href: "/14-lokas", eyebrow: "Layered worlds", description: "The layered worlds of existence: seven higher Lokas, Bhuloka, and seven lower Lokas." },
  { title: "Mount Meru", href: "/mount-meru", eyebrow: "Cosmic axis", description: "The cosmic axis at the center of the universe, where Meru is introduced as the pillar of cosmic order." },
  { title: "The Sapta Dvipa", href: "/sapta-dvipa", eyebrow: "Seven continents", description: "The seven great continents of Puranic cosmic geography." },
  { title: "The Cosmic Oceans", href: "/cosmic-oceans", eyebrow: "Cosmic boundaries", description: "The seven oceans that separate the great Dvipas: salt, sugarcane juice, sura, ghee, curd, milk, and pure sweet water." },
  { title: "Higher Worlds", href: "/14-lokas#higher-worlds", eyebrow: "Upper realms", description: "Where sages, celestial beings, devas, and higher states of existence are described." },
  { title: "Lower Worlds", href: "/14-lokas#lower-worlds", eyebrow: "Hidden realms", description: "Mysterious realms beneath the Earth, associated with powerful beings, hidden cities, and treasures." },
];

const facts = ["Golden Mountain", "Jambudvipa", "Brahmapuri", "Ganga's four streams"];
const measurements = [
  { label: "Height above Earth", value: "84,000 yojanas" },
  { label: "Depth below Earth", value: "16,000 yojanas" },
  { label: "Width at summit", value: "32,000 yojanas" },
  { label: "Width at base", value: "16,000 yojanas" },
];
const faces = [
  { direction: "East", color: "White" },
  { direction: "South", color: "Golden-yellow" },
  { direction: "West", color: "Dark like rain clouds" },
  { direction: "North", color: "Red / crimson" },
];
const rivers = [
  { direction: "East", name: "Sita" },
  { direction: "South", name: "Alakananda" },
  { direction: "West", name: "Chakshu" },
  { direction: "North", name: "Bhadra" },
];

const sections = [
  { title: "Mount Meru - The Cosmic Axis of the Universe", id: "cosmic-axis", paragraphs: [
    "Imagine standing at the very center of the universe.",
    "Not the center of a galaxy.",
    "Not the center of a solar system.",
    "But the very point around which the entire cosmic world is organized.",
    "According to many Hindu scriptures, such a place exists.",
    "It is called Mount Meru.",
    "Unlike any mountain found on Earth, Meru is not simply a towering peak of rock and snow. It is described as the cosmic axis - the great pillar around which the worlds, continents, celestial bodies, and heavenly realms are arranged.",
    "If the Fourteen Lokas form the structure of the universe, then Mount Meru is its central pillar.",
    "Everything begins here.",
  ] },
  { title: "The Mountain at the Center", id: "mountain-center", paragraphs: [
    "The Bhagavata Purana describes Mount Meru as standing at the exact center of Jambudvipa, the innermost and most important of the Seven Continents.",
    "Its brilliance is unlike anything found in the earthly world.",
    "The scriptures compare its radiance to pure gold, causing it to shine with extraordinary splendor. Because of this luminous appearance, Meru is often called the Golden Mountain.",
    "But its importance is not merely its beauty.",
    "Meru is the cosmic landmark from which the geography of the universe unfolds.",
    "The great continents spread outward from it.",
    "The heavenly worlds rise above it.",
    "Even the movements of the Sun, Moon, and planets are described in relation to it.",
    "To the ancient sages, Meru was the universe's fixed point - a symbol of perfect balance amid the ever-changing cosmos.",
  ] },
  { title: "How Large Is Mount Meru?", id: "scale", paragraphs: [
    "The Puranas describe Meru on a scale far beyond ordinary human imagination.",
    "According to the Bhagavata Purana and the Vishnu Purana, Mount Meru rises 84,000 yojanas above the Earth.",
    "Its base extends 16,000 yojanas beneath the surface, anchoring it firmly within the cosmic world.",
    "The mountain is said to measure 32,000 yojanas across at its summit and 16,000 yojanas across at its base, giving it the appearance of an enormous inverted pyramid that widens toward the heavens.",
    "The exact length of a yojana varies among ancient Indian traditions, so modern scholars do not agree on a single conversion into kilometers.",
    "For this reason, many researchers emphasize the proportions described in the scriptures rather than assigning precise modern measurements.",
    "Regardless of the conversion used, the intended message is unmistakable.",
    "Mount Meru is not an ordinary mountain.",
    "Its dimensions belong to a cosmic universe rather than the physical landscape of Earth.",
  ] },
  { title: "A Mountain of Divine Splendor", id: "splendor", paragraphs: [
    "The scriptures describe Meru as dazzling in every direction.",
    "Its slopes are adorned with celestial forests.",
    "Magnificent rivers descend from its heights.",
    "Precious gems and radiant minerals illuminate its sides.",
    "The air is filled with fragrant blossoms that never fade.",
    "Birds with brilliant plumage sing continuously through its sacred groves.",
    "Unlike earthly mountains that endure storms and erosion, Meru remains eternally magnificent, untouched by decay.",
    "Its beauty reflects the divine order of creation itself.",
  ] },
  { title: "The Abode of the Gods", id: "abode-gods", paragraphs: [
    "Mount Meru is not an empty peak.",
    "It is alive with celestial activity.",
    "Near its summit stands the magnificent city of Brahmapuri, the residence of Brahma, the creator of the universe.",
    "The Bhagavata Purana describes Brahmapuri as an immense city adorned with extraordinary palaces and surrounded by the realms of the guardians of the eight directions.",
    "These divine protectors - known as the Lokapalas - watch over every quarter of the universe.",
    "Around Meru also dwell great sages, Siddhas, Gandharvas, Kinnaras, Yakshas, and countless celestial beings who participate in the maintenance of cosmic order.",
    "To the Puranas, Meru is not only a mountain.",
    "It is the meeting place of heaven and Earth.",
  ] },
  { title: "The Four Faces of Meru", id: "four-faces", paragraphs: [
    "One of the most beautiful descriptions found in the Puranas is that each side of Mount Meru possesses its own distinct appearance.",
    "The eastern face shines with a brilliant white radiance.",
    "The southern face glows with a golden-yellow hue.",
    "The western face reflects a deep, dark color, often compared with rain-filled clouds.",
    "The northern face displays a rich crimson or reddish brilliance.",
    "These colors symbolize harmony among the directions and express the mountain's extraordinary nature rather than the appearance of an ordinary geological formation.",
  ] },
  { title: "Four Rivers That Nourish the World", id: "four-rivers", paragraphs: [
    "From the summit of Mount Meru flows the sacred celestial river Ganga.",
    "After descending from the higher heavens, its waters reach the peak of Meru before dividing into four mighty streams.",
    "Each river flows toward one of the four cardinal directions.",
    "The eastern stream is known as Sita.",
    "The southern stream is Alakananda.",
    "The western stream is Chakshu.",
    "The northern stream is Bhadra.",
    "Together, these rivers nourish the lands surrounding Meru and become life-giving sources for the regions of Jambudvipa.",
    "The descent of the Ganga from the heavens to the cosmic mountain represents one of the most celebrated themes in Hindu sacred literature.",
  ] },
  { title: "Meru in Different Scriptures", id: "scriptures", paragraphs: [
    "Although nearly every major Purana places Mount Meru at the center of the cosmic world, individual texts emphasize different aspects.",
    "The Vishnu Purana focuses on its role in cosmic geography.",
    "The Bhagavata Purana provides the most detailed description of its dimensions, surrounding mountains, forests, rivers, and neighboring regions.",
    "The Mahabharata presents Meru as a sacred mountain revered by gods and sages.",
    "Other Puranas add further descriptions of its divine inhabitants, surrounding peaks, and spiritual significance.",
    "Together, these sources present a consistent picture.",
    "Meru is not simply a mountain.",
    "It is the cosmic center around which the universe is ordered.",
  ] },
  { title: "More Than a Mountain", id: "more-than-mountain", paragraphs: [
    "Many philosophers have also understood Mount Meru symbolically.",
    "To them, it represents stability within change.",
    "The unmoving center around which all existence revolves.",
    "The axis connecting the earthly realm with the divine.",
    "Whether approached as sacred cosmology, symbolic philosophy, or spiritual metaphor, Mount Meru occupies a unique place in Hindu thought.",
    "It reminds us that every great journey begins from a center.",
  ] },
  { title: "The Universe Expands", id: "universe-expands", paragraphs: [
    "Yet Mount Meru does not stand alone.",
    "Encircling it lies an immense continent known as Jambudvipa.",
    "Beyond Jambudvipa stretch six more colossal continents.",
    "Each is separated by an ocean unlike any found on Earth.",
    "Together they form one of the most extraordinary geographical visions ever described in ancient literature.",
    "Our journey now moves outward from the cosmic mountain to explore these remarkable lands - the Sapta Dvipa, the Seven Continents of the Hindu universe.",
  ] },
];

const references = [
  "Bhagavata Purana, Canto 5, Chapters 16-17.",
  "Vishnu Purana, Book II, Chapters 2-4.",
  "Mahabharata, Bhishma Parva.",
  "Matsya Purana, Cosmological Sections.",
  "Brahmanda Purana, Cosmography.",
];

const related = [
  { title: "The Fourteen Lokas", href: "/14-lokas", image: "/images/home/home-lokas.webp", eyebrow: "Layered worlds" },
  { title: "The Hindu Cosmic Universe", href: "/cosmic-universe", image: "/images/home/home-hero.webp", eyebrow: "Cosmic structure" },
  { title: "The Sapta Dvipa", href: "/sapta-dvipa", image: "/images/home/home-hero.png", eyebrow: "Seven continents" },
];
---
<BaseLayout title="Mount Meru - The Cosmic Axis of the Universe | Sanatana Path" description="According to many Hindu scriptures, Mount Meru is the cosmic axis: the great pillar around which the worlds, continents, celestial bodies, and heavenly realms are arranged." image={heroImage} type="article">
  <div data-reading-body class="meru-page">
    <section class="meru-hero">
      <div class="hero-copy">
        <a class="back-link" href="/">Home</a>
        <p class="eyebrow">Chapter 2</p>
        <h1>Mount Meru</h1>
        <p>According to many Hindu scriptures, Mount Meru is the cosmic axis: the great pillar around which the worlds, continents, celestial bodies, and heavenly realms are arranged.</p>
        <div class="fact-row" aria-label="Mount Meru quick orientation">{facts.map((fact) => <span>{fact}</span>)}</div>
      </div>
      <figure class="hero-visual">
        <img src={heroImage} alt="A golden Mount Meru rising through a cosmic universe with rivers, planets, and celestial light" loading="eager" decoding="async" />
        <figcaption><strong>Cosmic Axis</strong><span>Center of Jambudvipa</span></figcaption>
      </figure>
    </section>

    <nav class="journey-rail" aria-label="Cosmic universe journey navigation">
      <div class="journey-head"><span>Journey 2</span><strong>Cosmic Universe</strong></div>
      <div>{journeyItems.map((item, index) => <a href={item.href} title={item.description} class:list={[item.href === "/mount-meru" && "active"]}><span>{String(index + 1).padStart(2, "0")}</span><strong>{item.title}</strong><small>{item.eyebrow}</small></a>)}</div>
    </nav>
    <section class="meru-atlas" aria-labelledby="meru-atlas-title">
      <div class="atlas-intro">
        <p class="eyebrow">See the axis</p>
        <h2 id="meru-atlas-title">A golden center for the cosmic map.</h2>
        <p>Meru is shown as the fixed center: heavens above, Jambudvipa around it, sacred rivers descending, and the wider universe arranged in relation to its axis.</p>
      </div>
      <div class="axis-board image-map" aria-label="Mount Meru visual orientation">
        <img src={heroImage} alt="Mount Meru as a golden cosmic axis surrounded by celestial light" loading="lazy" decoding="async" />
        <div class="map-shade"></div>
        <div class="axis-label top">Higher worlds</div>
        <div class="axis-label center">Mount Meru</div>
        <div class="axis-label bottom">Jambudvipa</div>
        <div class="river-set" aria-label="Four rivers flowing from Meru">
          <span>Sita</span><span>Alakananda</span><span>Chakshu</span><span>Bhadra</span>
        </div>
      </div>
      <div class="atlas-notes">
        <div><p class="mini-eyebrow">Scale</p><div class="measurement-list">{measurements.map((item) => <span><b>{item.label}</b><em>{item.value}</em></span>)}</div></div>
        <div><p class="mini-eyebrow">Four faces</p><div class="mini-grid">{faces.map((item) => <span><b>{item.direction}</b><em>{item.color}</em></span>)}</div></div>
        <div><p class="mini-eyebrow">Four rivers</p><div class="mini-grid river-grid">{rivers.map((item) => <span><b>{item.name}</b><em>{item.direction}</em></span>)}</div></div>
      </div>
    </section>

    <section class="content-layout">
      <article class="reading-panel">
        {sections.map((section, index) => (
          <section id={section.id} class:list={[index === 0 && "opening-section"]}>
            <span class="section-number">{String(index + 1).padStart(2, "0")}</span>
            <h2>{section.title}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </section>
        ))}
        <section id="references" class="reference-section compact-reference">
          <details>
            <summary><span class="section-number">11</span><span><small>Optional source notes</small><strong>Scriptural References</strong><em>Primary texts for the Mount Meru chapter</em></span><b aria-hidden="true">+</b></summary>
            <ol class="reference-grid">{references.map((item, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><p>{item}</p></li>)}</ol>
          </details>
        </section>
      </article>

      <aside class="atlas-side" aria-label="Related journeys and reading aids">
        <div class="side-card jump-card">
          <p class="eyebrow">Jump inside</p>
          <a href="#cosmic-axis">Cosmic Axis</a><a href="#scale">Scale</a><a href="#abode-gods">Abode of the Gods</a><a href="#four-faces">Four Faces</a><a href="#four-rivers">Four Rivers</a><a href="#references">References</a>
        </div>
        <div class="side-card related-card">
          <p class="eyebrow">Related Screen</p>
          <h2>Continue through the atlas</h2>
          <div class="related-list">{related.map((item) => <a href={item.href} style={`--related-image:url('${item.image}')`}><span>{item.eyebrow}</span><strong>{item.title}</strong></a>)}</div>
        </div>
      </aside>
    </section>

    <section class="next-chapter" aria-labelledby="next-title">
      <div class="next-visual" aria-hidden="true"><img src="/images/home/home-hero.webp" alt="" loading="lazy" decoding="async" /></div>
      <div class="next-copy"><p class="eyebrow">Continue next</p><h2 id="next-title">The Sapta Dvipa</h2><p>From the golden center, move outward into the seven great continents arranged around Meru.</p></div>
      <a href="/sapta-dvipa">Chapter 3 -></a>
    </section>
  </div>
</BaseLayout>
<style>
  :global(body){background:light-dark(rgb(250 245 234 / 1), #001e1f)}.meru-page{--bg:#001e1f;--panel:rgba(3,16,20,.86);--line:light-dark(rgb(51 98 100 / 0.22), rgba(119,229,232,.22));--gold:light-dark(rgb(96 80 40 / 1), #e0b95d);--cream:light-dark(rgb(43 33 24 / 1), #fff4dd);--text:light-dark(rgb(91 76 57 / 1), #ded5c4);--muted:light-dark(rgb(91 76 57 / 1), #b9ad9b);--aqua:light-dark(rgb(55 105 104 / 1), #80f4f2);min-height:100vh;color:var(--text);padding:clamp(18px,3vw,48px);background:linear-gradient(rgba(224,185,93,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(224,185,93,.035) 1px,transparent 1px),radial-gradient(circle at 76% 0%,rgba(224,185,93,.14),transparent 34rem),radial-gradient(circle at 8% 24%,rgba(119,229,232,.1),transparent 28rem),var(--bg);background-size:88px 88px,88px 88px,auto,auto,auto}.eyebrow,.mini-eyebrow{margin:0;color:var(--aqua);font-family:var(--font-display);font-size:.82rem;font-weight:900;letter-spacing:.22em;text-transform:uppercase}.mini-eyebrow{color:var(--gold);margin-bottom:.8rem}.back-link,.next-chapter a,.jump-card a{display:inline-flex;align-items:center;justify-content:center;width:fit-content;color:var(--aqua);text-decoration:none;font-family:var(--font-display);font-weight:900;letter-spacing:.05em;border:1px solid light-dark(rgb(118 93 55 / 0.42), rgba(119,229,232,.42));border-radius:999px;background:light-dark(rgb(250 245 234 / 0.78), rgba(3,24,29,.78))}.back-link{padding:.82rem 1.2rem;color:light-dark(rgb(110 67 52 / 1), #ff9b78);border-color:light-dark(rgb(118 93 55 / 0.44), rgba(255,155,120,.44))}.meru-hero{display:grid;grid-template-columns:minmax(0,.92fr) minmax(420px,1.08fr);min-height:clamp(540px,72vh,760px);overflow:hidden;border:1px solid light-dark(rgb(118 93 55 / 0.38), rgba(224,185,93,.38));border-radius:28px;background:light-dark(rgb(247 240 226 / 0.82), rgba(0,10,14,.82));box-shadow:0 24px 80px light-dark(rgb(91 69 38 / 0.122), rgba(0,0,0,.35))}.hero-copy{position:relative;z-index:1;display:flex;flex-direction:column;justify-content:center;gap:1.15rem;padding:clamp(32px,5vw,72px);background:linear-gradient(90deg,light-dark(rgb(247 240 226 / 0.98), rgba(0,11,16,.98)) 0%,light-dark(rgb(247 240 226 / 0.94), rgba(0,16,20,.94)) 68%,light-dark(rgb(247 240 226 / 0.42), rgba(0,16,20,.42)) 100%),radial-gradient(circle at 88% 70%,rgba(224,185,93,.12),transparent 18rem)}.hero-copy h1{max-width:8ch;margin:0;color:var(--cream);font-family:var(--font-serif);font-size:clamp(4rem,8vw,8.6rem);line-height:.83;letter-spacing:0}.hero-copy>p:not(.eyebrow){max-width:58ch;margin:0;font-size:clamp(1.1rem,1.5vw,1.45rem);line-height:1.75}.fact-row{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:.4rem}.fact-row span{padding:.65rem .9rem;border:1px solid light-dark(rgb(118 93 55 / 0.42), rgba(224,185,93,.42));border-radius:999px;color:var(--cream);background:light-dark(rgb(250 245 234 / 0.68), rgba(10,22,26,.68));font-family:var(--font-display);font-size:.86rem;font-weight:900}.hero-visual{position:relative;min-height:100%;margin:0;overflow:hidden}.hero-visual:before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,light-dark(rgb(247 240 226 / 0.5), rgba(0,18,22,.5)),transparent 35%),linear-gradient(180deg,transparent 62%,light-dark(rgb(247 240 226 / 0.86), rgba(0,17,20,.86)));pointer-events:none}.hero-visual img{width:100%;height:100%;min-height:clamp(540px,72vh,760px);display:block;object-fit:cover;object-position:52% 50%;filter:saturate(1.05) contrast(1.04)}.hero-visual figcaption{position:absolute;z-index:2;right:clamp(18px,3vw,38px);bottom:clamp(18px,3vw,38px);display:grid;gap:.15rem;min-width:210px;padding:1.05rem 1.2rem;border:1px solid light-dark(rgb(118 93 55 / 0.46), rgba(224,185,93,.46));border-radius:18px;background:light-dark(rgb(247 240 226 / 0.66), rgba(2,14,18,.66));backdrop-filter:blur(16px)}.hero-visual figcaption strong{color:var(--cream);font-family:var(--font-serif);font-size:1.6rem}.hero-visual figcaption span{color:var(--muted);font-size:.95rem}
  .journey-rail{display:grid;grid-template-columns:220px minmax(0,1fr);gap:1.6rem;align-items:center;max-width:1180px;margin:clamp(20px,3vw,34px) auto;padding:1rem 1.2rem;border:1px solid light-dark(rgb(118 93 55 / 0.16), rgba(119,229,232,.16));border-radius:999px;background:light-dark(rgb(247 240 226 / 0.78), rgba(2,20,21,.78));overflow:hidden}.journey-head{display:grid;gap:.35rem;padding-left:.4rem}.journey-head span,.journey-rail small{color:var(--gold);font-family:var(--font-display);font-size:.76rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase}.journey-head strong{color:var(--cream);font-family:var(--font-serif);font-size:1.35rem}.journey-rail>div:last-child{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(150px,1fr);gap:1rem;overflow-x:auto;scrollbar-width:none}.journey-rail a{display:grid;grid-template-columns:auto 1fr;gap:0 .65rem;align-items:start;min-width:0;color:var(--muted);text-decoration:none}.journey-rail a span{color:var(--cream);font-family:var(--font-display);font-size:.76rem;font-weight:900}.journey-rail a strong{color:inherit;overflow:hidden;font-family:var(--font-display);font-size:.95rem;font-weight:900;text-overflow:ellipsis;white-space:nowrap}.journey-rail a small{grid-column:2;color:inherit}.journey-rail a.active,.journey-rail a:hover{color:var(--cream)}.meru-atlas,.content-layout,.next-chapter{max-width:1560px;margin:0 auto clamp(24px,4vw,56px)}.meru-atlas{display:grid;grid-template-columns:minmax(260px,.34fr) minmax(420px,.7fr) minmax(260px,.36fr);gap:clamp(16px,2vw,26px);align-items:stretch;padding:clamp(18px,2vw,26px);border:1px solid light-dark(rgb(118 93 55 / 0.24), rgba(119,229,232,.24));border-radius:26px;background:light-dark(rgb(247 240 226 / 0.66), rgba(2,18,22,.66))}.atlas-intro,.atlas-notes>div,.axis-board{border:1px solid light-dark(rgb(118 93 55 / 0.18), rgba(119,229,232,.18));border-radius:20px;background:light-dark(rgb(247 240 226 / 0.65), rgba(1,13,17,.65))}.atlas-intro{display:flex;flex-directio
---
import BaseLayout from "../layouts/BaseLayout.astro";
import { LIBRARY_CATEGORIES, LIBRARY_TOPIC_COUNT } from "../data/library";

const readyFirst = [...LIBRARY_CATEGORIES].sort((a, b) => Number(!a.href) - Number(!b.href));
const featured = readyFirst.filter((category) => category.featured).slice(0, 8);
const totalCategories = LIBRARY_CATEGORIES.length;
const tones = ["All", "Cosmos", "Scriptures", "Stories", "Sciences", "Mystery"];
---
<BaseLayout title="Library | Sanatana Path" description="A searchable Sanatana Dharma knowledge library organized by cosmic time, scriptures, deities, stories, places, sciences, rituals, and mysteries." image="/images/home/home-library.webp">
  <section class="library-page" data-library-page>
    <div class="library-hero">
      <div class="library-hero-copy reveal">
        <p class="eyebrow">Sanatana reading library</p>
        <h1>Find your next thread of knowledge.</h1>
        <p>Search the atlas by source, story, cosmic time, deity, place, practice, or mystery. Each result is designed to lead you into connected reading, not a flat archive.</p>
        <div class="library-search" role="search">
          <span aria-hidden="true">Search</span>
          <input data-library-search type="search" placeholder="Try yuga, loka, astra, Garuda Purana..." aria-label="Search the Sanatana Path library" />
          <kbd>/</kbd>
        </div>
      </div>
      <div class="library-hero-panel reveal reveal-delay-1">
        <div class="library-stats" aria-label="Library statistics">
          <span><strong>{totalCategories}</strong><small>Categories</small></span>
          <span><strong>{LIBRARY_TOPIC_COUNT}</strong><small>Seed topics</small></span>
          <span><strong>A-Z</strong><small>Expandable</small></span>
        </div>
        <div class="hero-reading-paths" aria-label="Quick reading paths">
          <button type="button" data-topic="Veda"><span>Source</span><strong>Begin with texts</strong><small>Vedas, Puranas, source families</small></button>
          <button type="button" data-topic="Yuga"><span>Time</span><strong>Trace cosmic cycles</strong><small>Yugas, Kalpas, Manvantaras</small></button>
          <button type="button" data-topic="Astra"><span>Mystery</span><strong>Explore hidden lore</strong><small>Astras, Vimanas, subtle worlds</small></button>
        </div>
      </div>
    </div>

    <div class="library-toolbar reveal reveal-delay-2">
      <div class="filter-tabs" aria-label="Library filters">
        {tones.map((filter, index) => <button class:list={{ active: index === 0 }} type="button" data-filter={filter.toLowerCase()}>{filter}</button>)}
      </div>
      <p data-result-count>Open paths first, coming soon after</p>
    </div>

    <section class="reading-room reveal reveal-delay-2" aria-labelledby="reading-room-title">
      <div class="reading-visual" aria-hidden="true">
        <div class="reader-lamp"></div>
        <div class="open-book">
          <span></span>
          <span></span>
          <i></i>
        </div>
        <div class="page-sparks"><span></span><span></span><span></span><span></span></div>
      </div>
      <div class="reading-copy">
        <p class="eyebrow">Reading table</p>
        <h2 id="reading-room-title">Enter by curiosity, continue by connection.</h2>
        <p>Pick a thread and the library will narrow around it, so reading feels like following a living path instead of opening a flat archive.</p>
      </div>
      <div class="reading-paths" aria-label="Suggested reading paths">
        <button type="button" data-topic="Cosmic Time"><span>01</span><strong>Time first</strong><small>Yugas, Kalpas, Manvantaras</small></button>
        <button type="button" data-topic="Garuda Purana"><span>02</span><strong>Story route</strong><small>Puranas, Itihasa, meaning</small></button>
        <button type="button" data-topic="Vimana"><span>03</span><strong>Mystery shelf</strong><small>Astras, Vimanas, hidden lore</small></button>
      </div>
    </section>
    <section class="featured-shelf" aria-labelledby="featured-library-title">
      <div class="section-heading">
        <p class="eyebrow">Start here</p>
        <h2 id="featured-library-title">Popular discovery paths</h2>
      </div>
      <div class="featured-strip">
        {featured.map((category) => category.href ? (
          <a class={`featured-card ${category.tone}`} href={category.href}>
            <img src={category.image} alt="" loading="lazy" decoding="async" />
            <span>{category.eyebrow}</span>
            <strong>{category.title}</strong>
            <em>Open</em>
          </a>
        ) : (
          <article class={`featured-card ${category.tone} coming-soon`} aria-label={`${category.title} coming soon`}>
            <img src={category.image} alt="" loading="lazy" decoding="async" />
            <span>{category.eyebrow}</span>
            <strong>{category.title}</strong>
            <em>Coming soon</em>
          </article>
        ))}
      </div>
    </section>

    <section class="library-grid" aria-label="Library categories">
      {readyFirst.map((category, index) => (
        <article
          id={category.id}
          class={`library-card ${category.tone}`}
          data-library-card
          data-title={category.title.toLowerCase()}
          data-topics={category.topics.join(" ").toLowerCase()}
          data-description={category.description.toLowerCase()}
          data-group={`${category.eyebrow} ${category.tone}`.toLowerCase()}
          style={`--delay:${Math.min(index, 12) * 34}ms`}
        >
          {category.href ? (
            <a class="card-image" href={category.href} aria-label={category.title}>
              <img src={category.image} alt="" loading="lazy" decoding="async" />
              <span>{category.eyebrow}</span>
            </a>
          ) : (
            <div class="card-image coming-soon" aria-label={`${category.title} coming soon`}>
              <img src={category.image} alt="" loading="lazy" decoding="async" />
              <span>{category.eyebrow}</span>
              <em>Coming soon</em>
            </div>
          )}
          <div class="card-copy">
            <div>
              <h2>{category.title}</h2>
              <p>{category.description}</p>
            </div>
            <div class="topic-cloud" aria-label={`${category.title} topics`}>
              {category.topics.slice(0, 10).map((topic) => <button type="button" data-topic={topic}>{topic}</button>)}
              {category.topics.slice(10).map((topic) => <button class="is-extra" type="button" data-topic={topic} data-extra-topic hidden>{topic}</button>)}
              {category.topics.length > 10 && <button class="more-topics" type="button" data-expand-topics aria-expanded="false">+{category.topics.length - 10} more</button>}
            </div>
            {category.href ? <a class="library-card-link" href={category.href}>Open <span aria-hidden="true">-&gt;</span></a> : <span class="library-card-link coming-soon-link">Coming soon</span>}
          </div>
        </article>
      ))}
    </section>

    <div class="empty-state" data-empty-state hidden>
      <p class="eyebrow">No match yet</p>
      <h2>Try a broader search.</h2>
      <p>Search for a topic family like "Yuga", "Veda", "Loka", "Astra", "Rishi", "Temple", or "Garuda".</p>
    </div>
  </section>
  <script is:inline>
  function initLibrarySearch() {
    const page = document.querySelector("[data-library-page]");
    if (!page || page.dataset.libraryReady === "true") return;
    page.dataset.libraryReady = "true";

    const search = page.querySelector("[data-library-search]");
    if (!(search instanceof HTMLInputElement)) return;

    const cards = [...page.querySelectorAll("[data-library-card]")];
    const count = page.querySelector("[data-result-count]");
    const empty = page.querySelector("[data-empty-state]");
    const filters = [...page.querySelectorAll("[data-filter]")];
    let activeFilter = "all";

    const groupMap = {
      cosmos: ["cosmic", "loka", "realms", "worlds", "time", "geography"],
      scriptures: ["scripture", "veda", "upanishad", "purana", "texts", "philosophy"],
      stories: ["itihasa", "epics", "stories", "kingdom", "dynasties", "wars", "events"],
      sciences: ["science", "yoga", "ayurveda", "astrology", "mantra", "temple", "ritual"],
      mystery: ["mystery", "hidden", "vimana", "astras", "creatures", "afterlife", "siddhis"],
    };

    const getHaystack = (card) => `${card.dataset.title || ""} ${card.dataset.topics || ""} ${card.dataset.description || ""} ${card.dataset.group || ""}`;
    const matchesFilter = (card) => activeFilter === "all" || groupMap[activeFilter]?.some((term) => getHaystack(card).includes(term));
    const update = () => {
      const query = search.value.trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const isVisible = (!query || getHaystack(card).includes(query)) && matchesFilter(card);
        card.hidden = !isVisible;
        if (isVisible) visible += 1;
      });
      if (count) count.textContent = `${visible} categor${visible === 1 ? "y" : "ies"} shown`;
      if (empty instanceof HTMLElement) empty.hidden = visible !== 0;
    };

    search.addEventListener("input", update);
    filters.forEach((button) => button.addEventListener("click", () => {
      activeFilter = button.dataset.filter || "all";
      filters.forEach((item) => item.classList.toggle("active", item === button));
      update();
    }));
    page.querySelectorAll("[data-expand-topics]").forEach((button) => button.addEventListener("click", () => {
      const cloud = button.closest(".topic-cloud");
      if (!cloud) return;
      const expanded = button.getAttribute("aria-expanded") === "true";
      cloud.querySelectorAll("[data-extra-topic]").forEach((topic) => { topic.hidden = expanded; });
      if (!button.dataset.collapsedLabel) button.dataset.collapsedLabel = button.textContent || "More";
      button.setAttribute("aria-expanded", String(!expanded));
      button.textContent = expanded ? button.dataset.collapsedLabel : "Show less";
    }));
    const atlasTopicRoutes = {
      "cosmic time": "/atlas#cosmic-time",
      "kalpa": "/atlas#kalpa",
      "manvantara": "/atlas#manvantara",
      "mahayuga": "/atlas#maha-yuga",
      "maha yuga": "/atlas#maha-yuga",
      "four yugas": "/atlas#four-yugas",
      "yugas": "/atlas#four-yugas",
      "kali yuga": "/atlas#kali-yuga",
      "satya yuga": "/atlas/satya-yuga",
      "treta yuga": "/atlas/treta-yuga",
      "garuda purana": "/atlas/garuda-purana",
      "afterlife": "/atlas/garuda-purana",
      "14 lokas": "/14-lokas",
      "lokas": "/14-lokas",
      "mount meru": "/mount-meru",
      "sapta dvipas": "/sapta-dvipa",
      "sapta dvipa": "/sapta-dvipa",
      "cosmic oceans": "/cosmic-oceans",
      "pushpaka vimana": "/pushpaka-vimana",
      "vimana": "/pushpaka-vimana",
      "vimanas": "/pushpaka-vimana",
      "tripura": "/flying-cities-of-tripura",
      "tripura flying cities": "/flying-cities-of-tripura",
      "astras": "/astras",
      "brahmastra": "/astras"
    };

    page.querySelectorAll("[data-topic]").forEach((button) => button.addEventListener("click", () => {
      const topic = button.dataset.topic || "";
      const route = atlasTopicRoutes[topic.trim().toLowerCase()];
      if (route) {
        window.location.href = route;
        return;
      }
      search.value = topic;
      search.focus();
      update();
      page.scrollIntoView({ behavior: "smooth", block: "start" });
    }));
    window.addEventListener("keydown", (event) => {
      if (event.key === "/" && document.activeElement !== search) {
        event.preventDefault();
        search.focus();
      }
    });

    update();
  }

  initLibrarySearch();
  document.addEventListener("astro:page-load", initLibrarySearch);
  </script>
</BaseLayout>

<style>
  :global(body:has(.library-page)) {
    background: #020a10;
    color: #f7ebd3;
  }

  :global(body:has(.library-page)::before) {
    display: none;
  }

  .library-page {
    min-height: 100svh;
    padding: clamp(1.2rem, 2vw, 2rem) 0 4rem;
    background:
      radial-gradient(circle at 72% 0%, rgb(214 172 91 / .16), transparent 30rem),
      radial-gradient(circle at 12% 28%, rgb(101 215 220 / .08), transparent 28rem),
      linear-gradient(180deg, #020a10, #031116 52%, #020a10);
  }

  .library-page::before {
    position: fixed;
    inset: 0;
    z-index: 0;
    background-image: radial-gradient(circle, rgb(214 172 91 / .18) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: linear-gradient(to bottom, black, transparent 72%);
    pointer-events: none;
    content: "";
  }

  .library-hero,
  .library-toolbar,
  .featured-shelf,
  .reading-room,
  .library-grid,
  .empty-state {
    position: relative;
    z-index: 1;
    width: min(1540px, calc(100% - 2rem));
    margin-inline: auto;
  }

  .library-hero {
    display: grid;
    grid-template-columns: minmax(24rem, .72fr) minmax(34rem, 1fr);
    gap: clamp(1.25rem, 3.4vw, 4rem);
    align-items: center;
    padding: clamp(1.2rem, 3vw, 3.25rem) 0 clamp(1rem, 2vw, 1.8rem);
  }

  .library-hero-copy h1,
  .section-heading h2,
  .empty-state h2 {
    margin: .55rem 0 0;
    color: #fff2da;
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 450;
    letter-spacing: 0;
  }

  .library-hero-copy h1 {
    max-width: 12ch;
    font-size: clamp(3.25rem, 5.6vw, 5.9rem);
    line-height: .92;
  }

  .section-heading h2,
  .empty-state h2 { line-height: .9; }
  .library-hero-copy > p:not(.eyebrow) { max-width: 46rem; color: #d0c2ad; font-size: clamp(1rem, 1.15vw, 1.14rem); line-height: 1.72; }

  .library-search {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: .85rem;
    width: min(100%, 46rem);
    min-height: 4.35rem;
    margin-top: 1.55rem;
    border: 1px solid rgb(244 195 109 / .32);
    border-radius: 1.2rem;
    padding: .7rem .85rem .7rem 1rem;
    background:
      linear-gradient(135deg, rgb(255 255 255 / .09), rgb(2 10 16 / .62)),
      radial-gradient(circle at 8% 50%, rgb(244 195 109 / .18), transparent 12rem);
    box-shadow: inset 0 1px rgb(255 255 255 / .08), 0 22px 65px rgb(0 0 0 / .25), 0 0 40px rgb(244 195 109 / .06);
    backdrop-filter: blur(20px);
  }

  .library-search span { color: #f4c36d; font-size: 1.15rem; font-weight: 900; letter-spacing: .12em; }
  .library-search input { width: 100%; border: 0; outline: 0; background: transparent; color: #fff4dc; font: inherit; font-size: 1.05rem; }
  .library-search input::placeholder { color: rgb(201 185 157 / .68); }
  .library-search kbd { border: 1px solid rgb(214 172 91 / .22); border-radius: .55rem; padding: .14rem .5rem; color: #c9b99d; font: inherit; }

  .library-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .65rem;
    width: min(100%, 38rem);
    margin-top: .85rem;
  }

  .library-stats span {
    border: 1px solid rgb(214 172 91 / .14);
    border-radius: .9rem;
    padding: .72rem .8rem;
    background: linear-gradient(145deg, rgb(255 255 255 / .04), rgb(2 10 16 / .24));
  }

  .library-stats strong,
  .library-stats small { display: block; }
  .library-stats strong { color: #f4d19a; font-family: Georgia, "Times New Roman", serif; font-size: 1.35rem; line-height: 1; }
  .library-stats small { margin-top: .22rem; color: #9f9688; font-size: .62rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .hero-reading-paths {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .65rem;
    width: min(100%, 46rem);
    margin-top: .85rem;
  }

  .hero-reading-paths button {
    min-height: 5.25rem;
    border: 1px solid rgb(214 172 91 / .16);
    border-radius: 1rem;
    padding: .75rem .85rem;
    background: linear-gradient(145deg, rgb(255 255 255 / .055), rgb(2 10 16 / .42));
    color: #f7ebd3;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: transform 200ms ease, border-color 200ms ease, background 200ms ease, box-shadow 200ms ease;
  }

  .hero-reading-paths button:hover {
    transform: translateY(-3px);
    border-color: rgb(244 195 109 / .42);
    background: linear-gradient(145deg, rgb(244 195 109 / .12), rgb(2 10 16 / .52));
    box-shadow: 0 16px 40px rgb(0 0 0 / .24);
  }

  .hero-reading-paths span,
  .hero-reading-paths strong { display: block; }
  .hero-reading-paths span { color: #f4c36d; font-size: .62rem; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; }
  .hero-reading-paths strong { margin-top: .72rem; color: #fff2da; font-family: Georgia, "Times New Roman", serif; font-size: 1.02rem; line-height: 1.05; }

  .library-hero-art {
    position: relative;
    min-height: clamp(28rem, 52svh, 38rem);
    overflow: hidden;
    border: 1px solid rgb(214 172 91 / .22);
    border-radius: 1.65rem;
    background: #061017;
    box-shadow: inset 0 1px rgb(255 255 255 / .06), 0 34px 110px rgb(0 0 0 / .34);
    isolation: isolate;
  }

  .library-hero-art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: .78;
    filter: saturate(1.12) contrast(1.08) brightness(.9);
    transform: scale(1.02);
  }

  .library-hero-art::before {
    position: absolute;
    inset: 1.1rem;
    z-index: 2;
    border: 1px solid rgb(244 195 109 / .14);
    border-radius: 1.1rem;
    pointer-events: none;
    content: "";
  }

  .library-hero-art::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(circle at 58% 48%, transparent 0 16%, rgb(2 10 16 / .2) 46%, rgb(2 10 16 / .78)),
      linear-gradient(90deg, rgb(2 10 16 / .76), transparent 42%, rgb(2 10 16 / .35));
    content: "";
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: 2;
    background-image: linear-gradient(90deg, rgb(244 195 109 / .08) 1px, transparent 1px), linear-gradient(180deg, rgb(244 195 109 / .06) 1px, transparent 1px);
    background-size: 7.5rem 7.5rem;
    mask-image: radial-gradient(circle at 62% 52%, black, transparent 70%);
    pointer-events: none;
  }

  .catalog-card {
    position: absolute;
    left: clamp(1.25rem, 3vw, 2.4rem);
    bottom: clamp(1.25rem, 3vw, 2.4rem);
    z-index: 4;
    width: min(25rem, calc(100% - 3rem));
    border: 1px solid rgb(244 195 109 / .22);
    border-radius: 1.15rem;
    padding: 1rem;
    background: linear-gradient(135deg, rgb(2 10 16 / .72), rgb(10 25 31 / .5));
    box-shadow: inset 0 1px rgb(255 255 255 / .08), 0 18px 54px rgb(0 0 0 / .34);
    backdrop-filter: blur(18px);
  }

  .catalog-card span {
    color: #f4c36d;
    font-size: .64rem;
    font-weight: 900;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .catalog-card strong {
    display: block;
    margin-top: .35rem;
    color: #fff2da;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.75rem;
    line-height: 1;
  }

  .catalog-card p {
    margin: .48rem 0 0;
    color: #c9b99d;
    font-size: .82rem;
    line-height: 1.5;
  }

  .shelf-stack {
    position: absolute;
    top: clamp(1.4rem, 3vw, 2.8rem);
    right: clamp(1.4rem, 3vw, 2.8rem);
    z-index: 4;
    display: grid;
    gap: .55rem;
    width: min(15rem, 34%);
  }

  .shelf-stack span {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .8rem;
    border: 1px solid rgb(214 172 91 / .18);
    border-radius: .85rem;
    padding: .65rem .75rem;
    background: rgb(2 10 16 / .58);
    color: #f7ebd3;
    box-shadow: 0 12px 34px rgb(0 0 0 / .22);
    backdrop-filter: blur(12px);
    font-size: .72rem;
    font-weight: 850;
  }

  .shelf-stack b { color: #f4c36d; font-size: .62rem; letter-spacing: .08em; }

  .library-orbit { position: absolute; inset: 8%; z-index: 2; display: grid; place-items: center; }
  .library-orbit span { position: absolute; border: 1px solid rgb(244 195 109 / .22); border-radius: 50%; transform: rotate(-12deg) scaleY(.56); animation: library-orbit 28s linear infinite; }
  .library-orbit span:nth-child(1) { width: 84%; aspect-ratio: 1; }
  .library-orbit span:nth-child(2) { width: 62%; aspect-ratio: 1; border-color: rgb(101 215 220 / .22); animation-duration: 36s; animation-direction: reverse; }
  .library-orbit span:nth-child(3) { width: 102%; aspect-ratio: 1; border-style: dashed; opacity: .7; animation-duration: 48s; }

  .hero-node {
    position: absolute;
    z-index: 3;
    border: 1px solid color-mix(in srgb, var(--node-color, #f4c36d) 42%, transparent);
    border-radius: 999px;
    padding: .42rem .65rem;
    background: rgb(2 10 16 / .62);
    color: color-mix(in srgb, var(--node-color, #f4c36d) 80%, #fff2d4);
    box-shadow: 0 0 28px color-mix(in srgb, var(--node-color, #f4c36d) 20%, transparent);
    backdrop-filter: blur(12px);
    font-size: .64rem;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
    animation: float-node 5s ease-in-out infinite;
  }

  .hero-node.gold { --node-color: #f4c36d; }
  .hero-node.teal { --node-color: #65d7dc; }
  .hero-node.amber { --node-color: #ffbf73; }
  .hero-node.violet { --node-color: #c89bff; }
  .hero-node.fire { --node-color: #ff7a4f; }
  .hero-node.blue { --node-color: #85a8ff; }
  .hero-node.shadow { --node-color: #dcc49d; }
  .node-1 { top: 18%; left: 43%; }
  .node-2 { top: 36%; right: 13%; animation-delay: .4s; }
  .node-3 { bottom: 19%; right: 18%; animation-delay: .8s; }
  .node-4 { bottom: 22%; left: 16%; animation-delay: 1.2s; }
  .node-5 { top: 26%; left: 12%; animation-delay: 1.6s; }

  .library-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
    border: 1px solid rgb(214 172 91 / .16);
    border-radius: 1rem;
    padding: .65rem;
    background: linear-gradient(135deg, rgb(255 255 255 / .04), rgb(2 10 16 / .46));
  }

  .filter-tabs { display: flex; flex-wrap: wrap; gap: .45rem; }
  .filter-tabs button {
    border: 1px solid rgb(214 172 91 / .16);
    border-radius: 999px;
    padding: .48rem .74rem;
    background: transparent;
    color: #c9b99d;
    font: inherit;
    font-size: .72rem;
    font-weight: 850;
    cursor: pointer;
    transition: transform 180ms ease, color 180ms ease, background 180ms ease, border-color 180ms ease;
  }
  .filter-tabs button.active,
  .filter-tabs button:hover { transform: translateY(-1px); border-color: rgb(244 195 109 / .5); background: rgb(244 195 109 / .1); color: #fff2d4; }

  .gold { --node-color: light-dark(rgb(105 84 47 / 1), #f4c36d); } .teal { --node-color: light-dark(rgb(43 92 95 / 1), #65d7dc); } .amber { --node-color: light-dark(rgb(110 82 49 / 1), #ffbf73); } .violet { --node-color: light-dark(rgb(86 67 110 / 1), #c89bff); } .fire { --node-color: light-dark(rgb(110 52 34 / 1), #ff7a4f); } .blue { --node-color: light-dark(rgb(57 72 110 / 1), #85a8ff); } .shadow { --node-color: light-dark(rgb(91 76 57 / 1), #dcc49d); }

  .library-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: .95rem;
    margin-top: 1.8rem;
  }

  .library-card {
    display: grid;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--node-color, light-dark(rgb(118 93 55 / 1), #d6ac5b)) 22%, light-dark(rgb(118 93 55 / 0.08), rgb(255 255 255 / .08)));
    border-radius: 1rem;
    background: linear-gradient(145deg, light-dark(rgb(99 76 44 / 0.045), rgb(255 255 255 / .045)), light-dark(rgb(247 240 226 / 0.52), rgb(2 10 16 / .52)));
    box-shadow: inset 0 1px rgb(255 255 255 / .04), 0 18px 50px light-dark(rgb(91 69 38 / 0.063), rgb(0 0 0 / .18));
    animation: card-in 620ms cubic-bezier(.22, 1, .36, 1) both;
    animation-delay: var(--delay);
  }

  .library-card[hidden] { display: none; }
  .card-image { position: relative; min-height: 11.8rem; overflow: hidden; }
  .card-image img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: saturate(1.1) contrast(1.06) brightness(.8); transition: transform 560ms ease; }
  .card-image::after { position: absolute; inset: 0; background: linear-gradient(180deg, light-dark(rgb(247 240 226 / 0.08), rgb(2 10 16 / .08)), light-dark(rgb(247 240 226 / 0.76), rgb(2 10 16 / .76))); content: ""; }
  .card-image span { position: absolute; left: .8rem; bottom: .8rem; z-index: 1; border: 1px solid color-mix(in srgb, var(--node-color, light-dark(rgb(118 93 55 / 1), #d6ac5b)) 42%, transparent); border-radius: 999px; padding: .34rem .6rem; background: light-dark(rgb(247 240 226 / 0.62), rgb(2 10 16 / .62)); color: color-mix(in srgb, var(--node-color, light-dark(rgb(92 74 39 / 1), #d6ac5b)) 78%, light-dark(rgb(43 33 24 / 1), #fff2d4)); font-size: .62rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; backdrop-filter: blur(10px); }
  .card-image em { position: absolute; top: .75rem; right: .75rem; z-index: 1; border: 1px solid color-mix(in srgb, var(--node-color, light-dark(rgb(118 93 55 / 1), #d6ac5b)) 38%, transparent); border-radius: 999px; padding: .34rem .58rem; background: light-dark(rgb(247 240 226 / 0.68), rgb(2 10 16 / .68)); color: color-mix(in srgb, var(--node-color, light-dark(rgb(92 74 39 / 1), #d6ac5b)) 78%, light-dark(rgb(43 33 24 / 1), #fff2d4)); font-size: .58rem; font-style: normal; font-weight: 900; letter-spacing: .09em; text-transform: uppercase; backdrop-filter: blur(10px); }
  .card-image.coming-soon img { filter: saturate(.82) contrast(1.02) brightness(.66); }
  .library-card:hover .card-image img { transform: scale(1.06); }
  .library-card:hover .card-image.coming-soon img { transform: none; }

  .card-copy { display: grid; gap: 1rem; padding: .9rem; }
  .card-copy h2 { margin: 0; color: light-dark(rgb(43 33 24 / 1), #fff1d8); font-family: Georgia, "Times New Roman", serif; font-size: 1.35rem; line-height: 1.05; }
  .card-copy p { margin: .45rem 0 0; color: light-dark(rgb(91 76 57 / 1), #b9ad9b); font-size: .84rem; line-height: 1.45; }

  .topic-cloud { display: flex; flex-wrap: wrap; gap: .38rem; }

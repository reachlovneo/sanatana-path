    gap: .38rem;
    border: 1px solid color-mix(in srgb, var(--node-color, light-dark(rgb(118 93 55 / 1), #d6ac5b)) 22%, light-dark(rgb(118 93 55 / 0.08), rgb(255 255 255 / .08)));
    border-radius: 999px;

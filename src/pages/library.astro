  .open-book span::before { position: absolute; inset: .75rem .9rem; border-top: 1px solid rgb(2 10 16 / .2); border-bottom: 1px solid rgb(2 10 16 / .16); content: ""; opacity: .75; }
  .open-book span::after { position: absolute; inset: 1.9rem 1.1rem auto; height: 1px; background: light-dark(rgb(247 240 226 / 0.18), rgb(2 10 16 / .18)); box-shadow: 0 1.1rem light-dark(rgb(91 69 38 / 0.049), rgb(2 10 16 / .14)); content: ""; }

  .open-book i {

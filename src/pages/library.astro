    background: color-mix(in srgb, var(--node-color, #d6ac5b) 9%, light-dark(rgb(247 240 226 / 0.3), rgb(2 10 16 / .3)));
    color: color-mix(in srgb, var(--node-color, light-dark(rgb(92 74 39 / 1), #d6ac5b)) 80%, light-dark(rgb(43 33 24 / 1), #fff2d4));

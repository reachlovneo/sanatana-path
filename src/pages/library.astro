---
import BaseLayout from "../layouts/BaseLayout.astro";
import { LIBRARY_CATEGORIES } from "../data/library";

import { getTopicHref, TOPIC_ROUTES } from "../data/libraryRoutes";
import CategoryCard from "../components/library/CategoryCard.astro";
const getReadyTopicCount = (category: (typeof LIBRARY_CATEGORIES)[number]) => category.topics.filter((topic) => getTopicHref(topic)).length;
const availabilitySorted = [...LIBRARY_CATEGORIES].sort((a, b) => {
  const readyDifference = getReadyTopicCount(b) - getReadyTopicCount(a);
  if (readyDifference !== 0) return readyDifference;
  const categoryReadyDifference = Number(Boolean(b.href)) - Number(Boolean(a.href));
  if (categoryReadyDifference !== 0) return categoryReadyDifference;
  const featuredDifference = Number(Boolean(b.featured)) - Number(Boolean(a.featured));
  if (featuredDifference !== 0) return featuredDifference;
  return a.title.localeCompare(b.title);
});
const availableCategories = availabilitySorted.filter(category => category.href || getReadyTopicCount(category));
const plannedCategories = availabilitySorted.filter(category => !category.href && !getReadyTopicCount(category));
const readableGuides = new Set([...Object.values(TOPIC_ROUTES), ...LIBRARY_CATEGORIES.flatMap(c => c.href ? [c.href] : [])].map(href => href.split("#")[0])).size;
const featured = availableCategories.filter(category => category.featured && category.href).slice(0, 4);
const tones = ["All", "Cosmos", "Scriptures", "Stories", "Sciences", "Mystery"];
---
<BaseLayout title="Library | Sanatana Path" description="A searchable Sanatana Dharma knowledge library organized by cosmic time, scriptures, deities, stories, places, sciences, rituals, and mysteries." image="/images/home/home-library.webp">
  <section class="library-page" data-library-page>
    <div class="library-hero">
      <div class="library-hero-copy reveal">
        <p class="eyebrow">Sanatana reading library</p>
        <h1>Find your next read.</h1>
        <p>Explore the guides available now. Search a topic or choose a subject; future additions are listed separately below.</p>
        <div class="library-search" role="search">
          <span aria-hidden="true">Search</span>
          <input data-library-search type="search" placeholder="Try yuga, loka, astra, Garuda Purana..." aria-label="Search the Sanatana Path library" />
          <kbd>/</kbd>
        </div>
      </div>
    </div>
    <p class="availability-summary">{readableGuides} reading guides across {availableCategories.length} topic categories. <a href="#planned-library">See future additions</a></p>

    <div class="library-toolbar reveal reveal-delay-2">
      <div class="filter-tabs" aria-label="Library filters">
        {tones.map((filter, index) => <button class:list={{ active: index === 0 }} type="button" aria-pressed={index === 0 ? "true" : "false"} data-filter={filter.toLowerCase()}>{filter}</button>)}
      </div>
      <p data-result-count role="status" aria-live="polite">Available reading first</p>
    </div>

    <section class="library-grid" aria-label="Available reading categories">
      {availableCategories.map(category => <CategoryCard category={category} />)}
    </section>
    <details class="planned-library surface" id="planned-library" data-planned-library>
      <summary>Future additions <span>{plannedCategories.length} categories in planning</span></summary>
      <p>These categories describe the direction of the library. They do not yet have readable guides.</p>
      <div class="library-grid">{plannedCategories.map(category => <CategoryCard category={category} />)}</div>
    </details>

    <section class="featured-shelf" aria-labelledby="featured-library-title">
      <div class="section-heading">
        <p class="eyebrow">Start here</p>
        <h2 id="featured-library-title">Popular discovery paths</h2>
      </div>
      <div class="featured-strip">
        {featured.map((category) => category.href ? (
          <a class={`featured-card ${category.tone}`} href={category.href}>
            <img src={category.image} alt="" loading="lazy" decoding="async" />
            <span>{category.eyebrow}</span>
            <strong>{category.title}</strong>
            <em>Open</em>
          </a>
        ) : (
          <article class={`featured-card ${category.tone} coming-soon`} aria-label={`${category.title} coming soon`}>
            <img src={category.image} alt="" loading="lazy" decoding="async" />
            <span>{category.eyebrow}</span>
            <strong>{category.title}</strong>
            <em>Coming soon</em>
          </article>
        ))}
      </div>
    </section>

    <div class="empty-state" data-empty-state hidden>
      <p class="eyebrow">No match yet</p>
      <h2>Try a broader search.</h2>
      <p>Search for a topic family like "Yuga", "Veda", "Loka", "Astra", "Rishi", "Temple", or "Garuda".</p>
    </div>
  </section>
  <script is:inline>
  function initLibrarySearch() {
    const page = document.querySelector("[data-library-page]");
    if (!page || page.dataset.libraryReady === "true") return;
    page.dataset.libraryReady = "true";

    const search = page.querySelector("[data-library-search]");
    if (!(search instanceof HTMLInputElement)) return;

    const cards = [...page.querySelectorAll("[data-library-card]")];
    const count = page.querySelector("[data-result-count]");
    const empty = page.querySelector("[data-empty-state]");
    const filters = [...page.querySelectorAll("[data-filter]")];
    let activeFilter = "all";
    const planned = page.querySelector("[data-planned-library]");

    const groupMap = {
      cosmos: ["cosmic", "loka", "realms", "worlds", "time", "geography"],
      scriptures: ["scripture", "veda", "upanishad", "purana", "texts", "philosophy"],
      stories: ["itihasa", "epics", "stories", "kingdom", "dynasties", "wars", "events"],
      sciences: ["science", "yoga", "ayurveda", "astrology", "mantra", "temple", "ritual"],
      mystery: ["mystery", "hidden", "vimana", "astras", "creatures", "afterlife", "siddhis"],
    };

    const getHaystack = (card) => `${card.dataset.title || ""} ${card.dataset.topics || ""} ${card.dataset.description || ""} ${card.dataset.group || ""}`;
    const matchesFilter = (card) => activeFilter === "all" || groupMap[activeFilter]?.some((term) => getHaystack(card).includes(term));
    const update = () => {
      const query = search.value.trim().toLowerCase();
      let visible = 0;
      let plannedVisible = 0;
      page.classList.toggle("is-filtered", Boolean(query) || activeFilter !== "all");
      cards.forEach((card) => {
        const isVisible = (!query || getHaystack(card).includes(query)) && matchesFilter(card);
        card.hidden = !isVisible;
        if (isVisible) {
          if (card.dataset.available === "true") visible += 1;
          else plannedVisible += 1;
        }
      });
      if (count) count.textContent = `${visible} available categor${visible === 1 ? "y" : "ies"}${query && plannedVisible ? ` · ${plannedVisible} planned` : ""}`;
      if (planned) {
        planned.hidden = plannedVisible === 0;
        if (query) planned.open = visible === 0 && plannedVisible > 0;
      }
      if (empty instanceof HTMLElement) empty.hidden = visible + plannedVisible !== 0;
    };

    search.addEventListener("input", update);
    filters.forEach((button) => button.addEventListener("click", () => {
      activeFilter = button.dataset.filter || "all";
      filters.forEach((item) => { item.classList.toggle("active", item === button); item.setAttribute("aria-pressed", String(item === button)); });
      update();
    }));
    const quickRoutes = {
      "cosmic time": "/atlas#cosmic-time",
      "garuda purana": "/garuda-purana",
      "true devotee": "/true-devotee",
      "bhakti": "/true-devotee"
    };
    page.querySelectorAll("button[data-topic]").forEach((button) => button.addEventListener("click", () => {
      const topic = button.dataset.topic || "";
      const route = quickRoutes[topic.trim().toLowerCase()];
      if (route) {
        window.location.href = route;
        return;
      }
      search.value = topic;
      search.focus();
      update();
      page.scrollIntoView({ behavior: "smooth", block: "start" });
    }));
    const onShortcut = (event) => {
      if (event.key === "/" && !event.ctrlKey && !event.metaKey && !event.altKey && !(document.activeElement instanceof HTMLInputElement) && !(document.activeElement instanceof HTMLTextAreaElement)) {
        event.preventDefault();
        search.focus();
      }
    };
    window.addEventListener("keydown", onShortcut);
    document.addEventListener("astro:before-swap", () => window.removeEventListener("keydown", onShortcut), { once: true });

    update();
    const revealHash = () => {
      const target = document.getElementById(window.location.hash.slice(1));
      if (!target) return;
      const details = target.closest("details");
      if (details) details.open = true;
      target.scrollIntoView({ block: "start" });
    };
    revealHash();
    window.addEventListener("hashchange", revealHash);
    document.addEventListener("astro:before-swap", () => window.removeEventListener("hashchange", revealHash), { once: true });
  }

  initLibrarySearch();
  document.addEventListener("astro:page-load", initLibrarySearch);
  </script>
</BaseLayout>

<style>
  :global(body:has(.library-page)) {
    background: light-dark(rgb(247 240 226 / 1), #020a10);
    color: light-dark(rgb(43 33 24 / 1), #f7ebd3);
  }

  :global(body:has(.library-page)::before) {
    display: none;
  }

  .library-page {
    min-height: 100svh;
    padding: clamp(1.2rem, 2vw, 2rem) 0 4rem;
    background:
      radial-gradient(circle at 72% 0%, rgb(214 172 91 / .16), transparent 30rem),
      radial-gradient(circle at 12% 28%, rgb(101 215 220 / .08), transparent 28rem),
      linear-gradient(180deg, light-dark(rgb(247 240 226 / 1), #020a10), light-dark(rgb(247 240 226 / 1), #031116) 52%, light-dark(rgb(247 240 226 / 1), #020a10));
  }

  .library-page::before {
    position: fixed;
    inset: 0;
    z-index: 0;
    background-image: radial-gradient(circle, rgb(214 172 91 / .18) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: linear-gradient(to bottom, black, transparent 72%);
    pointer-events: none;
    content: "";
  }

  .library-hero,
  .library-toolbar,
  .availability-summary,
  .planned-library,
  .featured-shelf,
  .reading-room,
  .library-grid,
  .empty-state {
    position: relative;
    z-index: 1;
    width: min(1540px, calc(100% - 2rem));
    margin-inline: auto;
  }

  .library-hero {
    display: grid;
    grid-template-columns: minmax(24rem, .72fr) minmax(34rem, 1fr);
    gap: clamp(1.25rem, 3.4vw, 4rem);
    align-items: center;
    padding: clamp(1.2rem, 3vw, 3.25rem) 0 clamp(1rem, 2vw, 1.8rem);
  }

  .library-hero-copy h1,
  .section-heading h2,
  .empty-state h2 {
    margin: .55rem 0 0;
    color: light-dark(rgb(43 33 24 / 1), #fff2da);
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 450;
    letter-spacing: 0;
  }

  .library-hero-copy h1 {
    max-width: 12ch;
    font-size: clamp(3.25rem, 5.6vw, 5.9rem);
    line-height: .92;
  }

  .section-heading h2,
  .empty-state h2 { line-height: .9; }
  .library-hero-copy > p:not(.eyebrow) { max-width: 46rem; color: light-dark(rgb(91 76 57 / 1), #d0c2ad); font-size: clamp(1rem, 1.15vw, 1.14rem); line-height: 1.72; }

  .library-search {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: .85rem;
    width: min(100%, 46rem);
    min-height: 4.35rem;
    margin-top: 1.55rem;
    border: 1px solid light-dark(rgb(118 93 55 / 0.32), rgb(244 195 109 / .32));
    border-radius: 1.2rem;
    padding: .7rem .85rem .7rem 1rem;
    background:
      linear-gradient(135deg, light-dark(rgb(99 76 44 / 0.09), rgb(255 255 255 / .09)), light-dark(rgb(247 240 226 / 0.62), rgb(2 10 16 / .62))),
      radial-gradient(circle at 8% 50%, rgb(244 195 109 / .18), transparent 12rem);
    box-shadow: inset 0 1px rgb(255 255 255 / .08), 0 22px 65px light-dark(rgb(91 69 38 / 0.0875), rgb(0 0 0 / .25)), 0 0 40px rgb(244 195 109 / .06);
    backdrop-filter: blur(20px);
  }

  .library-search span { color: light-dark(rgb(105 84 47 / 1), #f4c36d); font-size: 1.15rem; font-weight: 900; letter-spacing: .12em; }
  .library-search input { width: 100%; border: 0; outline: 0; background: transparent; color: light-dark(rgb(43 33 24 / 1), #fff4dc); font: inherit; font-size: 1.05rem; }
  .library-search input::placeholder { color: light-dark(rgb(91 76 57 / 0.68), rgb(201 185 157 / .68)); }
  .library-search kbd { border: 1px solid light-dark(rgb(118 93 55 / 0.22), rgb(214 172 91 / .22)); border-radius: .55rem; padding: .14rem .5rem; color: light-dark(rgb(91 76 57 / 1), #c9b99d); font: inherit; }

  .library-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .65rem;
    width: min(100%, 38rem);
    margin-top: .85rem;
  }

  .library-stats span {
    border: 1px solid light-dark(rgb(118 93 55 / 0.14), rgb(214 172 91 / .14));
    border-radius: .9rem;
    padding: .72rem .8rem;
    background: linear-gradient(145deg, light-dark(rgb(99 76 44 / 0.04), rgb(255 255 255 / .04)), light-dark(rgb(247 240 226 / 0.24), rgb(2 10 16 / .24)));
  }

  .library-stats strong,
  .library-stats small { display: block; }
  .library-stats strong { color: light-dark(rgb(105 90 66 / 1), #f4d19a); font-family: Georgia, "Times New Roman", serif; font-size: 1.35rem; line-height: 1; }
  .library-stats small { margin-top: .22rem; color: light-dark(rgb(91 76 57 / 1), #9f9688); font-size: .62rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  .hero-reading-paths {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .65rem;
    width: min(100%, 46rem);
    margin-top: .85rem;
  }

  .hero-reading-paths button {
    min-height: 5.25rem;
    border: 1px solid light-dark(rgb(118 93 55 / 0.16), rgb(214 172 91 / .16));
    border-radius: 1rem;
    padding: .75rem .85rem;
    background: linear-gradient(145deg, light-dark(rgb(99 76 44 / 0.055), rgb(255 255 255 / .055)), light-dark(rgb(247 240 226 / 0.42), rgb(2 10 16 / .42)));
    color: light-dark(rgb(43 33 24 / 1), #f7ebd3);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: transform 200ms ease, border-color 200ms ease, background 200ms ease, box-shadow 200ms ease;
  }

  .hero-reading-paths button:hover {
    transform: translateY(-3px);
    border-color: light-dark(rgb(118 93 55 / 0.42), rgb(244 195 109 / .42));
    background: linear-gradient(145deg, rgb(244 195 109 / .12), light-dark(rgb(247 240 226 / 0.52), rgb(2 10 16 / .52)));
    box-shadow: 0 16px 40px light-dark(rgb(91 69 38 / 0.084), rgb(0 0 0 / .24));
  }

  .hero-reading-paths span,
  .hero-reading-paths strong { display: block; }
  .hero-reading-paths span { color: light-dark(rgb(105 84 47 / 1), #f4c36d); font-size: .62rem; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; }
  .hero-reading-paths strong { margin-top: .72rem; color: light-dark(rgb(43 33 24 / 1), #fff2da); font-family: Georgia, "Times New Roman", serif; font-size: 1.02rem; line-height: 1.05; }

  .library-hero-art {
    position: relative;
    min-height: clamp(28rem, 52svh, 38rem);
    overflow: hidden;
    border: 1px solid light-dark(rgb(118 93 55 / 0.22), rgb(214 172 91 / .22));
    border-radius: 1.65rem;
    background: light-dark(rgb(247 240 226 / 1), #061017);
    box-shadow: inset 0 1px rgb(255 255 255 / .06), 0 34px 110px light-dark(rgb(91 69 38 / 0.119), rgb(0 0 0 / .34));
    isolation: isolate;
  }

  .library-hero-art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: .78;
    filter: saturate(1.12) contrast(1.08) brightness(.9);
    transform: scale(1.02);
  }

  .library-hero-art::before {
    position: absolute;
    inset: 1.1rem;
    z-index: 2;
    border: 1px solid light-dark(rgb(118 93 55 / 0.14), rgb(244 195 109 / .14));
    border-radius: 1.1rem;
    pointer-events: none;
    content: "";
  }

  .library-hero-art::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(circle at 58% 48%, transparent 0 16%, light-dark(rgb(247 240 226 / 0.2), rgb(2 10 16 / .2)) 46%, light-dark(rgb(247 240 226 / 0.78), rgb(2 10 16 / .78))),
      linear-gradient(90deg, light-dark(rgb(247 240 226 / 0.76), rgb(2 10 16 / .76)), transparent 42%, light-dark(rgb(247 240 226 / 0.35), rgb(2 10 16 / .35)));
    content: "";
  }

  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: 2;
    background-image: linear-gradient(90deg, rgb(244 195 109 / .08) 1px, transparent 1px), linear-gradient(180deg, rgb(244 195 109 / .06) 1px, transparent 1px);
    background-size: 7.5rem 7.5rem;
    mask-image: radial-gradient(circle at 62% 52%, black, transparent 70%);
    pointer-events: none;
  }

  .catalog-card {
    position: absolute;
    left: clamp(1.25rem, 3vw, 2.4rem);
    bottom: clamp(1.25rem, 3vw, 2.4rem);
    z-index: 4;
    width: min(25rem, calc(100% - 3rem));
    border: 1px solid light-dark(rgb(118 93 55 / 0.22), rgb(244 195 109 / .22));
    border-radius: 1.15rem;
    padding: 1rem;
    background: linear-gradient(135deg, light-dark(rgb(247 240 226 / 0.72), rgb(2 10 16 / .72)), light-dark(rgb(250 245 234 / 0.5), rgb(10 25 31 / .5)));
    box-shadow: inset 0 1px rgb(255 255 255 / .08), 0 18px 54px light-dark(rgb(91 69 38 / 0.119), rgb(0 0 0 / .34));
    backdrop-filter: blur(18px);
  }

  .catalog-card span {
    color: light-dark(rgb(105 84 47 / 1), #f4c36d);
    font-size: .64rem;
    font-weight: 900;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .catalog-card strong {
    display: block;
    margin-top: .35rem;
    color: light-dark(rgb(43 33 24 / 1), #fff2da);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.75rem;
    line-height: 1;
  }

  .catalog-card p {
    margin: .48rem 0 0;
    color: light-dark(rgb(91 76 57 / 1), #c9b99d);
    font-size: .82rem;
    line-height: 1.5;
  }

  .shelf-stack {
    position: absolute;
    top: clamp(1.4rem, 3vw, 2.8rem);
    right: clamp(1.4rem, 3vw, 2.8rem);
    z-index: 4;
    display: grid;
    gap: .55rem;
    width: min(15rem, 34%);
  }

  .shelf-stack span {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .8rem;
    border: 1px solid light-dark(rgb(118 93 55 / 0.18), rgb(214 172 91 / .18));
    border-radius: .85rem;
    padding: .65rem .75rem;
    background: light-dark(rgb(247 240 226 / 0.58), rgb(2 10 16 / .58));
    color: light-dark(rgb(43 33 24 / 1), #f7ebd3);
    box-shadow: 0 12px 34px light-dark(rgb(91 69 38 / 0.077), rgb(0 0 0 / .22));
    backdrop-filter: blur(12px);
    font-size: .72rem;
    font-weight: 850;
  }

  .shelf-stack b { color: light-dark(rgb(105 84 47 / 1), #f4c36d); font-size: .62rem; letter-spacing: .08em; }

  .library-orbit { position: absolute; inset: 8%; z-index: 2; display: grid; place-items: center; }
  .library-orbit span { position: absolute; border: 1px solid light-dark(rgb(118 93 55 / 0.22), rgb(244 195 109 / .22)); border-radius: 50%; transform: rotate(-12deg) scaleY(.56); animation: library-orbit 28s linear infinite; }
  .library-orbit span:nth-child(1) { width: 84%; aspect-ratio: 1; }
  .library-orbit span:nth-child(2) { width: 62%; aspect-ratio: 1; border-color: light-dark(rgb(118 93 55 / 0.22), rgb(101 215 220 / .22)); animation-duration: 36s; animation-direction: reverse; }
  .library-orbit span:nth-child(3) { width: 102%; aspect-ratio: 1; border-style: dashed; opacity: .7; animation-duration: 48s; }

  .hero-node {
    position: absolute;
    z-index: 3;
    border: 1px solid color-mix(in srgb, var(--node-color, light-dark(rgb(118 93 55 / 1), #f4c36d)) 42%, transparent);
    border-radius: 999px;
    padding: .42rem .65rem;
    background: light-dark(rgb(247 240 226 / 0.62), rgb(2 10 16 / .62));
    color: color-mix(in srgb, var(--node-color, light-dark(rgb(105 84 47 / 1), #f4c36d)) 80%, light-dark(rgb(43 33 24 / 1), #fff2d4));
    box-shadow: 0 0 28px color-mix(in srgb, var(--node-color, #f4c36d) 20%, transparent);
    backdrop-filter: blur(12px);
    font-size: .64rem;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
    animation: float-node 5s ease-in-out infinite;
  }

  .hero-node.gold { --node-color: light-dark(rgb(105 84 47 / 1), #f4c36d); }
  .hero-node.teal { --node-color: light-dark(rgb(43 92 95 / 1), #65d7dc); }
  .hero-node.amber { --node-color: light-dark(rgb(110 82 49 / 1), #ffbf73); }
  .hero-node.violet { --node-color: light-dark(rgb(86 67 110 / 1), #c89bff); }
  .hero-node.fire { --node-color: light-dark(rgb(110 52 34 / 1), #ff7a4f); }
  .hero-node.blue { --node-color: light-dark(rgb(57 72 110 / 1), #85a8ff); }
  .hero-node.shadow { --node-color: light-dark(rgb(91 76 57 / 1), #dcc49d); }
  .node-1 { top: 18%; left: 43%; }
  .node-2 { top: 36%; right: 13%; animation-delay: .4s; }
  .node-3 { bottom: 19%; right: 18%; animation-delay: .8s; }
  .node-4 { bottom: 22%; left: 16%; animation-delay: 1.2s; }
  .node-5 { top: 26%; left: 12%; animation-delay: 1.6s; }

  .library-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
    border: 1px solid light-dark(rgb(118 93 55 / 0.16), rgb(214 172 91 / .16));
    border-radius: 1rem;
    padding: .65rem;
    background: linear-gradient(135deg, light-dark(rgb(99 76 44 / 0.04), rgb(255 255 255 / .04)), light-dark(rgb(247 240 226 / 0.46), rgb(2 10 16 / .46)));
  }

  .filter-tabs { display: flex; flex-wrap: wrap; gap: .45rem; }
  .filter-tabs button {
    border: 1px solid light-dark(rgb(118 93 55 / 0.16), rgb(214 172 91 / .16));
    border-radius: 999px;
    padding: .48rem .74rem;
    background: transparent;
    color: light-dark(rgb(91 76 57 / 1), #c9b99d);
    font: inherit;
    font-size: .72rem;
    font-weight: 850;
    cursor: pointer;
    transition: transform 180ms ease, color 180ms ease, background 180ms ease, border-color 180ms ease;
  }
  .filter-tabs button.active,
  .filter-tabs button:hover { transform: translateY(-1px); border-color: light-dark(rgb(118 93 55 / 0.5), rgb(244 195 109 / .5)); background: rgb(244 195 109 / .1); color: light-dark(rgb(43 33 24 / 1), #fff2d4); }
  .library-toolbar p { margin: 0; color: light-dark(rgb(91 76 57 / 1), #9f9688); font-size: .76rem; }

  .reading-room {
    display: grid;

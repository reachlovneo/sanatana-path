---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { garudaTopics, getGarudaTopicHref, type GarudaTopic } from "../../data/garudaPurana";
import { GARUDA_EDITION, GARUDA_PASSAGES } from "../../data/sourceReferences";

interface Props {
  topic: GarudaTopic;
}

const { topic } = Astro.props;
const index = garudaTopics.findIndex((item) => item.slug === topic.slug);
const previous = garudaTopics[index - 1];
const next = garudaTopics[index + 1];
const chapter = String(index + 1).padStart(2, "0");
const passage = GARUDA_PASSAGES[topic.slug];
---

<BaseLayout title={`${topic.title} | Garuda Purana | Sanatana Path`} description={topic.summary} image={topic.image} type="article">
  <article class="garuda-topic" style={`--accent:light-dark(#79531b, ${topic.accent}); --hero-image:url('${topic.image}')`}>
    <nav class="garuda-rail" aria-label="Garuda Purana journey navigation">
      <a class="rail-home" href="/garuda-purana"><span>Garuda Purana</span><strong>Afterlife Journey</strong></a>
      <div>
        {garudaTopics.map((item, itemIndex) => (
          <a href={getGarudaTopicHref(item.slug)} aria-current={item.slug === topic.slug ? "page" : undefined} class:list={[item.slug === topic.slug && "active"]} title={item.summary}>
            <span>{String(itemIndex + 1).padStart(2, "0")}</span>
            <strong>{item.title}</strong>
          </a>
        ))}
      </div>
    </nav>

    <header class="topic-hero">
      <div class="hero-copy">
        <a class="back-link" href="/garuda-purana">Garuda Purana</a>
        <p class="eyebrow">Chapter {chapter} / {topic.eyebrow}</p>
        <h1>{topic.title}</h1>
        <p>{topic.subtitle}</p>
        <div class="idea-row" aria-label={`${topic.title} key ideas`}>
          {topic.keyIdeas.map((idea) => <span>{idea}</span>)}
        </div>
      </div>
      <figure class="hero-visual">
        <img src={topic.image} alt="" loading="eager" decoding="async" />
        <figcaption><span>{topic.mood}</span><strong>{topic.title}</strong></figcaption>
      </figure>
    </header>

    <section class="screenplay" aria-label={`${topic.title} reading scenes`}>
      <aside class="scene-map">
        <p class="eyebrow">Reading flow</p>
        <h2>Follow the passage step by step.</h2>
        <div>
          {topic.scenes.map((scene, sceneIndex) => <a href={`#scene-${sceneIndex + 1}`}><span>{scene.label}</span><strong>{scene.title}</strong></a>)}
        </div>
      </aside>
      <article class="scene-list">
        {topic.scenes.map((scene, sceneIndex) => (
          <section id={`scene-${sceneIndex + 1}`}>
            <span class="scene-number">{scene.label}</span>
            <h2>{scene.title}</h2>
            {scene.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </section>
        ))}
        <section class="remember-card" aria-labelledby="remember-title">
          <p class="eyebrow">What to keep</p>
          <h2 id="remember-title">The chapter in one glance</h2>
          <div>{topic.remember.map((item) => <span>{item}</span>)}</div>
        </section>
        <details class="source-note">
          <summary><span>Sources and context</span><strong>About this reading</strong><b aria-hidden="true">+</b></summary>
          <p>This is an introductory reading preview. The narrative scenes and reflections are original explanations, not quotations from scripture. Exact supporting passages and interpretation await subject review.</p>
          <p>Edition for further reading: <a href={GARUDA_EDITION.url} rel="noreferrer">{GARUDA_EDITION.title} ↗</a>. {GARUDA_EDITION.note}</p>
          {passage && <p>Related chapter in that edition: <a href={passage.url} rel="noreferrer">{passage.title} ↗</a>. Read it alongside this introduction; the chapter link is not an endorsement of every interpretation above.</p>}
          <p><a href="/sources#garuda-reading">See the source directory and review status →</a></p>
        </details>
      </article>
    </section>

    <section class="topic-next" aria-labelledby="next-garuda-title">
      <a href={previous ? getGarudaTopicHref(previous.slug) : "/garuda-purana"}><span>{previous ? "Previous" : "Overview"}</span><strong>{previous?.title ?? "Garuda Purana"}</strong></a>
      <div>
        <p class="eyebrow">{next ? "Continue next" : "Journey complete"}</p>
        <h2 id="next-garuda-title">{next?.title ?? "Carry the reflection into life"}</h2>
        <p>{next?.summary ?? "Return to the overview or choose another reading path in the Library."}</p>
      </div>
      <a href={next ? getGarudaTopicHref(next.slug) : "/library"}><span>{next ? "Next" : "Explore"}</span><strong>{next?.title ?? "Library"} →</strong></a>
    </section>
  </article>
</BaseLayout>

<style>
  :global(body:has(.garuda-topic)) { background: light-dark(rgb(247 240 226 / 1), #020d13); color: light-dark(rgb(43 33 24 / 1), #fff4df); }
  :global(body:has(.garuda-topic)::before) { display: none; }
  .garuda-topic {
    min-height: 100svh;
    padding: clamp(14px, 2vw, 24px) 0 4rem;
    background:
      radial-gradient(circle at 74% 0%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 34rem),
      radial-gradient(circle at 8% 28%, rgba(115, 229, 232, .12), transparent 30rem),
      linear-gradient(180deg, light-dark(rgb(247 240 226 / 1), #020d13), light-dark(rgb(247 240 226 / 1), #031618) 52%, light-dark(rgb(247 240 226 / 1), #020d13));
  }
  .garuda-rail,
  .topic-hero,
  .screenplay,
  .topic-next {
    width: min(1460px, calc(100% - 2rem));
    margin-inline: auto;
  }
  .garuda-rail {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: .75rem;
    align-items: center;
    margin-bottom: 1rem;
    border: 1px solid light-dark(rgb(118 93 55 / 0.2), rgba(119, 229, 232, .2));
    border-radius: 1rem;
    padding: .65rem;
    background: light-dark(rgb(247 240 226 / 0.76), rgba(2, 18, 22, .76));
    overflow: hidden;
  }
  .rail-home {
    display: grid;
    border-right: 1px solid light-dark(rgb(118 93 55 / 0.18), rgba(119, 229, 232, .18));
    padding: .35rem 1rem .35rem .5rem;
    color: light-dark(rgb(43 33 24 / 1), #fff4df);
    text-decoration: none;
  }
  .rail-home span,
  .eyebrow,
  .scene-number {
    color: light-dark(rgb(55 104 103 / 1), #7ff2f0);
    font-family: var(--font-display);
    font-size: .75rem;
    font-weight: 900;
    letter-spacing: .18em;
    text-transform: uppercase;
  }
  .rail-home strong { margin-top: .12rem; font-family: var(--font-serif); font-size: 1.12rem; font-weight: 500; }
  .garuda-rail > div {
    display: flex;
    gap: .5rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .garuda-rail > div::-webkit-scrollbar { display: none; }
  .garuda-rail > div a {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: .1rem .45rem;
    align-items: center;
    min-width: 9.5rem;
    border: 1px solid light-dark(rgb(118 93 55 / 0.19), rgba(119, 229, 232, .19));
    border-radius: 999px;
    padding: .45rem .65rem;
    color: light-dark(rgb(91 76 57 / 1), #d8d0bf);
    background: light-dark(rgb(99 76 44 / 0.025), rgba(255, 255, 255, .025));
    text-decoration: none;
  }
  .garuda-rail > div a.active,
  .garuda-rail > div a:hover {
    border-color: color-mix(in srgb, var(--accent) 65%, light-dark(rgb(118 93 55 / 1), #7ff2f0));
    color: light-dark(rgb(43 33 24 / 1), #fff4df);
    background: color-mix(in srgb, var(--accent) 12%, light-dark(rgb(247 240 226 / 0.8), rgba(3, 18, 22, .8)));
  }
  .garuda-rail > div span {
    display: grid;
    place-items: center;
    width: 1.65rem;
    height: 1.65rem;
    border-radius: 50%;
    color: #041216;
    background: var(--accent);
    font-size: .6rem;
    font-weight: 900;
  }
  .garuda-rail > div strong { overflow: hidden; font-size: .78rem; font-weight: 850; text-overflow: ellipsis; white-space: nowrap; }
  .topic-hero {
    display: grid;
    grid-template-columns: minmax(320px, .56fr) minmax(420px, .84fr);
    min-height: clamp(28rem, 60svh, 38rem);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--accent) 28%, light-dark(rgb(118 93 55 / 0.18), rgba(119, 229, 232, .18)));
    border-radius: 1.25rem;
    background: light-dark(rgb(247 240 226 / 0.72), rgba(2, 16, 20, .72));
    box-shadow: inset 0 1px rgba(255, 255, 255, .045), 0 26px 80px light-dark(rgb(91 69 38 / 0.084), rgba(0, 0, 0, .24));
  }
  .hero-copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.4rem, 4vw, 4rem);
    background:
      linear-gradient(90deg, light-dark(rgb(247 240 226 / 0.96), rgba(2, 14, 18, .96)), light-dark(rgb(247 240 226 / 0.76), rgba(2, 14, 18, .76))),
      var(--hero-image) center/cover;
  }
  .back-link {
    display: inline-flex;
    width: fit-content;
    margin-bottom: 1.35rem;
    border: 1px solid color-mix(in srgb, var(--accent) 55%, transparent);
    border-radius: 999px;
    padding: .55rem .8rem;
    color: light-dark(rgb(43 33 24 / 1), #fff4df);
    background: light-dark(rgb(247 240 226 / 0.5), rgba(2, 12, 16, .5));
    font-size: .76rem;
    font-weight: 850;
    text-decoration: none;
  }
  .hero-copy h1 {
    max-width: 9ch;
    margin: .55rem 0 .85rem;
    color: light-dark(rgb(43 33 24 / 1), #fff4df);
    font-family: var(--font-serif);
    font-size: clamp(4rem, 8vw, 7.2rem);
    font-weight: 600;
    line-height: .88;
  }
  .hero-copy p:not(.eyebrow) {
    max-width: 44rem;
    margin: 0;
    color: light-dark(rgb(91 76 57 / 1), #d8d0bf);
    font-size: clamp(1.05rem, 1.35vw, 1.3rem);
    line-height: 1.65;
  }
  .idea-row {
    display: flex;
    flex-wrap: wrap;
    gap: .6rem;
    margin-top: 1.3rem;
  }
  .idea-row span {
    border: 1px solid light-dark(rgb(118 93 55 / 0.24), rgba(119, 229, 232, .24));
    border-radius: 999px;
    padding: .55rem .78rem;
    color: light-dark(rgb(43 33 24 / 1), #fff4df);
    background: light-dark(rgb(99 76 44 / 0.035), rgba(255, 255, 255, .035));
    font-weight: 800;
  }
  .hero-visual { position: relative; min-height: 26rem; margin: 0; }
  .hero-visual img { width: 100%; height: 100%; object-fit: cover; filter: saturate(1.05) contrast(1.04); }
  .hero-visual::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, light-dark(rgb(247 240 226 / 0.58), rgba(2, 14, 18, .58)), transparent 34%), linear-gradient(180deg, transparent, light-dark(rgb(247 240 226 / 0.56), rgba(2, 14, 18, .56)));
    pointer-events: none;
  }
  .hero-visual figcaption {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 1;
    display: grid;
    min-width: 16rem;
    border: 1px solid light-dark(rgb(118 93 55 / 0.12), rgba(255, 255, 255, .12));
    border-radius: 1rem;
    padding: 1rem;
    background: light-dark(rgb(247 240 226 / 0.5), rgba(2, 14, 18, .5));
    backdrop-filter: blur(14px);
  }
  .hero-visual figcaption span { color: var(--accent); font-weight: 900; letter-spacing: .12em; text-transform: uppercase; }
  .hero-visual figcaption strong { margin-top: .2rem; color: light-dark(rgb(43 33 24 / 1), #fff4df); font-family: var(--font-serif); font-size: 1.55rem; }
  .screenplay {
    display: grid;
    grid-template-columns: minmax(260px, 360px) minmax(0, 1fr);
    gap: clamp(1rem, 2vw, 1.6rem);
    margin-top: clamp(1rem, 2vw, 1.6rem);
    align-items: start;
  }
  .scene-map,
  .scene-list > section,
  .source-note,
  .topic-next {
    border: 1px solid light-dark(rgb(118 93 55 / 0.2), rgba(119, 229, 232, .2));
    border-radius: 1rem;
    background: linear-gradient(145deg, light-dark(rgb(247 240 226 / 0.86), rgba(3, 15, 19, .86)), light-dark(rgb(247 240 226 / 0.6), rgba(3, 15, 19, .6)));
    box-shadow: inset 0 1px rgba(255, 255, 255, .04);
  }
  .scene-map {
    position: sticky;
    top: 105px;
    display: grid;
    gap: 1rem;
    padding: 1.2rem;
  }
  .scene-map h2 {
    margin: 0;
    color: light-dark(rgb(43 33 24 / 1), #fff4df);
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3vw, 2.8rem);
    line-height: .98;
  }
  .scene-map > div { display: grid; gap: .7rem; }
  .scene-map a {
    display: grid;
    border: 1px solid light-dark(rgb(118 93 55 / 0.18), rgba(119, 229, 232, .18));
    border-radius: .8rem;
    padding: .8rem;
    color: light-dark(rgb(91 76 57 / 1), #d8d0bf);
    background: light-dark(rgb(99 76 44 / 0.025), rgba(255, 255, 255, .025));
    text-decoration: none;
  }
  .scene-map a:hover { border-color: color-mix(in srgb, var(--accent) 55%, light-dark(rgb(118 93 55 / 1), #7ff2f0)); color: light-dark(rgb(43 33 24 / 1), #fff4df); }
  .scene-map a span { color: var(--accent); font-size: .68rem; font-weight: 900; letter-spacing: .16em; text-transform: uppercase; }
  .scene-list { display: grid; gap: 1rem; }
  .scene-list > section {
    padding: clamp(1.2rem, 3vw, 2.5rem);
  }
  .scene-list h2 {
    margin: .45rem 0 1rem;
    color: light-dark(rgb(43 33 24 / 1), #fff4df);
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 4.5vw, 4.8rem);
    line-height: .95;
  }
  .scene-list p {
    max-width: 72ch;
    color: light-dark(rgb(91 76 57 / 1), #d8d0bf);
    font-size: 1.08rem;
    line-height: 1.8;
  }
  .remember-card div {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .75rem;
    margin-top: 1rem;
  }
  .remember-card span {
    border: 1px solid color-mix(in srgb, var(--accent) 28%, light-dark(rgb(118 93 55 / 0.18), rgba(119, 229, 232, .18)));
    border-radius: .85rem;
    padding: 1rem;
    color: light-dark(rgb(43 33 24 / 1), #fff4df);
    background: color-mix(in srgb, var(--accent) 8%, light-dark(rgb(99 76 44 / 0.025), rgba(255, 255, 255, .025)));
    line-height: 1.55;
  }
  .source-note { padding: 0; overflow: hidden; }
  .source-note summary {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: .4rem 1rem;
    align-items: center;
    padding: 1.1rem 1.2rem;
    cursor: pointer;
    list-style: none;
  }
  .source-note summary::-webkit-details-marker { display: none; }
  .source-note summary span { color: light-dark(rgb(55 104 103 / 1), #7ff2f0); font-size: .7rem; font-weight: 900; letter-spacing: .16em; text-transform: uppercase; }
  .source-note summary strong { grid-column: 1; color: light-dark(rgb(43 33 24 / 1), #fff4df); font-family: var(--font-serif); font-size: 1.8rem; }
  .source-note summary b { grid-column: 2; grid-row: 1 / 3; display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border: 1px solid color-mix(in srgb, var(--accent) 48%, transparent); border-radius: 50%; color: var(--accent); }
  .source-note p { margin: 0; padding: 0 1.2rem 1.2rem; color: light-dark(rgb(91 76 57 / 1), #d8d0bf); line-height: 1.75; }
  .topic-next {
    display: grid;
    grid-template-columns: minmax(9rem, auto) minmax(0, 1fr) minmax(9rem, auto);
    gap: 1rem;
    align-items: center;
    margin-top: 1.4rem;
    padding: clamp(1rem, 2.5vw, 2rem);
  }
  .topic-next h2 { margin: .25rem 0 .55rem; color: light-dark(rgb(43 33 24 / 1), #fff4df); font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 4rem); }
  .topic-next p:not(.eyebrow) { max-width: 64ch; margin: 0; color: light-dark(rgb(91 76 57 / 1), #d8d0bf); line-height: 1.7; }
  .topic-next a {
    display: grid;
    border: 1px solid color-mix(in srgb, var(--accent) 42%, light-dark(rgb(118 93 55 / 0.2), rgba(119, 229, 232, .2)));
    border-radius: 999px;
    padding: .85rem 1rem;
    color: light-dark(rgb(43 33 24 / 1), #fff4df);
    text-decoration: none;
  }
  .topic-next a span { color: var(--accent); font-size: .65rem; font-weight: 900; letter-spacing: .16em; text-transform: uppercase; }
  .topic-next a strong { white-space: nowrap; }
  @media (max-width: 1050px) {
    .garuda-rail,
    .topic-hero,
    .screenplay,
    .topic-next { width: min(100% - 1rem, 1460px); }
    .garuda-rail,
    .topic-hero,
    .screenplay,
    .topic-next { grid-template-columns: 1fr; }
    .rail-home { border-right: 0; border-bottom: 1px solid light-dark(rgb(118 93 55 / 0.18), rgba(119, 229, 232, .18)); }
    .scene-map { position: static; }
    .remember-card div { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .garuda-topic { padding-top: .5rem; }
    .hero-copy { padding: 1rem; }
    .hero-copy h1 { font-size: clamp(3.4rem, 15vw, 4.8rem); }
    .hero-visual { min-height: 18rem; }
    .hero-visual figcaption { left: .75rem; right: .75rem; min-width: 0; }
    .garuda-rail > div a { min-width: 8.2rem; }
    .scene-list > section { padding: 1rem; }
    .scene-list h2 { font-size: clamp(2.1rem, 11vw, 3.2rem); }
    .topic-next a { justify-items: start; border-radius: .9rem; }
  }
</style>

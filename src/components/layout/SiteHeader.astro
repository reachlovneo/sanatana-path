---
import { PRIMARY_NAVIGATION, SITE } from "../../config/site";
import { isRouteActive } from "../../utils/routes";

const currentPath = Astro.url.pathname;
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Sanatana Path home">
      <span aria-hidden="true" class="brand-mark">SP</span>
      <span><strong>{SITE.name}</strong><small>{SITE.tagline}</small></span>
    </a>
    <nav aria-label="Primary navigation">
      {PRIMARY_NAVIGATION.map((link) => <a href={link.href} aria-current={isRouteActive(currentPath, link.href) ? "page" : undefined}>{link.label}</a>)}
    </nav>
    <a class="search-pill" href="/library" aria-label="Open the library"><span>Open Library</span><kbd aria-hidden="true">-&gt;</kbd></a>
  </div>
</header>
<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid rgb(214 172 91 / .14);
    background: rgb(2 10 16 / .76);
    color: #f7ebd3;
    backdrop-filter: blur(22px) saturate(1.08);
  }

  .header-inner {
    display: grid;
    min-height: 72px;
    grid-template-columns: minmax(16rem, 1fr) auto minmax(10rem, 1fr);
    gap: clamp(.9rem, 2vw, 1.6rem);
    align-items: center;
  }

  .brand {
    display: inline-flex;
    width: fit-content;
    min-width: 0;
    align-items: center;
    gap: .72rem;
  }

  .brand-mark {
    display: grid;
    width: 2.55rem;
    height: 2.55rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgb(214 172 91 / .42);
    border-radius: 50%;
    color: #e1b966;
    font-size: .72rem;
    font-weight: 900;
    letter-spacing: .04em;
    box-shadow: 0 0 24px rgb(214 172 91 / .08);
  }

  .brand strong,
  .brand small {
    display: block;
    letter-spacing: .12em;
  }

  .brand strong {
    color: #f7ebd3;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1rem, 1.3vw, 1.12rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .brand small {
    margin-top: .22rem;
    color: #9f9688;
    font-size: .57rem;
    letter-spacing: .18em;
    white-space: nowrap;
  }

  nav {
    display: flex;
    justify-content: center;
    gap: clamp(1rem, 2vw, 1.55rem);
    align-items: center;
  }

  nav a {
    position: relative;
    color: #aaa49a;
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
    transition: color 180ms ease;
  }

  nav a[aria-current="page"],
  nav a:hover {
    color: #f4d19a;
  }

  nav a[aria-current="page"]::after {
    position: absolute;
    right: 0;
    bottom: -1.45rem;
    left: 0;
    height: 2px;
    background: #e7b861;
    box-shadow: 0 0 14px rgb(244 195 109 / .55);
    content: "";
  }

  .search-pill {
    display: inline-flex;
    width: fit-content;
    min-height: 2.55rem;
    justify-self: end;
    align-items: center;
    gap: .72rem;
    border: 1px solid rgb(214 172 91 / .18);
    border-radius: 999px;
    padding: .5rem .58rem .5rem .88rem;
    color: #c9b99d;
    background: rgb(255 255 255 / .025);
    font-size: .82rem;
    font-weight: 750;
    transition: border-color 180ms ease, color 180ms ease, background-color 180ms ease;
  }

  .search-pill:hover {
    border-color: rgb(244 195 109 / .42);
    color: #f7ebd3;
    background: rgb(255 255 255 / .045);
  }

  .search-pill kbd {
    display: grid;
    width: 1.8rem;
    height: 1.8rem;
    place-items: center;
    border: 1px solid rgb(214 172 91 / .2);
    border-radius: 50%;
    color: #e7b861;
    font: inherit;
    font-size: .68rem;
  }

  @media (max-width: 1180px) {
    .header-inner { grid-template-columns: 1fr auto; }
    .search-pill { display: none; }
  }

  @media (max-width: 800px) {
    .site-header { background: rgb(2 10 16 / .94); backdrop-filter: none; }
    .header-inner { min-height: 64px; }
    .brand-mark { width: 2.35rem; height: 2.35rem; }
    .brand small,
    nav { display: none; }
  }
</style>
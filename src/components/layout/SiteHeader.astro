---
import { PRIMARY_NAVIGATION, SITE } from "../../config/site";
import { isRouteActive } from "../../utils/routes";

const currentPath = Astro.url.pathname;
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Sanatana Path home">
      <span aria-hidden="true" class="brand-mark">SP</span>
      <span><strong>{SITE.name}</strong><small>{SITE.tagline}</small></span>
    </a>
    <nav aria-label="Primary navigation">
      {PRIMARY_NAVIGATION.map((link) => <a href={link.href} aria-current={isRouteActive(currentPath, link.href) ? "page" : undefined}>{link.label}</a>)}
    </nav>
    <a class="search-pill" href="/library" aria-label="Search the library"><span>Search the Library...</span><kbd>/</kbd></a>
    <a class="round-mark" href="/atlas" aria-label="Open atlas">SP</a>
  </div>
</header>
<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid rgb(214 172 91 / .18);
    background: rgb(2 10 16 / .86);
    color: #f7ebd3;
    backdrop-filter: blur(18px);
  }

  .header-inner {
    display: grid;
    min-height: 76px;
    grid-template-columns: minmax(18rem, 1fr) auto minmax(18rem, .8fr) auto;
    gap: 1.2rem;
    align-items: center;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: .85rem;
    min-width: 0;
  }

  .brand-mark,
  .round-mark {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgb(214 172 91 / .45);
    border-radius: 50%;
    color: #d6ac5b;
    box-shadow: 0 0 30px rgb(214 172 91 / .1);
  }

  .brand-mark { width: 3.1rem; height: 3.1rem; font-size: .78rem; font-weight: 900; letter-spacing: .04em; }
  .round-mark { width: 3rem; height: 3rem; font-size: .72rem; font-weight: 900; letter-spacing: .04em; }

  .brand strong,
  .brand small {
    display: block;
    letter-spacing: .14em;
  }

  .brand strong {
    color: #f7ebd3;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.22rem;
    text-transform: uppercase;
  }

  .brand small {
    margin-top: .15rem;
    color: #9f9688;
    font-size: .62rem;
  }

  nav {
    display: flex;
    gap: 1.6rem;
    align-items: center;
  }

  nav a {
    position: relative;
    color: #aaa49a;
    font-size: .78rem;
    letter-spacing: .04em;
    text-transform: uppercase;
    transition: color 180ms ease;
  }

  nav a[aria-current="page"],
  nav a:hover {
    color: #f4d19a;
  }

  nav a[aria-current="page"]::after {
    position: absolute;
    right: 0;
    bottom: -.8rem;
    left: 0;
    height: 2px;
    background: #f4c36d;
    box-shadow: 0 0 16px rgb(244 195 109 / .8);
    content: "";
  }

  .search-pill {
    display: flex;
    min-height: 3rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid rgb(214 172 91 / .22);
    border-radius: 999px;
    padding: .55rem .75rem .55rem 1rem;
    color: #8f8b84;
    background: rgb(2 10 16 / .62);
  }

  .search-pill kbd {
    border: 1px solid rgb(214 172 91 / .18);
    border-radius: .45rem;
    padding: .08rem .42rem;
    color: #c9b99d;
    font: inherit;
    font-size: .72rem;
  }

  @media (max-width: 1180px) {
    .header-inner { grid-template-columns: 1fr auto; }
    .search-pill,
    .round-mark { display: none; }
  }

  @media (max-width: 800px) {
    .site-header { background: #020a10; backdrop-filter: none; }
    .header-inner { min-height: 68px; }
    .brand small,
    nav { display: none; }
  }
</style>

---
import { PRIMARY_NAVIGATION, SITE } from "../../config/site";
import { isRouteActive } from "../../utils/routes";

const currentPath = Astro.url.pathname;
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Sanatana Path home">
      <span aria-hidden="true" class="brand-mark">
        <img src="/images/brand/golden-lotus-logo-256.png" alt="" width="40" height="40" decoding="async" />
      </span>
      <span><strong>{SITE.name}</strong><small>{SITE.tagline}</small></span>
    </a>
    <nav aria-label="Primary navigation">
      {PRIMARY_NAVIGATION.map((link) => <a href={link.href} aria-current={isRouteActive(currentPath, link.href) ? "page" : undefined}>{link.label}</a>)}
    </nav>
    <div class="header-actions">
      <a class="search-pill" href="/library" aria-label="Open the library"><span>Open Library</span><kbd aria-hidden="true">-&gt;</kbd></a>
      <button class="theme-orb" type="button" data-theme-toggle aria-label="Switch to day theme" aria-pressed="true">
        <span class="orb-sky" aria-hidden="true"><i></i></span>
        <span class="theme-copy"><small>Theme</small><strong data-theme-label>Night</strong></span>
      </button>
    </div>
  </div>
</header>
<script is:inline>
  (() => {
    const syncThemeButton = () => {
      const root = document.documentElement;
      const button = document.querySelector("[data-theme-toggle]");
      const label = document.querySelector("[data-theme-label]");
      if (!button || !label) return;
      const isLight = root.dataset.theme === "light";
      label.textContent = isLight ? "Day" : "Night";
      button.setAttribute("aria-label", isLight ? "Switch to night theme" : "Switch to day theme");
      button.setAttribute("aria-pressed", String(!isLight));
    };

    const bindThemeButton = () => {
      const button = document.querySelector("[data-theme-toggle]");
      if (!button || button.dataset.bound === "true") return;
      button.dataset.bound = "true";
      button.addEventListener("click", () => {
        const root = document.documentElement;
        const nextTheme = root.dataset.theme === "light" ? "dark" : "light";
        root.dataset.theme = nextTheme;
        try { localStorage.setItem("theme", nextTheme); } catch {}
        syncThemeButton();
      });
      syncThemeButton();
    };

    bindThemeButton();
    document.addEventListener("astro:page-load", bindThemeButton);
  })();
</script>
<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid rgb(214 172 91 / .14);
    background: rgb(2 10 16 / .76);
    color: #f7ebd3;
    backdrop-filter: blur(22px) saturate(1.08);
  }

  .header-inner {
    display: grid;
    min-height: 72px;
    grid-template-columns: minmax(16rem, 1fr) auto minmax(13rem, 1fr);
    gap: clamp(.9rem, 2vw, 1.6rem);
    align-items: center;
  }

  .brand {
    display: inline-flex;
    width: fit-content;
    min-width: 0;
    align-items: center;
    gap: .72rem;
  }

  .brand-mark {
    display: grid;
    width: 2.55rem;
    height: 2.55rem;
    flex: 0 0 auto;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgb(214 172 91 / .42);
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 46%, rgb(244 195 109 / .14), transparent 58%),
      rgb(2 10 16 / .92);
    box-shadow: 0 0 24px rgb(214 172 91 / .12), inset 0 0 18px rgb(214 172 91 / .06);
  }

  .brand-mark img {
    width: 86%;
    height: 86%;
    border-radius: 50%;
    object-fit: contain;
    filter: saturate(1.08) contrast(1.06) brightness(1.08);
  }

  .brand strong,
  .brand small {
    display: block;
    letter-spacing: .12em;
  }

  .brand strong {
    color: #f7ebd3;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1rem, 1.3vw, 1.12rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .brand small {
    margin-top: .22rem;
    color: #9f9688;
    font-size: .57rem;
    letter-spacing: .18em;
    white-space: nowrap;
  }

  nav {
    display: flex;
    justify-content: center;
    gap: clamp(1rem, 2vw, 1.55rem);
    align-items: center;
  }

  nav a {
    position: relative;
    color: #aaa49a;
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
    transition: color 180ms ease;
  }

  nav a[aria-current="page"],
  nav a:hover {
    color: #f4d19a;
  }

  nav a[aria-current="page"]::after {
    position: absolute;
    right: 0;
    bottom: -1.45rem;
    left: 0;
    height: 2px;
    background: #e7b861;
    box-shadow: 0 0 14px rgb(244 195 109 / .55);
    content: "";
  }

  .header-actions {
    display: inline-flex;
    justify-self: end;
    align-items: center;
    gap: .65rem;
  }

  .search-pill {
    display: inline-flex;
    width: fit-content;
    min-height: 2.55rem;
    justify-self: end;
    align-items: center;
    gap: .72rem;
    border: 1px solid rgb(214 172 91 / .18);
    border-radius: 999px;
    padding: .5rem .58rem .5rem .88rem;
    color: #c9b99d;
    background: rgb(255 255 255 / .025);
    font-size: .82rem;
    font-weight: 750;
    transition: border-color 180ms ease, color 180ms ease, background-color 180ms ease;
  }

  .search-pill:hover {
    border-color: rgb(244 195 109 / .42);
    color: #f7ebd3;
    background: rgb(255 255 255 / .045);
  }

  .theme-orb {
    display: inline-flex;
    min-height: 2.55rem;
    align-items: center;
    gap: .58rem;
    border: 1px solid rgb(214 172 91 / .2);
    border-radius: 999px;
    padding: .34rem .72rem .34rem .38rem;
    color: #f7ebd3;
    background: radial-gradient(circle at 28% 28%, rgb(244 195 109 / .18), transparent 1.4rem), rgb(255 255 255 / .03);
    cursor: pointer;
    font: inherit;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .theme-orb:hover {
    transform: translateY(-1px);
    border-color: rgb(244 195 109 / .48);
    background: radial-gradient(circle at 28% 28%, rgb(244 195 109 / .28), transparent 1.4rem), rgb(255 255 255 / .055);
  }

  .orb-sky {
    position: relative;
    display: grid;
    width: 1.86rem;
    height: 1.86rem;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgb(214 172 91 / .28);
    border-radius: 50%;
    background: linear-gradient(145deg, #07101d, #172143);
    box-shadow: inset 0 0 18px rgb(0 0 0 / .35), 0 0 18px rgb(214 172 91 / .1);
  }

  .orb-sky::before,
  .orb-sky::after {
    position: absolute;
    border-radius: 50%;
    content: "";
  }

  .orb-sky::before {
    width: .4rem;
    height: .4rem;
    background: #f7ebd3;
    box-shadow: .5rem -.42rem 0 -.14rem #f7ebd3, -.46rem .35rem 0 -.16rem #f7ebd3;
  }

  .orb-sky::after {
    right: .38rem;
    bottom: .42rem;
    width: .78rem;
    height: .78rem;
    background: #e7b861;
    box-shadow: 0 0 18px rgb(231 184 97 / .42);
  }

  .orb-sky i {
    position: absolute;
    right: .62rem;
    bottom: .58rem;
    width: .78rem;
    height: .78rem;
    border-radius: 50%;
    background: #07101d;
    transition: transform 220ms ease, opacity 220ms ease;
  }

  .theme-copy {
    display: grid;
    gap: .03rem;
    text-align: left;
    line-height: 1;
  }

  .theme-copy small {
    color: #8f877b;
    font-size: .52rem;
    font-weight: 900;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .theme-copy strong {
    color: #f4d19a;
    font-size: .68rem;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  :global(:root[data-theme="light"]) .site-header {
    border-bottom-color: rgb(153 84 38 / .18);
    background: rgb(255 249 237 / .82);
    color: #2b2118;
  }

  :global(:root[data-theme="light"]) .brand strong { color: #2b2118; }
  :global(:root[data-theme="light"]) .brand-mark {
    background:
      radial-gradient(circle at 50% 46%, rgb(244 195 109 / .18), transparent 58%),
      #fff6df;
    box-shadow: 0 0 20px rgb(153 84 38 / .1), inset 0 0 14px rgb(153 84 38 / .08);
  }
  :global(:root[data-theme="light"]) .brand small,
  :global(:root[data-theme="light"]) nav a,
  :global(:root[data-theme="light"]) .search-pill { color: #6b5b4a; }
  :global(:root[data-theme="light"]) nav a[aria-current="page"],
  :global(:root[data-theme="light"]) nav a:hover,
  :global(:root[data-theme="light"]) .search-pill:hover { color: #995426; }
  :global(:root[data-theme="light"]) .theme-orb { color: #2b2118; background: radial-gradient(circle at 28% 28%, rgb(200 155 75 / .24), transparent 1.4rem), rgb(18 63 53 / .045); }
  :global(:root[data-theme="light"]) .orb-sky { background: linear-gradient(145deg, #f7d98c, #78a8d8); }
  :global(:root[data-theme="light"]) .orb-sky::before { opacity: 0; }
  :global(:root[data-theme="light"]) .orb-sky i { opacity: 0; transform: translate(.8rem, -.2rem); }
  :global(:root[data-theme="light"]) .theme-copy small { color: #6b5b4a; }
  :global(:root[data-theme="light"]) .theme-copy strong { color: #995426; }

  .search-pill kbd {
    display: grid;
    width: 1.8rem;
    height: 1.8rem;
    place-items: center;
    border: 1px solid rgb(214 172 91 / .2);
    border-radius: 50%;
    color: #e7b861;
    font: inherit;
    font-size: .68rem;
  }

  @media (max-width: 1180px) {
    .header-inner { grid-template-columns: 1fr auto; }
    .header-actions {
    display: inline-flex;
    justify-self: end;
    align-items: center;
    gap: .65rem;
  }

  .search-pill { display: none; }
  }

  @media (max-width: 800px) {
    .site-header { background: rgb(2 10 16 / .94); backdrop-filter: none; }
    :global(:root[data-theme="light"]) .site-header { background: rgb(255 249 237 / .94); }
    .header-inner { min-height: 64px; }
    .brand-mark { width: 2.35rem; height: 2.35rem; }
    .brand small,
    nav { display: none; }
  }
</style>
---
import { FOOTER_NAVIGATION, SITE } from "../../config/site";
---
<footer>
  <div class="container footer-inner">
    <div><strong>{SITE.name}</strong><p>{SITE.description}</p></div>
    <nav aria-label="Footer navigation">{FOOTER_NAVIGATION.map((link) => <a href={link.href}>{link.label}</a>)}</nav>
  </div>
</footer>
<style>
  footer { margin-top: 5rem; border-top: 1px solid var(--border); color: var(--ink-muted); }
  .footer-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding-block: 2rem 6rem; }
  strong { color: var(--ink); font-family: var(--serif); font-size: 1.2rem; } p { margin: 0.2rem 0 0; } nav { display: flex; flex-wrap: wrap; gap: 1rem; } a:hover { color: var(--ink); }
  @media (max-width: 640px) { .footer-inner { align-items: flex-start; flex-direction: column; } }
</style>

---
import { FOOTER_NAVIGATION } from "../../config/site";

---
<footer>
  <div class="container footer-inner">
    <span class="footer-mark"><img src="/images/brand/golden-lotus-logo-256.png" alt="" width="32" height="32" decoding="async" /></span>
    <nav aria-label="Footer navigation">{FOOTER_NAVIGATION.map((link) => <a href={link.href}>{link.label}</a>)}</nav>
    <p class="powered">Powered by <strong>LOVnEo</strong></p>
  </div>
</footer>
<style>
  footer { margin-top: 1rem; border-top: 1px solid var(--border); color: var(--ink-muted); }
  .footer-inner { display: flex; min-height: 72px; align-items: center; justify-content: center; gap: 2rem; padding-block: 1rem; }
  .footer-mark { display: grid; width: 2.25rem; height: 2.25rem; place-items: center; overflow: hidden; border: 1px solid var(--border); border-radius: 50%; background: radial-gradient(circle, rgb(214 172 91 / .12), transparent 62%); box-shadow: inset 0 0 14px rgb(214 172 91 / .06); }
  .footer-mark img { width: 86%; height: 86%; border-radius: 50%; object-fit: contain; filter: saturate(1.08) contrast(1.06) brightness(1.05); }
  .powered { margin: 0; color: var(--ink-muted); font-size: 0.74rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .powered strong { color: var(--gold); font-weight: 900; }
  nav { display: flex; flex-wrap: wrap; gap: 1.5rem; font-size: 0.78rem; } a:hover { color: var(--ink); }
  @media (max-width: 760px) { .footer-inner { flex-direction: column; gap: 0.9rem; text-align: center; } nav { justify-content: center; gap: 0.8rem; } }
</style>

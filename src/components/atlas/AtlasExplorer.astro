    transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease, filter 220ms ease;
  }

  .journey-rail .rail-card::before {
    position: absolute;
    display: block;
    inset: 0;
    z-index: -1;
    width: auto;
    height: auto;
    background:
      radial-gradient(circle at 50% 22%, color-mix(in srgb, var(--node-color) 24%, transparent), transparent 46%),
      linear-gradient(90deg, rgb(2 8 13 / .58), transparent 45%, rgb(2 8 13 / .42));

---
import { getEntry } from "astro:content";
import SacredIcon from "../ui/SacredIcon.astro";
import AtlasGlyph from "../ui/AtlasGlyph.astro";
import CosmicTimeJourney from "../topic/CosmicTimeJourney.astro";
import KalpaJourney from "../topic/KalpaJourney.astro";
import ManvantaraJourney from "../topic/ManvantaraJourney.astro";
import MahaYugaJourney from "../topic/MahaYugaJourney.astro";
import FourYugasJourney from "../topic/FourYugasJourney.astro";

const cosmicTimeTopic = await getEntry("atlas", "cosmic-time");
const kalpaTopic = await getEntry("atlas", "kalpa");
const manvantaraTopic = await getEntry("atlas", "manvantara");
const mahaYugaTopic = await getEntry("atlas", "maha-yuga");
const fourYugasTopic = await getEntry("atlas", "four-yugas");
const kalpaNext = { slug: "kalpa", title: "Kalpa" };
const cosmicAddressNext = { slug: "cosmic-address", title: "Cosmic Address" };
const mahaYugaNext = { slug: "maha-yuga", title: "Maha Yuga" };
const fourYugasNext = { slug: "four-yugas", title: "Four Yugas" };
const kaliYugaNext = { slug: "kali-yuga", title: "Kali Yuga" };

const layers = [
  { id: "cosmic-time", title: "Cosmic Time", meaning: "The infinite expanse", scale: "The largest frame", description: "The broad frame that holds every nested cycle shown in this atlas.", position: "Outermost frame", composition: "All nested cycles", color: "#e9b65f", y: 12, image: "/images/atlas/layers/display/cosmic-time.png" },
  { id: "kalpa", title: "Kalpa", meaning: "One day of Brahma", scale: "4.32 billion human years", description: "A Kalpa consists of 14 Manvantaras and their intervening periods.", position: "Within Cosmic Time", composition: "14 Manvantaras", color: "#e9b65f", y: 29, image: "/images/atlas/layers/display/kalpa.png" },
  { id: "manvantara", title: "Manvantara", meaning: "The reign of a Manu", scale: "71 Maha Yugas", description: "A major era associated with one Manu within a Kalpa.", position: "7th within this Kalpa", composition: "71 Maha Yugas", color: "#65d7dc", y: 44, image: "/images/atlas/layers/display/manvantara.png" },
  { id: "maha-yuga", title: "Maha Yuga", meaning: "One complete cycle of ages", scale: "4.32 million human years", description: "One complete sequence of Satya, Treta, Dvapara, and Kali Yuga.", position: "28th in this Manvantara", composition: "Four Yugas", color: "#c78cff", y: 58, image: "/images/atlas/layers/display/maha-yuga.png" },
  { id: "four-yugas", title: "Four Yugas", meaning: "Satya, Treta, Dvapara, and Kali", scale: "Four ages", description: "The four ages form one complete Maha Yuga.", position: "Within one Maha Yuga", composition: "Satya · Treta · Dvapara · Kali", color: "#8c91ff", y: 70, image: "/images/atlas/layers/display/four-yugas.png" },
  { id: "kali-yuga", title: "Kali Yuga", meaning: "The current age in the common Puranic model", scale: "The fourth Yuga", description: "Our current position within the common Puranic cycle of four Yugas.", position: "Current Yuga", composition: "Present cosmic context", color: "#ff714e", y: 80, image: "/images/atlas/layers/display/kali-yuga.png" },
] as const;
---

<section class="atlas-explorer" data-atlas-explorer>
  <header class="atlas-header glass">
    <a class="atlas-brand" href="/"><span><AtlasGlyph name="brand" size={42} /></span><div><strong>Sanatana Path</strong><small>The Eternal Atlas</small></div></a>
    <nav aria-label="Atlas product navigation"><a class="active" href="/atlas">Atlas</a><a href="/atlas/cosmic-time">Journeys</a><a href="/library">Library</a><a href="/atlas/cosmic-time">Timeline</a><a href="/methodology">About</a></nav>
    <div class="atlas-actions"><label><SacredIcon name="search" size={15} /><input type="search" placeholder="Search the Atlas..." aria-label="Search the Atlas" /><kbd>⌘K</kbd></label><a href="/methodology" aria-label="Atlas seal"><AtlasGlyph name="brand" size={24} /></a></div>
  </header>
  <div class="cosmos" id="atlas-top" aria-label="Interactive Cosmic Atlas">
    <div class="space-layer"></div>
    <div class="cosmic-ripple" aria-hidden="true"></div>
    <div class="orbital-stage" aria-hidden="true">
      <span class="core-light"></span>
      <span class="orbit-ring ring-1"><i></i></span>
      <span class="orbit-ring ring-2"><i></i></span>
      <span class="orbit-ring ring-3"><i></i></span>
      <span class="orbit-ring ring-4"><i></i></span>
      <span class="orbit-ring ring-5"><i></i></span>
      <span class="orbit-ring ring-6"><i></i></span>
      <span class="cosmic-dust dust-a"></span>
      <span class="cosmic-dust dust-b"></span>
    </div>
    <div class="atlas-camera" data-atlas-camera>
      <div class="connection-layer"></div>
      {layers.map((layer, index) => (
        <div
          class:list={["art-layer", index === 0 && "selected"]}
          style={`--layer-index:${index};--node-color:${layer.color};--orbit-width:${index < 2 ? 62 - index * 8 : 51 - index * 4}%;--orbit-height:${index < 2 ? 13 - index : 11 - index * .75}%`}
          data-art-layer={layer.id}
          aria-hidden="true"
        >
          <span class="orbit orbit-a"></span>
          <span class="orbit orbit-b"></span>
          <span class="orbit orbit-c"></span>
          <span class="orbit orbit-d"></span>
          <span class="orbit orbit-e"></span>
          <span class="orbit-sweep"></span>
          <i class="orbit-core"><AtlasGlyph name={layer.id} size={index < 2 ? 21 : 16} /></i>
          <b class="satellite satellite-a"></b>
          <b class="satellite satellite-b"></b>
          <b class="satellite satellite-c"></b>
          <b class="satellite satellite-d"></b>
        </div>
      ))}
      <div class="particles-layer"></div>
    </div>
    <div class="vignette"></div>

    <article class="intro glass">
      <p class="kicker" data-intro-kicker>Selected layer</p>
      <h1><span data-intro-title>Cosmic Time</span></h1>
      <strong class="intro-meaning" data-intro-meaning>The infinite expanse</strong>
      <p data-intro-description>The broad frame that holds every nested cycle shown in this atlas.</p>
      <div class="intro-meta" aria-label="Selected layer scale">
        <small>Scale</small>
        <strong data-intro-scale>The largest frame</strong>
      </div>
      <div class="intro-hierarchy" aria-label="Cosmic hierarchy">
        {layers.map((layer, index) => (
          <button
            class:list={{ selected: index === 0 }}
            type="button"
            data-hierarchy-layer={layer.id}
            style={`--node-color:${layer.color}`}
          >
            <i><AtlasGlyph name={layer.id} size={13} /></i>
            <span>{layer.title}</span>
          </button>
        ))}
      </div>
      <p class="intro-note" data-simple-note>The whole atlas begins here. Cosmic Time is the largest frame that contains every smaller layer.</p>
      <button class="begin" type="button" data-explore-selected><i></i><span data-intro-action>Explore Cosmic Time</span><b>↓</b></button>
    </article>

    <nav class="coordinates glass" aria-label="Current cosmic coordinates">
      <span>Current position</span>
      <ol data-coordinates>
        <li>Cosmic Time</li><li>Kalpa</li>
      </ol>
    </nav>

    <nav class="tool-dock glass" aria-label="Atlas tools">
      <a class="active" href="/atlas" aria-label="Atlas" title="Atlas"><AtlasGlyph name="cosmic-time" size={22} /><span>Atlas</span></a>
      <a href="/atlas/cosmic-time" aria-label="Journeys" title="Journeys"><AtlasGlyph name="journey" size={20} /><span>Journeys</span></a>
      <a href="/library" aria-label="Library" title="Library"><AtlasGlyph name="library" size={19} /><span>Library</span></a>
      <a href="/methodology" aria-label="Timeline" title="Timeline"><AtlasGlyph name="timeline" size={20} /><span>Timeline</span></a>
      <a href="/methodology" aria-label="Settings" title="Settings"><AtlasGlyph name="settings" size={20} /><span>Settings</span></a>
    </nav>
    <a class="om-seal glass" href="/methodology" aria-label="Sanatana Path methodology"><AtlasGlyph name="om" size={22} /></a>

    <div class="layer-nodes" aria-label="Cosmic time layers">
      {layers.map((layer, index) => (
        <button
          class:list={["layer-node", index === 0 && "selected"]}
          style={`--node-y:${layer.y}%;--node-color:${layer.color}`}
          type="button"
          data-layer={layer.id}
          data-title={layer.title}
          data-meaning={layer.meaning}
          data-scale={layer.scale}
          data-description={layer.description}
          data-position={layer.position}
          data-composition={layer.composition}
          data-step={index + 1}
          aria-pressed={index === 0 ? "true" : "false"}
          data-tooltip={`${layer.title}: ${layer.scale}`}
        >
          <span class="node-core"><AtlasGlyph name={layer.id} size={13} /></span>
          <strong>{layer.title}</strong>
          <small>{layer.meaning}</small>
        </button>
      ))}
      <div class="yuga-orbit" aria-label="The four Yugas">
        <span class="satya"><i></i><strong>Satya</strong><small>Yuga</small></span>
        <span class="treta"><i></i><strong>Treta</strong><small>Yuga</small></span>
        <span class="dvapara"><i></i><strong>Dvapara</strong><small>Yuga</small></span>
        <span class="kali"><i></i><strong>Kali Yuga</strong><small>Current age</small></span>
      </div>
      <div class="you-are-here"><span>You are here</span><strong>Kali Yuga</strong><small><span data-current-year>5128+</span> Years</small></div>
    </div>

    <aside class="context glass" aria-live="polite" style="--inspector-color:#e9b65f" hidden>
      <p>Current layer</p>
      <div class="context-title"><h2 data-context-title>Cosmic Time</h2><span><AtlasGlyph name="cosmic-time" size={19} /></span></div>
      <strong data-context-meaning>The infinite expanse</strong>
      <span class="context-description" data-context-description>The broad frame that holds every nested cycle shown in this atlas.</span>
      <div class="duration relative-scale" data-duration><p data-duration-title>Scale</p><strong data-context-scale>The largest frame</strong><span>Cosmic hierarchy</span><i></i><ol><li>All</li><li>Kalpa</li><li>Manu</li><li>Yuga</li><li>Now</li></ol></div>
      <div class="context-rule"></div>
      <div class="context-facts"><span><small>Position</small><strong data-context-position>Outermost frame</strong></span><span><small>Composition</small><strong data-context-composition>All nested cycles</strong></span><span><small>Current context</small><strong>7th Manvantara</strong></span></div>
      <p>Cosmic hierarchy</p>
      <ol>
        {layers.map((layer, index) => (
          <li class:list={{ selected: index === 0 }} data-context-layer={layer.id} style={`--node-color:${layer.color}`}><button type="button" data-hierarchy-layer={layer.id}><i><AtlasGlyph name={layer.id} size={14} /></i><span><strong>{layer.title}</strong><small>{layer.meaning}</small></span></button></li>
        ))}
      </ol>
      <div class="context-tabs" aria-label="Layer detail levels">
        <span class="active">Simple</span>
        <span>Details</span>
        <span>Sources</span>
      </div>
      <div class="simple-note">
        <span><AtlasGlyph name="cosmic-time" size={18} /></span>
        <p data-simple-note>The whole atlas begins here. Cosmic Time is the largest frame that contains every smaller layer.</p>
      </div>
      <div class="context-actions"><a data-context-link href="#atlas-reading">Open journey <span>→</span></a><a href="/sources">Sources</a></div>
    </aside>

    <div class="atlas-tooltip glass" data-atlas-tooltip></div>
  </div>

  <nav class="journey-rail glass" aria-label="Cosmic Atlas journey">
    <a class="rail-card overview-card" href="/atlas/cosmic-time" style="--node-color:#d9a64f;--rail-image:url('/images/atlas/Atlasv2.png')">
      <span class="rail-thumb" aria-hidden="true"><i><AtlasGlyph name="overview" size={20} /></i></span>
      <span class="rail-copy"><strong>Overview</strong><small>Your journey map</small></span>
    </a>
    {layers.map((layer, index) => (
      <button class:list={["rail-card", index === 0 && "selected"]} type="button" data-rail-layer={layer.id} style={`--node-color:${layer.color};--rail-image:url('${layer.image}')`}>
        <span class="rail-step" aria-hidden="true">{index + 1}</span>
        <span class="rail-thumb" aria-hidden="true"><i><AtlasGlyph name={layer.id} size={24} /></i></span>
        <span class="rail-copy"><strong>{layer.title}</strong><small>{layer.meaning}</small></span>
      </button>
    ))}
  </nav>

  <section class="discovery-grid">
    <a class="discovery-card glass structure" href="/atlas/cosmic-time"><p>How everything connects</p><h2>The Grand Structure of Time</h2><small>From the smallest human life to the vast breath of Brahma.</small><span>Explore the structure →</span></a>
    <article class="discovery-card glass comparison"><p>Readable guide</p><h2>Understand the selected layer</h2><div class="scale-symbols"><span><AtlasGlyph name="human" size={22} /><small>Human Life</small></span><span><AtlasGlyph name="kali-yuga" size={22} /><small>Kali Yuga</small></span><span><AtlasGlyph name="maha-yuga" size={22} /><small>Maha Yuga</small></span><span><AtlasGlyph name="manvantara" size={22} /><small>Manvantara</small></span><span><AtlasGlyph name="kalpa" size={22} /><small>Kalpa</small></span></div><a href="#atlas-reading">Read selected layer →</a></article>
    <a class="discovery-card glass position" href="/atlas/manvantara"><p>Current cosmic position</p><h2>We are in the <em>7th Manvantara</em></h2><span>Learn more →</span></a>
  </section>
  <section class="atlas-reading" id="atlas-reading" data-atlas-reading>
    {cosmicTimeTopic && <div data-reading-panel="cosmic-time"><CosmicTimeJourney topic={cosmicTimeTopic} next={kalpaNext} compact /></div>}
    {kalpaTopic && <div data-reading-panel="kalpa" hidden><KalpaJourney topic={kalpaTopic} next={cosmicAddressNext} compact /></div>}
    {manvantaraTopic && <div data-reading-panel="manvantara" hidden><ManvantaraJourney topic={manvantaraTopic} next={mahaYugaNext} compact /></div>}
    {mahaYugaTopic && <div data-reading-panel="maha-yuga" hidden><MahaYugaJourney topic={mahaYugaTopic} next={fourYugasNext} compact /></div>}
    {fourYugasTopic && <div data-reading-panel="four-yugas" hidden><FourYugasJourney topic={fourYugasTopic} next={kaliYugaNext} compact /></div>}
    <div class="generic-reading" data-reading-panel="generic" hidden>
      <header>
        <div>
          <p class="eyebrow">Selected layer</p>
          <h2>What is <em data-reading-title>Manvantara</em>?</h2>
          <p data-reading-description>A major era associated with one Manu within a Kalpa.</p>
        </div>
      </header>
      <div class="reading-facts">
        <article><small>Scale</small><strong data-reading-scale>71 Maha Yugas</strong></article>
        <article><small>Position</small><strong data-reading-position>Within a Kalpa</strong></article>
        <article><small>Composition</small><strong data-reading-composition>71 Maha Yugas</strong></article>
      </div>
      <section>
        <p class="eyebrow">Why this layer matters</p>
        <h3 data-reading-meaning>The reign of a Manu</h3>
        <p data-reading-body>Understanding this layer shows how the larger cosmic hierarchy is divided into ordered, connected periods.</p>
      </section>
      <a data-reading-link href="#atlas-top"><span>Keep exploring this atlas</span><strong data-reading-link-title>Return to the atlas</strong><b>↑</b></a>
    </div>
  </section>
</section>

<section class="mobile-atlas">
  <p class="eyebrow">The Eternal Atlas</p>
  <h2>Explore Cosmic Time</h2>
  <p>Start with the largest frame and move toward the age described as our present context.</p>
  <div class="mobile-position"><span>You are here</span><strong>Kali Yuga</strong><small>One layer inside a much larger cosmic structure</small></div>
  <ol>
    {layers.map((layer, index) => <li style={`--node-color:${layer.color}`}><span>{index + 1}</span><div><h2>{layer.title}</h2><p>{layer.meaning}</p></div><a href={`/atlas/${layer.id}`}>Open →</a></li>)}
  </ol>
</section>

<script>
  // @ts-nocheck
  const explorer = document.querySelector("[data-atlas-explorer]");
  if (explorer) {
    const nodes = [...explorer.querySelectorAll("[data-layer]")];
    const rails = [...explorer.querySelectorAll("[data-rail-layer]")];
    const contextLayers = [...explorer.querySelectorAll("[data-context-layer]")];
    const hierarchyButtons = [...explorer.querySelectorAll("[data-hierarchy-layer]")];
    const artLayers = [...explorer.querySelectorAll("[data-art-layer]")];
    const readingPanels = [...explorer.querySelectorAll("[data-reading-panel]")];
    const cosmos = explorer.querySelector(".cosmos");
    const camera = explorer.querySelector("[data-atlas-camera]");
    const ripple = explorer.querySelector(".cosmic-ripple");
    const contextPanel = explorer.querySelector(".context");
    const tooltip = explorer.querySelector("[data-atlas-tooltip]");
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const cameraStates = [
      { zoom: 1, y: 0 },
      { zoom: 1, y: 0 },
      { zoom: 1, y: 0 },
      { zoom: 1, y: -8 },
      { zoom: 1, y: -14 },
      { zoom: 1, y: -20 },
    ];
    let selectedIndex = 0;
    let zoom = cameraStates[0].zoom;
    let panX = 0;
    let panY = reducedMotion ? cameraStates[0].y : 0;
    let targetTiltX = 0;
    let targetTiltY = 0;
    let currentTiltX = 0;
    let currentTiltY = 0;
    let frameId = 0;
    const applyCamera = (animate = true) => {
      camera.style.transitionDuration = animate && !reducedMotion ? "520ms" : "1ms";
      camera.style.transform = `translate3d(${panX + currentTiltX}px, ${panY + currentTiltY}px, 0) scale(${zoom})`;
      explorer.style.setProperty("--camera-zoom", String(zoom));
    };
    const tickCamera = () => {
      currentTiltX += (targetTiltX - currentTiltX) * 0.07;
      currentTiltY += (targetTiltY - currentTiltY) * 0.07;
      explorer.style.setProperty("--parallax-x", `${currentTiltX.toFixed(2)}px`);
      explorer.style.setProperty("--parallax-y", `${currentTiltY.toFixed(2)}px`);
      applyCamera(false);
      if (Math.abs(targetTiltX - currentTiltX) > 0.02 || Math.abs(targetTiltY - currentTiltY) > 0.02) {
        frameId = requestAnimationFrame(tickCamera);
      } else {
        frameId = 0;
      }
    };
    const nudgeCamera = (x, y) => {
      if (reducedMotion) return;
      targetTiltX = x;
      targetTiltY = y;
      if (!frameId) frameId = requestAnimationFrame(tickCamera);
    };
    const pulseSelection = (node) => {
      if (reducedMotion || !ripple) return;
      const rect = node.getBoundingClientRect();
      const cosmosRect = cosmos.getBoundingClientRect();
      ripple.style.left = `${rect.left - cosmosRect.left + rect.width / 2}px`;
      ripple.style.top = `${rect.top - cosmosRect.top + rect.height / 2}px`;
      ripple.style.setProperty("--ripple-color", getComputedStyle(node).getPropertyValue("--node-color"));
      ripple.classList.remove("is-active");
      void ripple.offsetWidth;
      ripple.classList.add("is-active");
    };
    const updateVisibility = () => {
      artLayers.forEach((layer, index) => {
        const distance = Math.abs(index - selectedIndex);
        layer.classList.toggle("selected", index === selectedIndex);
        layer.style.opacity = String(distance === 0 ? 1 : distance === 1 ? 0.46 : 0.14);
      });
    };
    const getHashLayer = () => decodeURIComponent(window.location.hash.replace("#", "")).trim();
    const isAtlasLayer = (id) => nodes.some((item) => item.dataset.layer === id);
    const syncLayerHash = (id) => {
      if (!id || window.location.hash === `#${id}`) return;
      history.replaceState(null, "", `${window.location.pathname}${window.location.search}#${id}`);
    };
    const selectLayer = (id, options = {}) => {
      const node = nodes.find((item) => item.dataset.layer === id);
      if (!node) return;
      const index = nodes.indexOf(node);
      if (index === selectedIndex && options.openIfSelected) {
        explorer.querySelector("[data-atlas-reading]")?.scrollIntoView({ behavior: reducedMotion ? "auto" : "smooth", block: "start" });
        return;
      }
      selectedIndex = index;
      nodes.forEach((item) => { item.classList.toggle("selected", item === node); item.setAttribute("aria-pressed", String(item === node)); });
      rails.forEach((item) => item.classList.toggle("selected", item.dataset.railLayer === id));
      hierarchyButtons.forEach((item) => item.classList.toggle("selected", item.dataset.hierarchyLayer === id));
      contextLayers.forEach((item) => item.classList.toggle("selected", item.dataset.contextLayer === id));
      explorer.querySelector("[data-context-title]").textContent = node.dataset.title;
      explorer.querySelector("[data-context-meaning]").textContent = node.dataset.meaning;
      explorer.querySelector("[data-intro-title]").textContent = node.dataset.title;
      explorer.querySelector("[data-intro-meaning]").textContent = node.dataset.meaning;
      explorer.querySelector("[data-intro-description]").textContent = node.dataset.description;
      explorer.querySelector("[data-intro-scale]").textContent = node.dataset.scale;
      explorer.querySelector("[data-intro-action]").textContent = `Explore ${node.dataset.title}`;
      const scaleTarget = explorer.querySelector("[data-context-scale]");
      scaleTarget.innerHTML = id === "kalpa" ? '4.32 <small>Billion</small>' : node.dataset.scale;
      explorer.querySelector("[data-context-description]").textContent = node.dataset.description;
      explorer.querySelector("[data-context-position]").textContent = node.dataset.position;
      explorer.querySelector("[data-context-composition]").textContent = node.dataset.composition;
      explorer.querySelector("[data-duration-title]").textContent = id === "kalpa" ? "Duration" : "Scale";
      explorer.querySelector("[data-duration]").classList.toggle("relative-scale", id !== "kalpa");
      const selectedColor = getComputedStyle(node).getPropertyValue("--node-color");
      explorer.querySelector("[data-duration]").style.setProperty("--inspector-color", selectedColor);
      contextPanel.style.setProperty("--inspector-color", selectedColor);
      explorer.querySelector("[data-context-link]").setAttribute("href", "#atlas-reading");
      const simpleNotes = {
        "cosmic-time": "The whole atlas begins here. Cosmic Time is the largest frame that contains every smaller layer.",
        kalpa: "A Kalpa is one day of Brahma and the first major structure inside Cosmic Time.",
        manvantara: "A Manvantara is one major age inside a Kalpa. We are traditionally placed in the 7th Manvantara.",
        "maha-yuga": "A Maha Yuga is one full cycle of the four Yugas, repeated many times inside a Manvantara.",
        "four-yugas": "The Four Yugas are Satya, Treta, Dvapara, and Kali. Together they form one Maha Yuga.",
        "kali-yuga": "Kali Yuga is the present age in the common Puranic model, but it is only one layer in the larger structure.",
      };
      explorer.querySelector("[data-simple-note]").textContent = simpleNotes[id] || node.dataset.description;
      const readingPanel = ["cosmic-time", "kalpa", "manvantara", "maha-yuga", "four-yugas"].includes(id) ? id : "generic";
      readingPanels.forEach((panel) => { panel.hidden = panel.dataset.readingPanel !== readingPanel; });
      if (readingPanel === "generic") {
        explorer.querySelector("[data-reading-title]").textContent = node.dataset.title;
        explorer.querySelector("[data-reading-description]").textContent = node.dataset.description;
        explorer.querySelector("[data-reading-scale]").textContent = node.dataset.scale;
        explorer.querySelector("[data-reading-position]").textContent = node.dataset.position;
        explorer.querySelector("[data-reading-composition]").textContent = node.dataset.composition;
        explorer.querySelector("[data-reading-meaning]").textContent = node.dataset.meaning;
        explorer.querySelector(".generic-reading").style.setProperty("--reading-color", getComputedStyle(node).getPropertyValue("--node-color"));
      }
      explorer.querySelector("[data-coordinates]").innerHTML = `<li>Cosmic Time</li><li>Kalpa</li><li>7th Manvantara</li><li>28th Maha Yuga</li><li>Kali Yuga</li>`;
      const state = cameraStates[index];
      zoom = state.zoom;
      panX = 0;
      panY = state.y;
      updateVisibility();
      pulseSelection(node);
      contextPanel.scrollTo({ top: 0, behavior: reducedMotion ? "auto" : "smooth" });
      applyCamera(options.animate !== false);
      if (options.syncHash !== false) syncLayerHash(id);
    };
    const showTooltip = (node) => {
      tooltip.textContent = node.dataset.tooltip;
      tooltip.hidden = false;
      const rect = node.getBoundingClientRect();
      const cosmosRect = cosmos.getBoundingClientRect();
      tooltip.style.left = `${rect.left - cosmosRect.left + rect.width / 2}px`;
      tooltip.style.top = `${rect.top - cosmosRect.top - 8}px`;
    };
    nodes.forEach((node) => {
      node.addEventListener("click", () => selectLayer(node.dataset.layer, { openIfSelected: true }));
      node.addEventListener("mouseenter", () => showTooltip(node));
      node.addEventListener("mouseleave", () => { tooltip.hidden = true; });
    });
    rails.forEach((node) => node.addEventListener("click", () => selectLayer(node.dataset.railLayer)));
    hierarchyButtons.forEach((node) => node.addEventListener("click", () => selectLayer(node.dataset.hierarchyLayer)));
    if (!reducedMotion) {
      cosmos.addEventListener("pointermove", (event) => {
        const rect = cosmos.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - 0.5;
        const y = (event.clientY - rect.top) / rect.height - 0.5;
        nudgeCamera(x * -16, y * -10);
      });
      cosmos.addEventListener("pointerleave", () => nudgeCamera(0, 0));
    }
    explorer.querySelector("[data-context-link]")?.addEventListener("click", (event) => {
      event.preventDefault();
      explorer.querySelector("[data-atlas-reading]")?.scrollIntoView({ behavior: reducedMotion ? "auto" : "smooth", block: "start" });
    });
    explorer.querySelector("[data-reading-panel='cosmic-time'] .continue")?.addEventListener("click", (event) => {
      event.preventDefault();
      selectLayer("kalpa");
      explorer.querySelector("[data-atlas-reading]")?.scrollIntoView({ behavior: reducedMotion ? "auto" : "smooth", block: "start" });
    });
    explorer.querySelector("[data-reading-panel='kalpa'] .continue")?.addEventListener("click", (event) => {
      event.preventDefault();
      selectLayer("manvantara");
      explorer.querySelector("[data-atlas-reading]")?.scrollIntoView({ behavior: reducedMotion ? "auto" : "smooth", block: "start" });
    });
    explorer.querySelector("[data-reading-panel='manvantara'] .continue")?.addEventListener("click", (event) => {
      event.preventDefault();
      selectLayer("maha-yuga");
      explorer.querySelector("[data-atlas-reading]")?.scrollIntoView({ behavior: reducedMotion ? "auto" : "smooth", block: "start" });
    });
    explorer.querySelector("[data-reading-panel='maha-yuga'] .continue")?.addEventListener("click", (event) => {
      event.preventDefault();
      selectLayer("four-yugas");
      explorer.querySelector("[data-atlas-reading]")?.scrollIntoView({ behavior: reducedMotion ? "auto" : "smooth", block: "start" });
    });
    explorer.querySelector("[data-reading-panel='four-yugas'] .continue")?.addEventListener("click", (event) => {
      event.preventDefault();
      selectLayer("kali-yuga");
      explorer.querySelector("[data-atlas-reading]")?.scrollIntoView({ behavior: reducedMotion ? "auto" : "smooth", block: "start" });
    });
    explorer.querySelector("[data-reading-link]")?.addEventListener("click", (event) => {
      event.preventDefault();
      explorer.querySelector(".cosmos")?.scrollIntoView({ behavior: reducedMotion ? "auto" : "smooth", block: "start" });
    });
    explorer.querySelector("[data-explore-selected]")?.addEventListener("click", () => {
      explorer.querySelector("[data-atlas-reading]")?.scrollIntoView({ behavior: reducedMotion ? "auto" : "smooth", block: "start" });
    });
    document.addEventListener("keydown", (event) => {
      if (event.target.matches("input, textarea")) return;
      if (event.key === "ArrowDown" || event.key === "ArrowRight") selectLayer(nodes[Math.min(nodes.length - 1, selectedIndex + 1)].dataset.layer);
      if (event.key === "ArrowUp" || event.key === "ArrowLeft") selectLayer(nodes[Math.max(0, selectedIndex - 1)].dataset.layer);
    });
    const applyHashSelection = () => {
      const hashLayer = getHashLayer();
      if (isAtlasLayer(hashLayer)) selectLayer(hashLayer, { animate: false, syncHash: false });
    };
    window.addEventListener("hashchange", applyHashSelection);
    explorer.querySelector("[data-current-year]").textContent = `${new Date().getFullYear() + 3102}+`;
    updateVisibility();
    applyCamera(false);
    applyHashSelection();
  }
</script>


  /* Cinematic Atlas v2 visual system */
  .atlas-explorer {
    --glass: rgb(3 12 19 / .68);
    gap: 1rem;
    padding: 1rem;
    background:
      radial-gradient(circle at 50% 0%, rgb(233 182 95 / .1), transparent 28rem),
      linear-gradient(180deg, #020a10, #01070c 62%, #020a10);
  }

  .cosmos {
    min-height: clamp(38rem, calc(100svh - 138px), 52rem);
    overflow: hidden;
    border: 1px solid rgb(223 174 93 / .18);
    border-radius: 1.35rem;
    background: #02070c;
    box-shadow: inset 0 1px rgb(255 255 255 / .035), 0 34px 110px rgb(0 0 0 / .34);
    isolation: isolate;
  }

  .cosmos::before {
    z-index: 0;
    inset: 0;
    left: 0;
    width: auto;
    height: auto;
    transform: none;
    border-radius: inherit;
    background:
      linear-gradient(90deg, rgb(2 8 13 / .9), rgb(2 8 13 / .34) 26%, rgb(2 8 13 / .22) 58%, rgb(2 8 13 / .82)),
      linear-gradient(180deg, rgb(2 8 13 / .1), rgb(2 8 13 / .42) 70%, rgb(2 8 13 / .88)),
      url("/images/atlas/Atlasv2.png");
    background-position: center;
    background-size: cover;
    opacity: .9;
    animation: atlasv2-drift 26s ease-in-out infinite alternate;
    content: "";
  }

  .cosmos::after {
    z-index: 1;
    inset: 0;
    left: 0;
    width: auto;
    height: auto;
    transform: none;
    border-radius: inherit;
    background:
      radial-gradient(circle at 58% 39%, rgb(255 214 132 / .18), transparent 15rem),
      linear-gradient(112deg, transparent 0 38%, rgb(255 223 164 / .12) 47%, transparent 57%),
      repeating-linear-gradient(90deg, transparent 0 9.5rem, rgb(101 215 220 / .035) 9.55rem 9.6rem, transparent 9.65rem 19rem);
    mix-blend-mode: screen;
    opacity: .58;
    animation: atlasv2-sweep 12s ease-in-out infinite;
    content: "";
  }

  .space-layer {
    z-index: 1;
    background:
      radial-gradient(circle at 50% 44%, rgb(233 182 95 / .12), transparent 24rem),
      radial-gradient(circle at 68% 60%, rgb(101 215 220 / .07), transparent 22rem),
      radial-gradient(circle at 22% 38%, rgb(199 140 255 / .045), transparent 21rem);
    opacity: .92;
  }

  .space-layer::before {
    background-image:
      radial-gradient(circle, rgb(255 236 196 / .78) 0 1px, transparent 1.5px),
      radial-gradient(circle, rgb(118 211 220 / .52) 0 1px, transparent 1.35px);
    background-position: 0 0, 41px 53px;
    background-size: 157px 149px, 233px 211px;
    opacity: .12;
    animation: star-drift 95s linear infinite;
  }

  .space-layer::after {
    background:
      radial-gradient(ellipse at 50% 48%, transparent 0 31%, rgb(233 182 95 / .045) 31.15% 31.45%, transparent 31.7%),
      radial-gradient(ellipse at 50% 48%, transparent 0 45%, rgb(101 215 220 / .03) 45.1% 45.35%, transparent 45.7%),
      linear-gradient(180deg, transparent, rgb(2 8 13 / .34));
    opacity: .6;
    animation: field-breathe 14s ease-in-out infinite;
  }

  .atlas-camera {
    z-index: 2;
    mix-blend-mode: screen;
    opacity: .74;
    filter: drop-shadow(0 0 22px rgb(233 182 95 / .1));
  }


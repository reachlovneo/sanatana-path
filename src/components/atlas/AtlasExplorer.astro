      linear-gradient(90deg, rgb(2 8 13 / .94), transparent 19%, transparent 72%, rgb(2 8 13 / .9)),
      linear-gradient(0deg, rgb(2 8 13 / .88), transparent 22%, rgb(2 8 13 / .18)),
      radial-gradient(circle at 50% 44%, transparent 0 28%, rgb(2 8 13 / .34) 72%);
    pointer-events: none;
  }

  .glass {
    border: 1px solid rgb(223 174 93 / .22);
    background:
      linear-gradient(145deg, rgb(3 12 19 / .76), rgb(3 12 19 / .48)),
      radial-gradient(circle at 90% 8%, rgb(233 182 95 / .08), transparent 42%);
    box-shadow: inset 0 1px rgb(255 255 255 / .035), 0 18px 60px rgb(0 0 0 / .28);

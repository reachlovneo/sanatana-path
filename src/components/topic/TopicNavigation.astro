---
import SacredIcon from "../ui/SacredIcon.astro";

interface TopicLink {
  slug: string;
  title: string;
  description?: string;
}

interface Props {
  previous?: TopicLink;
  next?: TopicLink;
}

const { previous, next } = Astro.props;
---

<nav class:list={["topic-navigation", !previous && "next-only"]} aria-label="Continue the Cosmic Atlas journey">
  {
    previous ? (
      <a class="previous" href={`/atlas/${previous.slug}`}>
        <span>Previous topic</span>
        <strong>&lt;- {previous.title}</strong>
        {previous.description && <small>{previous.description}</small>}
      </a>
    ) : (
      <span />
    )
  }
  {
    next ? (
      <a class="next" href={`/atlas/${next.slug}`}>
        <span>Next topic</span>
        <strong>{next.title} -&gt;</strong>
        {next.description && <small>{next.description}</small>}
        {!previous && <em>Open {next.title} -&gt;</em>}
        {!previous && <span class="next-art" aria-hidden="true"><SacredIcon name="mandala" size={68} /></span>}
      </a>
    ) : (
      <a class="next" href="/atlas">
        <span>Journey complete</span>
        <strong>Return to Atlas -&gt;</strong>
      </a>
    )
  }
</nav>

<style>
  .topic-navigation {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
    margin-top: 2.5rem;
  }

  .next-only {
    grid-template-columns: 1fr;
  }

  .next-only > span {
    display: none;
  }

  .next-only a.next {
    position: relative;
    min-height: 110px;
    border-color: color-mix(in srgb, var(--gold) 65%, var(--border));
    background: linear-gradient(135deg, var(--surface), color-mix(in srgb, var(--gold) 10%, var(--surface)));
    text-align: left;
  }

  .next-art {
    position: absolute;
    right: 9%;
    bottom: 1.1rem;
    color: color-mix(in srgb, var(--gold) 72%, transparent);
    opacity: 0.7;
  }

  .next-only a.next strong {
    font-size: 1.5rem;
  }

  .next-only a.next em {
    margin-top: 0.75rem;
    color: var(--copper);
    font-size: 0.76rem;
    font-style: normal;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  a {
    display: grid;
    min-height: 84px;
    align-content: center;
    border: 1px solid var(--border);
    border-radius: 1.2rem;
    padding: 1rem;
    background: var(--surface);
    transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  a:hover {
    border-color: var(--gold);
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  a.next {
    text-align: right;
  }

  span {
    color: var(--ink-muted);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  strong {
    margin-top: 0.3rem;
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 600;
  }

  small {
    margin-top: 0.2rem;
    color: var(--ink-muted);
    font-size: 0.76rem;
  }

  @media (max-width: 600px) {
    .topic-navigation {
      grid-template-columns: 1fr;
    }

    .topic-navigation > span {
      display: none;
    }
  }
</style>

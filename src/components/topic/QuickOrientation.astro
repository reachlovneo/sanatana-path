---
interface Props {
  quickAnswer: string;
  whyItMatters: string;
}

const { quickAnswer, whyItMatters } = Astro.props;
---

<section class="quick-orientation" aria-labelledby="quick-answer-heading">
  <div class="answer">
    <p class="eyebrow">Simple answer</p>
    <h2 id="quick-answer-heading">{quickAnswer}</h2>
    <p class="structure">Four Yugas <span>→</span> Maha Yuga <span>→</span> Manvantara <span>→</span> Kalpa</p>
  </div>
  <div class="reason">
    <p class="eyebrow">Why start here?</p>
    <p>{whyItMatters}</p>
  </div>
</section>

<style>
  .quick-orientation {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 1.5rem;
    margin-bottom: 0.8rem;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding-block: 1rem;
  }

  .answer,
  .reason {
    padding: 0;
  }

  .eyebrow {
    margin: 0 0 0.45rem;
    color: var(--copper);
  }

  h2 {
    max-width: 30ch;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: 550;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .structure {
    margin: 0.7rem 0 0;
    color: var(--ink-muted);
    font-size: 0.86rem;
    font-weight: 750;
  }

  .structure span {
    margin-inline: 0.2rem;
    color: var(--copper);
  }

  .reason p:last-child {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.94rem;
  }

  @media (max-width: 720px) {
    .quick-orientation {
      display: block;
      border-radius: 0;
    }

    .answer,
    .reason {
      border: 0;
      border-radius: 0;
      background: transparent;
    }

    .reason {
      border-top: 1px solid var(--border);
      margin-top: 0.9rem;
      padding-top: 0.9rem;
    }
  }
</style>

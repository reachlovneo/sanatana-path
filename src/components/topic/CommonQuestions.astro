---
interface Question {
  question: string;
  answer: string;
}

interface Props {
  questions: Question[];
}

const { questions } = Astro.props;
---

<section class="common-questions" aria-labelledby="common-questions-heading">
  <p class="eyebrow">Common confusion</p>
  <h2 id="common-questions-heading">Questions people ask first</h2>
  <div>
    {
      questions.map((item, index) => (
        <details open={index === 0}>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .common-questions {
    margin: 3rem 0;
  }

  h2 {
    margin: 0.1rem 0 1rem;
    font-family: var(--serif);
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  div {
    display: grid;
    gap: 0.6rem;
  }

  details {
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 0.85rem 1rem;
    background: var(--surface);
  }

  details[open] {
    border-color: color-mix(in srgb, var(--gold) 60%, var(--border));
  }

  summary {
    color: var(--ink);
    font-weight: 800;
    cursor: pointer;
  }

  p {
    margin: 0.7rem 0 0;
    color: var(--ink-muted);
    font-size: 0.94rem;
  }
</style>

---
interface Question {
  question: string;
  answer: string;
}

interface Props {
  questions: Question[];
  compact?: boolean;
}

const { questions, compact = false } = Astro.props;
---

<section class:list={["common-questions", compact && "compact"]} aria-labelledby="common-questions-heading">
  <p class="eyebrow">{compact ? "Questions people ask first" : "Common confusion"}</p>
  <h2 id="common-questions-heading">{compact ? "Common questions" : "Questions people ask first"}</h2>
  <div>
    {
      questions.map((item, index) => (
        <details open={index === 0}>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .common-questions {
    margin: 2.25rem 0;
  }

  h2 {
    margin: 0.1rem 0 0.75rem;
    font-family: var(--serif);
    font-size: clamp(1.45rem, 2.5vw, 1.85rem);
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  div {
    display: grid;
    gap: 0.6rem;
  }

  details {
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 0.7rem 0.85rem;
    background: var(--surface);
  }

  details[open] {
    border-color: color-mix(in srgb, var(--gold) 60%, var(--border));
  }

  summary {
    color: var(--ink);
    font-size: 0.92rem;
    font-weight: 800;
    cursor: pointer;
  }

  p {
    margin: 0.7rem 0 0;
    color: var(--ink-muted);
    font-size: 0.94rem;
  }

  @media (max-width: 600px) {
    .common-questions {
      margin: 2.25rem 0;
    }

    h2 {
      font-size: 1.6rem;
    }

    details {
      padding: 0.75rem 0.85rem;
    }
  }

  .compact { margin: 0; border: 1px solid var(--border); border-radius: 0.55rem; padding: 0.7rem 0.8rem 0.8rem; background: color-mix(in srgb, var(--surface) 55%, transparent); }
  .compact h2 { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .compact .eyebrow { margin: 0 0 0.45rem; color: var(--copper); }
  .compact div { gap: 0; overflow: hidden; border: 1px solid var(--border); border-radius: 0.45rem; }
  .compact details { border: 0; border-radius: 0; padding: 0.42rem 0.6rem; background: transparent; }
  .compact details + details { border-top: 1px solid var(--border); }
  .compact details[open] { background: color-mix(in srgb, var(--surface-muted) 55%, transparent); }
  .compact summary { font-family: var(--serif); font-size: 0.82rem; }
  .compact summary { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.55rem; list-style: none; }
  .compact summary::-webkit-details-marker { display: none; }
  .compact summary::before { display: grid; width: 1rem; height: 1rem; place-items: center; border: 1px solid var(--ink-muted); border-radius: 50%; color: var(--ink-muted); font-family: var(--sans); font-size: 0.7rem; content: "+"; }
  .compact summary::after { color: var(--ink-muted); font-family: var(--sans); content: "⌄"; }
  .compact details[open] summary::before { content: "−"; }
  .compact details[open] summary::after { content: "⌃"; }
  .compact details p { margin-top: 0.25rem; font-size: 0.7rem; line-height: 1.35; }
</style>

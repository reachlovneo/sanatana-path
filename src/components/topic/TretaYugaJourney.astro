---
import AtlasGlyph from "../ui/AtlasGlyph.astro";
import SacredIcon from "../ui/SacredIcon.astro";
import SourcePanel from "./SourcePanel.astro";

const { topic } = Astro.props;

const facts = [
  ["Duration", "1.296 million human years", "clock"],
  ["Position", "Second Yuga", "cycle"],
  ["Dharma", "Three legs remain", "mandala"],
  ["Defining epic", "Ramayana", "map"],
] as const;

const dharmaCards = [
  ["Truth becomes duty", "In Satya Yuga, truth is natural. In Treta Yuga, truth must be chosen and protected through action.", "star"],
  ["Power needs restraint", "Kings, kingdoms, vows, and responsibility become central. Leadership is tested by Dharma.", "compass"],
  ["Sacrifice becomes visible", "Treta Yuga shows that right action often requires loss, patience, and surrender of personal comfort.", "flame"],
] as const;

const symbols = [
  ["Rama", "Dharma in action", "The ideal ruler who chooses duty even when it costs him personally.", "sun"],
  ["Sita", "Purity and strength", "The quiet force of endurance, dignity, and sacred feminine power.", "lotus"],
  ["Hanuman", "Devotion and courage", "Faith made active through service, intelligence, and fearlessness.", "flame"],
  ["Rama Setu", "Impossible made possible", "A bridge built through teamwork, devotion, and trust in a higher purpose.", "map"],
] as const;

const figures = [
  ["Rama", "The prince of Ayodhya and avatar of Vishnu, remembered as Maryada Purushottama, the ideal person who lives within Dharma."],
  ["Sita", "The daughter of Janaka, wife of Rama, and one of the deepest symbols of purity, courage, endurance, and sacred dignity."],
  ["Lakshmana", "The devoted brother who follows Rama into exile and represents loyalty, service, and disciplined protection."],
  ["Hanuman", "The great servant of Rama, whose strength is guided by humility, devotion, and unwavering faith."],
  ["Ravana", "The learned king of Lanka whose brilliance is overcome by pride, desire, and misuse of power."],
  ["Dasharatha", "The king whose promise changes the destiny of Ayodhya and reveals the cost of vows and royal duty."],
];

const ramayanaTimeline = [
  "Birth of Rama",
  "Life in Ayodhya",
  "Fourteen years of exile",
  "Sita abducted by Ravana",
  "Hanuman finds Sita",
  "Bridge to Lanka",
  "The great war",
  "Ravana defeated",
  "Return to Ayodhya",
  "Rama Rajya",
];

const innerRamayana = [
  ["Rama", "The higher self that stays aligned with Dharma."],
  ["Sita", "The soul, purity, and inner dignity."],
  ["Lakshmana", "Discipline and loyal protection."],
  ["Hanuman", "Devotion that becomes strength."],
  ["Ravana", "Ego, pride, desire, and knowledge without humility."],
  ["Lanka", "The glittering world of power when it is separated from Dharma."],
];


const hiddenWonders = [
  {
    name: "Vedavati",
    title: "The curse before Sita",
    icon: "flame",
    summary: "Many traditions tell a story that begins long before the Ramayana. A devoted ascetic named Vedavati dedicated her life to Vishnu. When Ravana attempted to violate her sanctity, she cursed him and vowed to become the cause of his destruction. Later traditions identify Vedavati with Sita.",
    lesson: "Ravana's downfall did not begin in Lanka. It began with his own actions years earlier. Consequences are often set in motion long before they become visible.",
  },
  {
    name: "Trishanku",
    title: "The king between heaven and earth",
    icon: "compass",
    summary: "King Trishanku wished to enter heaven with his physical body. The gods rejected the request. Sage Vishvamitra used immense spiritual power to send him upward, and Trishanku became suspended between heaven and earth: neither fully above nor fully below.",
    lesson: "The phrase Trishanku Swarga is still remembered for someone trapped between two states. Not every desire should be pursued simply because power exists.",
  },
  {
    name: "Vishvamitra",
    title: "The king who became a sage",
    icon: "star",
    summary: "Vishvamitra was not born a sage. He was born a king. After encountering Sage Vashistha, he became determined to attain spiritual greatness through discipline, austerity, and self-mastery.",
    lesson: "Most heroes begin great. Vishvamitra became great. His story teaches that transformation is possible.",
  },
  {
    name: "Harishchandra",
    title: "The king who never lied",
    icon: "mandala",
    summary: "Harishchandra is remembered as one of the greatest examples of truthfulness. Through divine tests he lost his kingdom, wealth, family, and status, yet he refused to abandon truth.",
    lesson: "Integrity has value only when it becomes difficult.",
  },
  {
    name: "Bhagiratha",
    title: "The prince who brought Ganga to earth",
    icon: "map",
    summary: "King Bhagiratha wished to liberate his ancestors and performed severe penance so the celestial river Ganga could descend from heaven to earth. Shiva received the force of Ganga in his matted locks and gently released her.",
    lesson: "Great blessings often arrive only after extraordinary perseverance.",
  },
  {
    name: "Ahalya",
    title: "A story of redemption",
    icon: "lotus",
    summary: "Many people know that Rama freed Ahalya from a curse. Fewer know that her son Shatananda later became the chief priest of King Janaka and personally welcomed Rama to Mithila.",
    lesson: "Healing does not always happen instantly. Sometimes the effects of Dharma unfold across generations.",
  },
  {
    name: "Rama and Parashurama",
    title: "The meeting of two avatars",
    icon: "cycle",

const hiddenPattern = [
  ["Rama", "Duty"],
  ["Sita", "Dignity"],
  ["Hanuman", "Potential"],
  ["Ravana", "Ego"],
  ["Vedavati", "Consequences"],
  ["Trishanku", "Desire"],
  ["Vishvamitra", "Transformation"],
  ["Harishchandra", "Truth"],
  ["Bhagiratha", "Perseverance"],
  ["Parashurama", "Justice"],
  ["Ahalya", "Redemption"],
] as const;

const lessons = [
  "Truth becomes meaningful when it is lived under pressure.",
  "Power without humility can destroy even a brilliant person.",
  "Duty is not always comfortable, but it gives life direction.",
  "Devotion is not weakness. It can become courage, intelligence, and action.",
  "The Ramayana remains powerful because every character reflects a human possibility.",

---
interface Props {
  title: string;
  label?: string;
}

const { title, label = "Reflection, not a scriptural claim" } = Astro.props;
---

<aside class="reflection-panel">
  <p class="eyebrow">{label}</p>
  <h2>{title}</h2>
  <div><slot /></div>
</aside>

<style>
  .reflection-panel {
    position: relative;
    overflow: hidden;
    margin: 3rem 0;
    border: 1px solid color-mix(in srgb, var(--gold) 65%, var(--border));
    border-radius: 1.5rem;
    padding: clamp(1.25rem, 4vw, 2rem);
    background: linear-gradient(135deg, var(--surface), color-mix(in srgb, var(--gold) 12%, var(--surface)));
  }

  .reflection-panel::after {
    position: absolute;
    right: -4rem;
    bottom: -4rem;
    width: 11rem;
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--gold) 35%, transparent);
    border-radius: 50%;
    box-shadow:
      0 0 0 1.5rem color-mix(in srgb, var(--gold) 5%, transparent),
      0 0 0 3rem color-mix(in srgb, var(--gold) 4%, transparent);
    content: "";
    pointer-events: none;
  }

  .eyebrow {
    color: var(--copper);
  }

  h2 {
    max-width: 18ch;
    margin: 0.2rem 0 0.8rem;
    font-family: var(--serif);
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.08;
  }

  div {
    position: relative;
    z-index: 1;
    max-width: 62ch;
    color: var(--ink-muted);
  }

  div :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
